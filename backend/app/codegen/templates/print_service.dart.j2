import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:zsdk/zsdk.dart';

/// A Bluetooth printer (bonded or discovered via zsdk).
class DiscoveredPrinter {
  final String name;
  final String address; // Bluetooth MAC address (e.g. C4:D3:6A:AC:F0:AE)

  const DiscoveredPrinter({
    required this.name,
    required this.address,
  });
}

class PrintService {
  static final PrintService instance = PrintService._();
  PrintService._();

  final _zsdk = ZSDK();

  static const _kDpiKey = 'printer_dpi';

  /// Supported label print resolutions.
  static const List<int> supportedDpi = [203, 300];
  static const int defaultDpi = 300;

  /// Persist the label print resolution (203 or 300 dpi) so the user can
  /// switch printers of a different DPI class without mis-scaled labels.
  Future<void> setPrinterDpi(int dpi) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setInt(_kDpiKey, dpi);
  }

  /// Returns the saved DPI setting, defaulting to [defaultDpi] (300) —
  /// the resolution the label layout was originally designed for.
  Future<int> getPrinterDpi() async {
    final prefs = await SharedPreferences.getInstance();
    return prefs.getInt(_kDpiKey) ?? defaultDpi;
  }

  // ── Bluetooth discovery ───────────────────────────────────────────────────

  /// Return already-paired (bonded) Bluetooth devices.
  Future<List<DiscoveredPrinter>> getBondedPrinters() async {
    try {
      final devices = await _zsdk.getBondedDevices();
      return devices
          .map((d) => DiscoveredPrinter(
                name: (d['name'] as String?)?.isNotEmpty == true
                    ? d['name']!
                    : (d['address'] ?? 'Unknown'),
                address: d['address'] ?? '',
              ))
          .where((p) => p.address.isNotEmpty)
          .toList();
    } catch (e) {
      debugPrint('[PrintService] getBondedDevices error: $e');
      return [];
    }
  }

  /// Actively scan for nearby Zebra Bluetooth printers (Android only).
  Future<List<DiscoveredPrinter>> discoverBluetoothPrinters() async {
    try {
      final devices = await _zsdk.discoverBluetoothPrinters();
      return devices
          .map((d) => DiscoveredPrinter(
                name: (d['name'] as String?)?.isNotEmpty == true
                    ? d['name']!
                    : 'Zebra Printer',
                address: d['address'] ?? '',
              ))
          .where((p) => p.address.isNotEmpty)
          .toList();
    } catch (e) {
      debugPrint('[PrintService] discoverBluetoothPrinters error: $e');
      return [];
    }
  }

  // ── ZPL label generation ──────────────────────────────────────────────────

  /// Returns true if [value] is a real detected part (not null/empty/"None").
  bool _hasValue(String? value) {
    if (value == null) return false;
    final v = value.trim().toLowerCase();
    return v.isNotEmpty && v != 'none' && v != 'null' && v != 'n/a';
  }

  /// Build a ZPL II label for the inspection report.
  /// Authored for a Zebra ZT411 at 300 dpi, 4-inch wide labels; all
  /// coordinates are scaled at print time for [dpi] (e.g. 203 dpi) so the
  /// label keeps the same physical 4-inch size on either printer class.
  String _buildZpl({
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
    int dpi = PrintService.defaultDpi,
  }) {
    final double scale = dpi / PrintService.defaultDpi;
    int s(num v) => (v * scale).round();

    // Clean up ISO timestamp → "2026-03-26 15:46:09"
    final cleanDate = timestamp
        .replaceFirst('T', ' ')
        .replaceAll(RegExp(r'\.\d+$'), '');

    // Only show failed tasks on the label
    final failedTasks = overallSuccess
        ? <Map<String, dynamic>>[]
        : tasks.where((t) => t['success'] != true).toList();

    // Body is built first so the exact content height (and therefore ^LL)
    // is known before we emit the header — avoids magic-number height math
    // drifting out of sync with the layout below.
    final body = StringBuffer();
    int y = s(20);

    // ── Title ─────────────────────────────────────────────────────────────────
    body.writeln('^FO${s(50)},$y^A0N,${s(62)},${s(44)}^FDINSPECTION REPORT^FS');
    y += s(75);
    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(18);

    // ── VIN (large) and DATE ────────────────────────────────────────────────
    body.writeln('^FO${s(50)},$y^A0N,${s(72)},${s(50)}^FDVIN  : $vin^FS');
    y += s(86);
    body.writeln('^FO${s(50)},$y^A0N,${s(38)},${s(27)}^FDDATE : $cleanDate^FS');
    y += s(54);
    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(18);

    // ── Status ────────────────────────────────────────────────────────────────
    final statusText = overallSuccess ? '[ PASSED ]' : '[ FAILED ]';
    body.writeln('^FO${s(50)},$y^A0N,${s(60)},${s(44)}^FD$statusText^FS');
    y += s(75);
    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(18);

    // ── Failed tasks only ─────────────────────────────────────────────────────
    if (failedTasks.isNotEmpty) {
      body.writeln('^FO${s(50)},$y^A0N,${s(32)},${s(23)}^FDFAILED TASKS^FS');
      y += s(44);
      body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(2)},${s(2)}^FS');
      y += s(12);

      for (final task in failedTasks) {
        final name = task['taskName'] as String? ?? 'Task';
        body.writeln('^FO${s(50)},$y^A0N,${s(38)},${s(27)}^FD$name^FS');
        y += s(50);

        final part = task['detectedPart'] as String?;
        if (_hasValue(part)) {
          body.writeln('^FO${s(70)},$y^A0N,${s(30)},${s(22)}^FD> ${part!.trim()}^FS');
          y += s(40);
        }

        body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(2)},${s(2)}^FS');
        y += s(8);
      }
      y += s(6);
    }

    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(14);

    // ── Footer ────────────────────────────────────────────────────────────────
    body.writeln('^FO${s(50)},$y^A0N,${s(30)},${s(22)}^FDFlutter AI Inspection System^FS');
    y += s(40);

    final header = StringBuffer();
    header.writeln('^XA');
    header.writeln('^PW${s(1200)}');
    header.writeln('^LL$y');

    return header.toString() + body.toString() + '^XZ\n';
  }

  // ── Print ─────────────────────────────────────────────────────────────────

  /// Send ZPL inspection report to [printer] over Bluetooth.
  Future<bool> printInspectionReport({
    required DiscoveredPrinter printer,
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) async {
    try {
      final zpl = _buildZpl(
        vin: vin,
        modelCode: modelCode,
        timestamp: timestamp,
        overallSuccess: overallSuccess,
        tasks: tasks,
        dpi: await getPrinterDpi(),
      );

      final result = await _zsdk.printZplDataOverBluetooth(
        data: zpl,
        macAddress: printer.address,
      );

      final response = PrinterResponse.fromMap(result);
      if (response.errorCode == ErrorCode.SUCCESS) {
        return true;
      }
      debugPrint('[PrintService] ZPL BT print failed: ${response.statusInfo?.cause}');
      return false;
    } catch (e) {
      debugPrint('[PrintService] ZPL BT print error: $e');
      return false;
    }
  }
}
