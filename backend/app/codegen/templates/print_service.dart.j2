import 'package:flutter/material.dart';
import 'package:permission_handler/permission_handler.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:zsdk/zsdk.dart';

/// A Bluetooth printer (bonded or discovered via zsdk).
class DiscoveredPrinter {
  final String name;
  final String address; // Bluetooth MAC address (e.g. C4:D3:6A:AC:F0:AE)

  const DiscoveredPrinter({
    required this.name,
    required this.address,
  });
}

class PrintService {
  static final PrintService instance = PrintService._();
  PrintService._();

  final _zsdk = ZSDK();

  /// Human-readable reason the last print failed (null if it succeeded).
  /// Callers can show this instead of a generic "Print failed" message.
  String? lastPrintError;

  static const _kDefaultMacKey = 'default_printer_mac';
  static const _kDefaultNameKey = 'default_printer_name';
  static const _kDpiKey = 'printer_dpi';

  /// Supported label print resolutions.
  static const List<int> supportedDpi = [203, 300];
  static const int defaultDpi = 300;

  /// Persist the user's chosen printer so auto-print targets it directly
  /// instead of blindly using the first paired Bluetooth device (which may
  /// be a laptop/phone, not the Zebra printer).
  Future<void> setDefaultPrinter(DiscoveredPrinter printer) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_kDefaultMacKey, printer.address);
    await prefs.setString(_kDefaultNameKey, printer.name);
  }

  /// Returns the saved default printer, or null if none has been chosen yet.
  Future<DiscoveredPrinter?> getDefaultPrinter() async {
    final prefs = await SharedPreferences.getInstance();
    final mac = prefs.getString(_kDefaultMacKey);
    if (mac == null || mac.isEmpty) return null;
    return DiscoveredPrinter(
      name: prefs.getString(_kDefaultNameKey) ?? mac,
      address: mac,
    );
  }

  /// Persist the label print resolution (203 or 300 dpi) so the user can
  /// switch printers of a different DPI class without mis-scaled labels.
  Future<void> setPrinterDpi(int dpi) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setInt(_kDpiKey, dpi);
  }

  /// Returns the saved DPI setting, defaulting to [defaultDpi] (300) —
  /// the resolution the label layout was originally designed for.
  Future<int> getPrinterDpi() async {
    final prefs = await SharedPreferences.getInstance();
    return prefs.getInt(_kDpiKey) ?? defaultDpi;
  }

  // ── Bluetooth discovery ───────────────────────────────────────────────────

  /// Ensure the Bluetooth runtime permissions are granted before any
  /// classic-Bluetooth call. On Android 12+:
  ///  - BLUETOOTH_CONNECT → needed for getBondedDevices() (without it the list
  ///    silently comes back empty even when a printer is paired)
  ///  - BLUETOOTH_SCAN    → needed because zsdk's print path internally calls
  ///    BluetoothAdapter.cancelDiscovery(), which throws a SecurityException
  ///    ("Need BLUETOOTH_SCAN permission ... cancelDiscovery") without it.
  /// permission_handler works without a BuildContext, so UI-less callers
  /// (e.g. auto-print) are covered too.
  Future<bool> _ensureConnectPermission() async {
    final statuses = await [
      Permission.bluetoothConnect,
      Permission.bluetoothScan,
    ].request();
    final connect = statuses[Permission.bluetoothConnect]?.isGranted ?? false;
    final scan = statuses[Permission.bluetoothScan]?.isGranted ?? false;
    return connect && scan;
  }

  /// Return already-paired (bonded) Bluetooth devices.
  Future<List<DiscoveredPrinter>> getBondedPrinters() async {
    try {
      if (!await _ensureConnectPermission()) {
        throw Exception(
            'Bluetooth permission denied — allow it to find paired printers.');
      }
      final devices = await _zsdk.getBondedDevices();
      return devices
          .map((d) => DiscoveredPrinter(
                name: (d['name'] as String?)?.isNotEmpty == true
                    ? d['name']!
                    : (d['address'] ?? 'Unknown'),
                address: d['address'] ?? '',
              ))
          .where((p) => p.address.isNotEmpty)
          .toList();
    } catch (e) {
      debugPrint('[PrintService] getBondedDevices error: $e');
      rethrow;
    }
  }

  /// Actively scan for nearby Zebra Bluetooth printers (Android only).
  Future<List<DiscoveredPrinter>> discoverBluetoothPrinters() async {
    try {
      if (!await _ensureConnectPermission()) {
        throw Exception(
            'Bluetooth permission denied — allow it to scan for printers.');
      }
      final devices = await _zsdk.discoverBluetoothPrinters();
      return devices
          .map((d) => DiscoveredPrinter(
                name: (d['name'] as String?)?.isNotEmpty == true
                    ? d['name']!
                    : 'Zebra Printer',
                address: d['address'] ?? '',
              ))
          .where((p) => p.address.isNotEmpty)
          .toList();
    } catch (e) {
      debugPrint('[PrintService] discoverBluetoothPrinters error: $e');
      rethrow;
    }
  }

  // ── ZPL label generation ──────────────────────────────────────────────────

  /// Returns true if [value] is a real detected part (not null/empty/"None").
  bool _hasValue(String? value) {
    if (value == null) return false;
    final v = value.trim().toLowerCase();
    return v.isNotEmpty && v != 'none' && v != 'null' && v != 'n/a';
  }

  /// Build a ZPL II label for the inspection report.
  /// Authored for a Zebra ZT411 at 300 dpi, 4-inch wide labels; all
  /// coordinates are scaled at print time for [dpi] (e.g. 203 dpi) so the
  /// label keeps the same physical 4-inch size on either printer class.
  String _buildZpl({
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
    int dpi = PrintService.defaultDpi,
  }) {
    final double scale = dpi / PrintService.defaultDpi;
    int s(num v) => (v * scale).round();

    // Clean up ISO timestamp → "2026-03-26 15:46:09"
    final cleanDate = timestamp
        .replaceFirst('T', ' ')
        .replaceAll(RegExp(r'\.\d+$'), '');

    // Only show failed tasks on the label
    final failedTasks = overallSuccess
        ? <Map<String, dynamic>>[]
        : tasks.where((t) => t['success'] != true).toList();

    // When there are many failed tasks, lay them out in two columns so the
    // label stays compact instead of growing very long.
    final bool twoCol = failedTasks.length > 4;

    // Body is built first so the exact content height (and therefore ^LL)
    // is known before we emit the header — avoids magic-number height math
    // drifting out of sync with the layout below.
    final body = StringBuffer();
    int y = s(20);

    // ── Title ─────────────────────────────────────────────────────────────────
    body.writeln(
        '^FO${s(50)},$y^A0N,${s(46)},${s(32)}^FDDIGITAL EYE INSPECTION REPORT^FS');
    y += s(75);
    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(18);

    // ── VIN — its own full-width row, printed extra large for readability ──
    body.writeln('^FO${s(50)},$y^A0N,${s(30)},${s(20)}^FDVIN :^FS');
    y += s(34);
    body.writeln('^FO${s(50)},$y^A0N,${s(90)},${s(60)}^FD$vin^FS');
    y += s(100);
    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(18);

    // ── DATE + TIME, single compact row ─────────────────────────────────────
    final parts = cleanDate.split(' ');
    final datePart = parts.isNotEmpty ? parts[0] : cleanDate;
    final timePart = parts.length > 1 ? parts[1] : '';
    body.writeln(
        '^FO${s(50)},$y^A0N,${s(26)},${s(18)}^FDDATE : $datePart    TIME : $timePart^FS');
    y += s(40);
    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(18);

    // ── Status ────────────────────────────────────────────────────────────────
    final statusText = overallSuccess ? '[ PASSED ]' : '[ FAILED ]';
    body.writeln('^FO${s(50)},$y^A0N,${s(60)},${s(44)}^FD$statusText^FS');
    y += s(75);
    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(18);

    // ── Failed tasks only ─────────────────────────────────────────────────────
    if (failedTasks.isNotEmpty) {
      body.writeln('^FO${s(50)},$y^A0N,${s(32)},${s(23)}^FDFAILED TASKS^FS');
      y += s(44);
      body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(2)},${s(2)}^FS');
      y += s(12);

      String fit(String str, int max) =>
          str.length > max ? '${str.substring(0, max - 3)}...' : str;

      if (!twoCol) {
        // Single column — one task per row, full width.
        for (final task in failedTasks) {
          final name = fit(task['taskName'] as String? ?? 'Task', 40);
          body.writeln('^FO${s(50)},$y^A0N,${s(38)},${s(27)}^FD$name^FS');
          y += s(50);

          final part = task['detectedPart'] as String?;
          if (_hasValue(part)) {
            body.writeln(
                '^FO${s(70)},$y^A0N,${s(30)},${s(22)}^FD> ${fit(part!.trim(), 44)}^FS');
            y += s(40);
          }

          body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(2)},${s(2)}^FS');
          y += s(8);
        }
        y += s(6);
      } else {
        // Two columns — left column fills first, then right column.
        final startY = y;
        final half = (failedTasks.length / 2).ceil();
        final rowH = s(98);
        final colX = [s(50), s(620)];
        for (int i = 0; i < failedTasks.length; i++) {
          final col = i < half ? 0 : 1;
          final rowIdx = i < half ? i : i - half;
          final rx = colX[col];
          final ry = startY + rowIdx * rowH;
          final task = failedTasks[i];

          // ~22 chars fit in a ~550-dot column at width 24.
          final name = fit(task['taskName'] as String? ?? 'Task', 22);
          body.writeln('^FO$rx,$ry^A0N,${s(34)},${s(24)}^FD$name^FS');

          final part = task['detectedPart'] as String?;
          if (_hasValue(part)) {
            body.writeln(
                '^FO${rx + s(20)},${ry + s(44)}^A0N,${s(28)},${s(20)}^FD> ${fit(part!.trim(), 24)}^FS');
          }
        }
        y = startY + half * rowH + s(6);
      }
    }

    body.writeln('^FO${s(50)},$y^GB${s(1100)},${s(4)},${s(4)}^FS');
    y += s(14);

    // ── Footer ────────────────────────────────────────────────────────────────
    body.writeln(
        '^FO${s(50)},$y^A0N,${s(30)},${s(22)}^FD* Digital Eye Inspection System *^FS');
    y += s(40);

    final header = StringBuffer();
    header.writeln('^XA');
    header.writeln('^PW${s(1200)}');
    header.writeln('^LL$y');

    return header.toString() + body.toString() + '^XZ\n';
  }

  // ── Print ─────────────────────────────────────────────────────────────────

  /// Send ZPL inspection report to [printer] over Bluetooth.
  Future<bool> printInspectionReport({
    required DiscoveredPrinter printer,
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) async {
    lastPrintError = null;
    try {
      if (!await _ensureConnectPermission()) {
        lastPrintError = 'Bluetooth permission denied';
        debugPrint('[PrintService] print aborted — BLUETOOTH_CONNECT denied');
        return false;
      }
      final zpl = _buildZpl(
        vin: vin,
        modelCode: modelCode,
        timestamp: timestamp,
        overallSuccess: overallSuccess,
        tasks: tasks,
        dpi: await getPrinterDpi(),
      );

      final result = await _zsdk.printZplDataOverBluetooth(
        data: zpl,
        macAddress: printer.address,
      );

      final response = PrinterResponse.fromMap(result);
      if (response.errorCode == ErrorCode.SUCCESS) {
        return true;
      }
      lastPrintError = response.statusInfo?.cause?.toString() ??
          'Printer rejected the job (code ${response.errorCode})';
      debugPrint('[PrintService] ZPL BT print failed: $lastPrintError');
      return false;
    } catch (e) {
      lastPrintError = e.toString();
      debugPrint('[PrintService] ZPL BT print error: $e');
      return false;
    }
  }
}
