import 'dart:async';
import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:permission_handler/permission_handler.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:zsdk/zsdk.dart';

/// A Bluetooth printer (bonded or discovered via zsdk).
class DiscoveredPrinter {
  final String name;
  final String address; // Bluetooth MAC address (e.g. C4:D3:6A:AC:F0:AE)

  const DiscoveredPrinter({
    required this.name,
    required this.address,
  });
}

/// One row of the printed label. Live rows (VIN, date/time, status, failed
/// tasks) are filled in at print time and can be moved / resized / hidden but
/// never deleted; title, footer and custom rows carry editable text.
class LabelRow {
  final String id;
  final String type; // title | vin | datetime | status | failed | footer | custom
  String text;
  int size; // percent of the default size
  bool visible;

  LabelRow({
    required this.id,
    required this.type,
    this.text = '',
    this.size = 100,
    this.visible = true,
  });

  bool get isLive =>
      type == 'vin' || type == 'datetime' || type == 'status' || type == 'failed';
  bool get hasText => !isLive;
  bool get deletable => type == 'custom';

  Map<String, dynamic> toJson() =>
      {'id': id, 'type': type, 'text': text, 'size': size, 'visible': visible};

  static LabelRow fromJson(Map<String, dynamic> j) => LabelRow(
        id: j['id'] as String,
        type: j['type'] as String,
        text: (j['text'] as String?) ?? '',
        size: ((j['size'] as num?) ?? 100).toInt().clamp(40, 250).toInt(),
        visible: (j['visible'] as bool?) ?? true,
      );

  /// The layout the app printed before this screen existed.
  static List<LabelRow> defaults() => [
        LabelRow(id: 'title', type: 'title', text: 'DIGITAL EYE INSPECTION REPORT'),
        LabelRow(id: 'vin', type: 'vin'),
        LabelRow(id: 'datetime', type: 'datetime'),
        LabelRow(id: 'status', type: 'status'),
        LabelRow(id: 'failed', type: 'failed'),
        LabelRow(id: 'footer', type: 'footer', text: '* Digital Eye Inspection System *'),
      ];
}

class PrintService {
  static final PrintService instance = PrintService._();
  PrintService._();

  final _zsdk = ZSDK();

  /// Human-readable reason the last print failed (null if it succeeded).
  /// Callers can show this instead of a generic "Print failed" message.
  String? lastPrintError;

  static const _kDefaultMacKey = 'default_printer_mac';
  static const _kDefaultNameKey = 'default_printer_name';
  static const _kDpiKey = 'printer_dpi';
  static const _kPromptedKey = 'printer_setup_prompted';
  static const _kLayoutKey = 'label_layout_v1';

  /// Supported label print resolutions.
  static const List<int> supportedDpi = [203, 300];
  static const int defaultDpi = 300;

  /// Persist the user's chosen printer so auto-print targets it directly
  /// instead of blindly using the first paired Bluetooth device (which may
  /// be a laptop/phone, not the Zebra printer).
  Future<void> setDefaultPrinter(DiscoveredPrinter printer) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_kDefaultMacKey, printer.address);
    await prefs.setString(_kDefaultNameKey, printer.name);
  }

  /// Returns the saved default printer, or null if none has been chosen yet.
  Future<DiscoveredPrinter?> getDefaultPrinter() async {
    final prefs = await SharedPreferences.getInstance();
    final mac = prefs.getString(_kDefaultMacKey);
    if (mac == null || mac.isEmpty) return null;
    return DiscoveredPrinter(
      name: prefs.getString(_kDefaultNameKey) ?? mac,
      address: mac,
    );
  }

  /// Persist the label print resolution (203 or 300 dpi) so the user can
  /// switch printers of a different DPI class without mis-scaled labels.
  Future<void> setPrinterDpi(int dpi) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setInt(_kDpiKey, dpi);
  }

  /// Returns the saved DPI setting, defaulting to [defaultDpi] (300) —
  /// the resolution the label layout was originally designed for.
  Future<int> getPrinterDpi() async {
    final prefs = await SharedPreferences.getInstance();
    return prefs.getInt(_kDpiKey) ?? defaultDpi;
  }

  /// Whether the operator has already been asked (once) to set up a
  /// printer after submitting with none configured. Lets that prompt show
  /// exactly once per install instead of on every single submit -- the
  /// print icon on the scan screen is always available for setting one up
  /// later regardless of this flag.
  Future<bool> hasPromptedPrinterSetup() async {
    final prefs = await SharedPreferences.getInstance();
    return prefs.getBool(_kPromptedKey) ?? false;
  }

  Future<void> markPrinterSetupPrompted() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setBool(_kPromptedKey, true);
  }

  /// Saved label layout (defaults when none saved or the saved one is bad).
  /// Any default row missing from a saved layout (live rows especially) is
  /// put back so the label can never lose its VIN / status.
  Future<List<LabelRow>> getLabelLayout() async {
    final defaults = LabelRow.defaults();
    try {
      final prefs = await SharedPreferences.getInstance();
      final raw = prefs.getString(_kLayoutKey);
      if (raw == null || raw.isEmpty) return defaults;
      final rows = (jsonDecode(raw) as List)
          .map((e) => LabelRow.fromJson(Map<String, dynamic>.from(e as Map)))
          .toList();
      for (int i = 0; i < defaults.length; i++) {
        if (!rows.any((r) => r.id == defaults[i].id)) {
          rows.insert(i < rows.length ? i : rows.length, defaults[i]);
        }
      }
      return rows;
    } catch (_) {
      return defaults;
    }
  }

  Future<void> saveLabelLayout(List<LabelRow> rows) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_kLayoutKey, jsonEncode(rows.map((r) => r.toJson()).toList()));
  }

  Future<void> resetLabelLayout() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove(_kLayoutKey);
  }

  // ── Bluetooth discovery ───────────────────────────────────────────────────

  /// Ensure the Bluetooth runtime permissions are granted before any
  /// classic-Bluetooth call. On Android 12+:
  ///  - BLUETOOTH_CONNECT → needed for getBondedDevices() (without it the list
  ///    silently comes back empty even when a printer is paired)
  ///  - BLUETOOTH_SCAN    → needed because zsdk's print path internally calls
  ///    BluetoothAdapter.cancelDiscovery(), which throws a SecurityException
  ///    ("Need BLUETOOTH_SCAN permission ... cancelDiscovery") without it.
  /// permission_handler works without a BuildContext, so UI-less callers
  /// (e.g. auto-print) are covered too.
  Future<bool> _ensureConnectPermission() async {
    final statuses = await [
      Permission.bluetoothConnect,
      Permission.bluetoothScan,
    ].request();
    final connect = statuses[Permission.bluetoothConnect]?.isGranted ?? false;
    final scan = statuses[Permission.bluetoothScan]?.isGranted ?? false;
    return connect && scan;
  }

  /// Return already-paired (bonded) Bluetooth devices.
  Future<List<DiscoveredPrinter>> getBondedPrinters() async {
    try {
      if (!await _ensureConnectPermission()) {
        throw Exception(
            'Bluetooth permission denied — allow it to find paired printers.');
      }
      final devices = await _zsdk.getBondedDevices();
      return devices
          .map((d) => DiscoveredPrinter(
                name: (d['name'] as String?)?.isNotEmpty == true
                    ? d['name']!
                    : (d['address'] ?? 'Unknown'),
                address: d['address'] ?? '',
              ))
          .where((p) => p.address.isNotEmpty)
          .toList();
    } catch (e) {
      debugPrint('[PrintService] getBondedDevices error: $e');
      rethrow;
    }
  }

  /// Actively scan for nearby Zebra Bluetooth printers (Android only).
  Future<List<DiscoveredPrinter>> discoverBluetoothPrinters() async {
    try {
      if (!await _ensureConnectPermission()) {
        throw Exception(
            'Bluetooth permission denied — allow it to scan for printers.');
      }
      final devices = await _zsdk.discoverBluetoothPrinters();
      return devices
          .map((d) => DiscoveredPrinter(
                name: (d['name'] as String?)?.isNotEmpty == true
                    ? d['name']!
                    : 'Zebra Printer',
                address: d['address'] ?? '',
              ))
          .where((p) => p.address.isNotEmpty)
          .toList();
    } catch (e) {
      debugPrint('[PrintService] discoverBluetoothPrinters error: $e');
      rethrow;
    }
  }

  // ── ZPL label generation ──────────────────────────────────────────────────

  /// Returns true if [value] is a real detected part (not null/empty/"None").
  bool _hasValue(String? value) {
    if (value == null) return false;
    final v = value.trim().toLowerCase();
    return v.isNotEmpty && v != 'none' && v != 'null' && v != 'n/a';
  }

  /// Build a ZPL II label for the inspection report from the saved [rows].
  /// Authored for a Zebra ZT411 at 300 dpi, 4-inch wide labels; all
  /// coordinates are scaled at print time for [dpi] (e.g. 203 dpi) so the
  /// label keeps the same physical 4-inch size on either printer class.
  /// Each row's size % scales its fonts and height; long text is shrunk to
  /// fit the label width instead of running off the edge.
  String _buildZpl({
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
    required List<LabelRow> rows,
    int dpi = PrintService.defaultDpi,
  }) {
    final double scale = dpi / PrintService.defaultDpi;
    int s(num v) => (v * scale).round();
    const int usable = 1100; // printable width in 300-dpi dots

    // Clean up ISO timestamp -> "2026-03-26 15:46:09"
    final cleanDate = timestamp
        .replaceFirst('T', ' ')
        .replaceAll(RegExp(r'\.\d+$'), '');
    final dtParts = cleanDate.split(' ');
    final datePart = dtParts.isNotEmpty ? dtParts[0] : cleanDate;
    final timePart = dtParts.length > 1 ? dtParts[1] : '';

    // Only show failed tasks on the label
    final failedTasks = overallSuccess
        ? <Map<String, dynamic>>[]
        : tasks.where((t) => t['success'] != true).toList();
    final bool twoCol = failedTasks.length > 4;

    // ZPL control characters must not appear in field data.
    String z(String t) => t.replaceAll(RegExp(r'[\^~\\]'), ' ');
    String fit(String str, int max) =>
        str.length > max ? '${str.substring(0, max - 3)}...' : str;
    // Largest char width <= [baseW] that keeps [len] chars inside [maxDots].
    int fitW(num baseW, int len, [int maxDots = usable]) {
      if (len <= 0) return baseW.round();
      final maxW = (maxDots / len).floor();
      final w = baseW < maxW ? baseW.round() : maxW;
      return w < 10 ? 10 : w;
    }

    final body = StringBuffer();
    int y = s(20);
    bool first = true;

    void line(int thick) {
      body.writeln('^FO${s(50)},$y^GB${s(usable)},${s(thick)},${s(thick)}^FS');
    }

    for (final row in rows) {
      if (!row.visible) continue;
      final double f = row.size / 100.0;

      // Rows with nothing to print take no space (and no separator).
      if (row.type == 'failed' && failedTasks.isEmpty) continue;
      if (row.hasText && row.text.trim().isEmpty) continue;

      if (!first) {
        line(4);
        y += s(18);
      }
      first = false;

      switch (row.type) {
        case 'title':
        case 'footer':
        case 'custom': {
          final t = z(row.text.trim());
          final double baseH = row.type == 'title' ? 46 : row.type == 'footer' ? 30 : 40;
          final double baseW = row.type == 'title' ? 32 : row.type == 'footer' ? 22 : 28;
          final double adv = row.type == 'title' ? 75 : row.type == 'footer' ? 40 : 55;
          final w = fitW(baseW * f, t.length);
          final h = (baseH * f * (w / (baseW * f))).round();
          body.writeln('^FO${s(50)},$y^A0N,${s(h)},${s(w)}^FD$t^FS');
          y += s(adv * f);
          break;
        }

        case 'vin': {
          body.writeln('^FO${s(50)},$y^A0N,${s(30 * f)},${s(20 * f)}^FDVIN :^FS');
          y += s(34 * f);
          final v = z(vin);
          final w = fitW(60 * f, v.length);
          final h = (90 * f * (w / (60 * f))).round();
          body.writeln('^FO${s(50)},$y^A0N,${s(h)},${s(w)}^FD$v^FS');
          y += s(100 * f);
          break;
        }

        case 'datetime': {
          final t = 'DATE : $datePart    TIME : $timePart';
          final w = fitW(18 * f, t.length);
          final h = (26 * f * (w / (18 * f))).round();
          body.writeln('^FO${s(50)},$y^A0N,${s(h)},${s(w)}^FD$t^FS');
          y += s(40 * f);
          break;
        }

        case 'status': {
          final st = overallSuccess ? '[ PASSED ]' : '[ FAILED ]';
          body.writeln('^FO${s(50)},$y^A0N,${s(60 * f)},${s(44 * f)}^FD$st^FS');
          y += s(75 * f);
          break;
        }

        case 'failed': {
          body.writeln('^FO${s(50)},$y^A0N,${s(32 * f)},${s(23 * f)}^FDFAILED TASKS^FS');
          y += s(44 * f);
          line(2);
          y += s(12);
          if (!twoCol) {
            for (final task in failedTasks) {
              final name = z(fit(task['taskName'] as String? ?? 'Task', 40));
              body.writeln(
                  '^FO${s(50)},$y^A0N,${s(38 * f)},${s(fitW(27 * f, name.length))}^FD$name^FS');
              y += s(50 * f);
              final part = task['detectedPart'] as String?;
              if (_hasValue(part)) {
                final pt = z('> ${fit(part!.trim(), 44)}');
                body.writeln(
                    '^FO${s(70)},$y^A0N,${s(30 * f)},${s(fitW(22 * f, pt.length, usable - 20))}^FD$pt^FS');
                y += s(40 * f);
              }
              line(2);
              y += s(8);
            }
            y += s(6);
          } else {
            final startY = y;
            final half = (failedTasks.length / 2).ceil();
            final rowH = s(98 * f);
            final colX = [s(50), s(620)];
            for (int i = 0; i < failedTasks.length; i++) {
              final col = i < half ? 0 : 1;
              final rowIdx = i < half ? i : i - half;
              final rx = colX[col];
              final ry = startY + rowIdx * rowH;
              final task = failedTasks[i];
              final name = z(fit(task['taskName'] as String? ?? 'Task', 22));
              body.writeln(
                  '^FO$rx,$ry^A0N,${s(34 * f)},${s(fitW(24 * f, name.length, 520))}^FD$name^FS');
              final part = task['detectedPart'] as String?;
              if (_hasValue(part)) {
                final pt = z('> ${fit(part!.trim(), 24)}');
                body.writeln(
                    '^FO${rx + s(20)},${ry + s(44 * f)}^A0N,${s(28 * f)},${s(fitW(20 * f, pt.length, 500))}^FD$pt^FS');
              }
            }
            y = startY + half * rowH + s(6);
          }
          break;
        }
      }
    }
    y += s(10);

    final header = StringBuffer();
    header.writeln('^XA');
    header.writeln('^PW${s(1200)}');
    header.writeln('^LL$y');

    return header.toString() + body.toString() + '^XZ\n';
  }

  // ── Print ─────────────────────────────────────────────────────────────────

  /// Send ZPL inspection report to [printer] over Bluetooth.
  Future<bool> printInspectionReport({
    required DiscoveredPrinter printer,
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) async {
    lastPrintError = null;
    try {
      if (!await _ensureConnectPermission()) {
        lastPrintError = 'Bluetooth permission denied';
        debugPrint('[PrintService] print aborted — BLUETOOTH_CONNECT denied');
        return false;
      }
      final zpl = _buildZpl(
        vin: vin,
        modelCode: modelCode,
        timestamp: timestamp,
        overallSuccess: overallSuccess,
        tasks: tasks,
        rows: await getLabelLayout(),
        dpi: await getPrinterDpi(),
      );

      // A printer that's off, out of range, or stuck in a bad Bluetooth
      // state can leave this connect-and-print call hanging far longer
      // than any real print job takes -- with no timeout, that silently
      // stalls the whole submit flow forever (the inspector sees "Printing
      // to X..." and never gets back to the next scan, even though the
      // app itself isn't frozen -- this call just never resolves). Bound
      // it so a bad printer always fails cleanly instead of hanging.
      // 8s -- a real connect+print over Bluetooth normally finishes in a
      // couple of seconds when the printer is actually on and in range, so
      // this still leaves comfortable margin without making the inspector
      // wait needlessly long on a printer that just isn't there.
      final result = await _zsdk.printZplDataOverBluetooth(
        data: zpl,
        macAddress: printer.address,
      ).timeout(const Duration(seconds: 8));

      final response = PrinterResponse.fromMap(result);
      if (response.errorCode == ErrorCode.SUCCESS) {
        return true;
      }
      lastPrintError = response.statusInfo?.cause?.toString() ??
          'Printer rejected the job (code ${response.errorCode})';
      debugPrint('[PrintService] ZPL BT print failed: $lastPrintError');
      return false;
    } on TimeoutException {
      lastPrintError = 'Printer connection timed out -- check it is on and in range';
      debugPrint('[PrintService] ZPL BT print timed out');
      return false;
    } catch (e) {
      lastPrintError = e.toString();
      debugPrint('[PrintService] ZPL BT print error: $e');
      return false;
    }
  }
}
