                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(Icons.cloud_off, size: 10, color: Colors.orange),
                          SizedBox(width: 3),
                          Text('Not uploaded',
                              style: TextStyle(fontSize: 9, color: Colors.orange, fontWeight: FontWeight.bold)),
