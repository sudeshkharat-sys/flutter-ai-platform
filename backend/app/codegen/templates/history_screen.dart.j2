              children: [
                Expanded(
                  child: Text(
                    '{% if scan_type == "engine" %}Engine Code{% else %}Model{% endif %}: ${item['modelCode']} • ${_formatDate(date)} ${date.hour.toString().padLeft(2, '0')}:${date.minute.toString().padLeft(2, '0')}',
                    style: const TextStyle(fontSize: 11, color: Colors.grey),
