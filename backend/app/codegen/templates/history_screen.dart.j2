                      ),
                    ),
                  ),
              ],
            ),
            trailing: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                IconButton(
                  icon: const Icon(Icons.print_outlined,
                      color: Color(0xFFDC143C), size: 22),
                  tooltip: 'Print Report',
                  onPressed: () async {
                    DiscoveredPrinter? printer;
                    try {
                      printer =
                          await PrintService.instance.getDefaultPrinter();
                    } catch (e) {
                      if (!context.mounted) return;
                      ScaffoldMessenger.of(context).showSnackBar(
                        SnackBar(
                          content: Text('Printer error: $e'),
                          backgroundColor: Colors.orange,
                          duration: const Duration(seconds: 4),
                        ),
                      );
                      return;
                    }
                    if (!context.mounted) return;
                    if (printer == null) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text(
                              'No default printer set. Print once from a new inspection to choose your printer.'),
                          backgroundColor: Colors.orange,
                          duration: Duration(seconds: 4),
                        ),
                      );
                      return;
                    }
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(
                        content: Text('Printing to ${printer.name}...'),
                        backgroundColor: Colors.blue,
                        duration: const Duration(seconds: 2),
                      ),
                    );
                    final printSuccess =
                        await PrintService.instance.printInspectionReport(
                      printer: printer,
                      vin: item['vin'] as String,
                      modelCode: item['modelCode'] as String,
                      timestamp: item['timestamp'] as String,
                      overallSuccess: overallSuccess,
                      tasks: List<Map<String, dynamic>>.from(tasks),
                    );
                    if (!context.mounted) return;
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(
                        content: Text(printSuccess
                            ? 'Report printed to ${printer.name}'
                            : 'Print failed: ${PrintService.instance.lastPrintError ?? 'check the printer'}'),
                        backgroundColor:
                            printSuccess ? Colors.green : Colors.red,
                        duration: const Duration(seconds: 6),
                      ),
                    );
                  },
                ),
                const Icon(Icons.expand_more, color: Colors.grey),
              ],
            ),
            children: [
              const Divider(height: 1),
              ...tasks.map((task) {
                final String? imgPath = task['imagePath'] as String?;
                final String? backupImgPath = task['backupImagePath'] as String?;
                final bool taskSuccess = task['success'] as bool? ?? false;
                final String? detectionsRaw = task['detectionsJson'] as String?;
                List<DetectionResult> detections = [];
                if (detectionsRaw != null) {
                  try {
                    detections = (jsonDecode(detectionsRaw) as List)
                        .map((e) =>
                            DetectionResult.fromJson(e as Map<String, dynamic>))
                        .toList();
                  } catch (_) {}
                }

                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Padding(
                      padding: const EdgeInsets.symmetric(
                          horizontal: 16, vertical: 10),
                      child: Row(
                        children: [
                          Icon(
                            taskSuccess ? Icons.check : Icons.close,
                            color: taskSuccess ? Colors.green : Colors.red,
                            size: 16,
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  task['taskName'] ?? 'Task',
                                  style: const TextStyle(
                                      fontWeight: FontWeight.bold,
                                      fontSize: 13),
                                ),
                                Text(
                                  'Detected: ${task['detectedPart']}',
                                  style: const TextStyle(
                                      fontSize: 11, color: Colors.blueGrey),
                                ),
                              ],
                            ),
                          ),
                        ],
                      ),
                    ),
                    if (imgPath != null || backupImgPath != null)
                      Padding(
                        padding: const EdgeInsets.fromLTRB(16, 0, 16, 12),
                        child: ClipRRect(
                          borderRadius: BorderRadius.circular(8),
                          child: _HistoryImageWithOverlay(
                            imagePath: imgPath,
                            backupImagePath: backupImgPath,
                            detections: detections,
                            taskSuccess: taskSuccess,
                          ),
                        ),
                      ),
                  ],
                );
              }).toList(),
                      const SizedBox(height: 8),
                    ],
                  ),
                );
              },
            ),
          ),
        ],
      );
  }
}

// -- Image + overlay helper ---------------------------------------------------

class _HistoryImageWithOverlay extends StatefulWidget {
  final String? imagePath;
  final String? backupImagePath;
  final List<DetectionResult> detections;
  final bool taskSuccess;

  const _HistoryImageWithOverlay({
    required this.imagePath,
    required this.backupImagePath,
    required this.detections,
    required this.taskSuccess,
  });

  @override
  State<_HistoryImageWithOverlay> createState() =>
      _HistoryImageWithOverlayState();
}

class _HistoryImageWithOverlayState extends State<_HistoryImageWithOverlay> {
  Size? _imageSize;
  String? _resolvedPath;

  @override
  void initState() {
    super.initState();
    _loadSize();
  }

  // Pick the primary path if the file exists, fall back to backup.
  Future<String?> _resolvePath() async {
    if (widget.imagePath != null && await File(widget.imagePath!).exists()) {
      return widget.imagePath;
    }
    if (widget.backupImagePath != null && await File(widget.backupImagePath!).exists()) {
      return widget.backupImagePath;
    }
    return null;
  }

  Future<void> _loadSize() async {
    try {
      final path = await _resolvePath();
      if (path == null) return;
      final bytes = await File(path).readAsBytes();
      final decoded = img.decodeImage(bytes);
      if (decoded != null && mounted) {
        final oriented = img.bakeOrientation(decoded);
        setState(() {
          _resolvedPath = path;
          _imageSize = Size(oriented.width.toDouble(), oriented.height.toDouble());
        });
      }
    } catch (_) {}
  }

  @override
  Widget build(BuildContext context) {
    if (_resolvedPath == null) {
      return Container(
        height: 80,
        decoration: BoxDecoration(
          color: Colors.grey.shade100,
          borderRadius: BorderRadius.circular(6),
        ),
        child: const Center(
          child: Icon(Icons.broken_image_outlined, color: Colors.grey, size: 32),
        ),
      );
    }

    final file = File(_resolvedPath!);
    final Color overlayColor = widget.taskSuccess ? Colors.green : Colors.red;

    if (_imageSize == null) {
      return ConstrainedBox(
        constraints: const BoxConstraints(maxHeight: 260),
        child: Image.file(
          file,
          width: double.infinity,
          fit: BoxFit.contain,
          errorBuilder: (_, __, ___) => Container(
            height: 80,
            decoration: BoxDecoration(
              color: Colors.grey.shade100,
              borderRadius: BorderRadius.circular(6),
            ),
            child: const Center(
              child: Icon(Icons.broken_image_outlined, color: Colors.grey, size: 32),
            ),
          ),
        ),
      );
    }

    return ConstrainedBox(
      constraints: const BoxConstraints(maxHeight: 400),
      child: FittedBox(
        fit: BoxFit.contain,
        child: SizedBox(
          width: _imageSize!.width,
          height: _imageSize!.height,
          child: Stack(
            fit: StackFit.expand,
            children: [
              Image.file(
                file,
                fit: BoxFit.fill,
                width: _imageSize!.width,
                height: _imageSize!.height,
              ),
              if (widget.detections.isNotEmpty)
                DetectionOverlay(
                  results: widget.detections,
                  previewSize: _imageSize!,
                  overrideColor: overlayColor,
                ),
            ],
          ),
        ),
      ),
    );
  }
}
