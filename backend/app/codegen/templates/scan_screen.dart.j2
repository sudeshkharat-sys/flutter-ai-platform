{% elif scan_type == 'chakan' %}
  // ── Chakan Plant Scan Logic ───────────────────────────────────────────────
  // Barcode format: VIN_MODELCODE_GARBAGE (underscore-delimited).
  // Model code segment may carry 2 trailing junk characters, resolved via the
  // shared _resolveModelCode() above (same stripping rule as the VIN flow).

  Future<void> _handleChakanScan(String raw) async {
    final List<String> parts = raw.split('_');
    if (parts.length < 2 || parts[0].trim().isEmpty || parts[1].trim().isEmpty) {
      setState(() => _isProcessing = true);
      _showErrorDialog('Invalid Chakan Plant barcode. Expected format: VIN_MODELCODE_GARBAGE');
      return;
    }

    setState(() => _isProcessing = true);

    final String vin = parts[0].trim();
    final String extractedModelCode = _resolveModelCode(parts[1].trim());

{% if not skip_masterdata_validation %}
    if (!_isKnownModelCode(extractedModelCode)) {
      _showErrorDialog('Model code is not present, please add code and rebuild app.');
      return;
    }
{% endif %}

    if (!mounted) return;
    // stop() can resolve before the camera HAL actually releases the
    // hardware -- without a head start here, the next screen's own
    // CameraController can start binding while this scanner's camera
    // session is still tearing down, and CameraX throws "No supported
    // surface combination is found for camera device" from two camera
    // clients contending for the same device at once. Same race (and same
    // fix) as the Sync/Pair-PC navigation elsewhere in this file.
    await _scannerController.stop();
    await Future.delayed(const Duration(milliseconds: 300));
    if (!mounted) return;
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => {% if is_ocr_app %}OcrScanScreen(cameras: widget.cameras, truthValue: vin){% else %}HomeScreen(
          vin: vin,
          modelCode: {% if skip_masterdata_validation %}''{% else %}extractedModelCode{% endif %},
