import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:mobile_scanner/mobile_scanner.dart';
import 'home_screen.dart';
import 'history_screen.dart';

class ScanScreen extends StatefulWidget {
  final String modelCode;
  const ScanScreen({super.key, required this.modelCode});

  @override
  State<ScanScreen> createState() => _ScanScreenState();
}

class _ScanScreenState extends State<ScanScreen> with WidgetsBindingObserver {
  bool _isProcessing = false;
  List<dynamic> _scanData = [];
  String? _pendingBarcode;
  bool _manualMode = false;

  final MobileScannerController _scannerController = MobileScannerController(
    detectionSpeed: DetectionSpeed.noDuplicates,
    facing: CameraFacing.back,
  );

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _loadScanData();
  }

  Future<void> _loadScanData() async {
    try {
{% if scan_type == 'engine' %}
      final String jsonStr = await rootBundle.loadString('assets/engine_data.json');
{% else %}
      final String jsonStr = await rootBundle.loadString('assets/master_data.json');
{% endif %}
      final List<dynamic> data = json.decode(jsonStr);
      if (mounted) {
        setState(() => _scanData = data);
      }
    } catch (e) {
      debugPrint('Could not load scan data: $e');
    }
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _scannerController.dispose();
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.resumed) {
      _scannerController.start();
    } else if (state == AppLifecycleState.inactive) {
      _scannerController.stop();
    }
  }

  void _showErrorDialog(String message) {
    _scannerController.stop();
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        title: const Text('Invalid Barcode', style: TextStyle(color: Color(0xFFDC143C), fontWeight: FontWeight.bold)),
        content: Text(message),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.of(ctx).pop();
              if (mounted) {
                setState(() {
                  _isProcessing = false;
                  _pendingBarcode = null;
                });
                _scannerController.start();
              }
            },
            child: const Text('OK', style: TextStyle(color: Color(0xFFDC143C))),
          ),
        ],
      ),
    );
  }

{% if scan_type == 'engine' %}
  // ── Engine Code Scan Logic ────────────────────────────────────────────────

  bool _isKnownEngineCode(String candidate) {
    if (candidate.isEmpty || _scanData.isEmpty) return false;
    final upper = candidate.toUpperCase();
    return _scanData.any(
      (m) => (m['part_no'] as String? ?? '').toUpperCase() == upper,
    );
  }

  Future<void> _onDetect(BarcodeCapture capture) async {
    if (_isProcessing) return;
    final List<Barcode> barcodes = capture.barcodes;
    if (barcodes.isEmpty) return;
    final String? code = barcodes.first.rawValue;
    if (code == null || code.trim().isEmpty) return;
    final String raw = code.trim();

    if (_manualMode) {
      setState(() => _pendingBarcode = raw);
      return;
    }

    // Auto mode — inline validation exactly as in proven working branch
    final int spaceIdx = raw.indexOf(' ');
    if (spaceIdx == -1) {
      setState(() => _isProcessing = true);
      _showErrorDialog('Invalid engine barcode. Expected format: PART_NO SERIAL_NO');
      return;
    }

    setState(() => _isProcessing = true);

    final String partNo = raw.substring(0, spaceIdx).trim();
    final String engineSerial = raw.substring(spaceIdx + 1).trim();

    if (!_isKnownEngineCode(partNo)) {
      _showErrorDialog('Engine code not found. Please add it and rebuild the app.');
      return;
    }

    if (!mounted) return;
    _scannerController.stop();
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => HomeScreen(
          vin: engineSerial,
          modelCode: partNo,
          cameras: [],
        ),
      ),
    ).then((_) async {
      if (mounted) {
        await _scannerController.stop();
        await _scannerController.start();
        setState(() {
          _isProcessing = false;
          _pendingBarcode = null;
        });
      }
    });
  }

  void _processScan() {
    final raw = _pendingBarcode;
    if (raw == null || _isProcessing) return;

    final int spaceIdx = raw.indexOf(' ');
    if (spaceIdx == -1) {
      setState(() => _isProcessing = true);
      _showErrorDialog('Invalid engine barcode. Expected format: PART_NO SERIAL_NO');
      return;
    }

    setState(() => _isProcessing = true);

    final String partNo = raw.substring(0, spaceIdx).trim();
    final String engineSerial = raw.substring(spaceIdx + 1).trim();

    if (!_isKnownEngineCode(partNo)) {
      _showErrorDialog('Engine code not found. Please add it and rebuild the app.');
      return;
    }

    if (!mounted) return;
    _scannerController.stop();
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => HomeScreen(
          vin: engineSerial,
          modelCode: partNo,
          cameras: [],
        ),
      ),
    ).then((_) async {
      if (mounted) {
        await _scannerController.stop();
        await _scannerController.start();
        setState(() {
          _isProcessing = false;
          _pendingBarcode = null;
        });
      }
    });
  }

{% else %}
  // ── Model Code Scan Logic ─────────────────────────────────────────────────

  bool _isKnownModelCode(String candidate) {
    if (candidate.isEmpty || _scanData.isEmpty) return false;
    final upper = candidate.toUpperCase();
    return _scanData.any(
      (m) => (m['model_code'] as String? ?? '').toUpperCase() == upper,
    );
  }

  String _resolveModelCode(String suffix) {
    for (final strip in [2, 1, 0]) {
      if (suffix.length > strip) {
        final candidate = suffix.substring(0, suffix.length - strip);
        if (_isKnownModelCode(candidate)) {
          return candidate;
        }
      }
    }
    if (suffix.length > 2) return suffix.substring(0, suffix.length - 2);
    return suffix;
  }

  Future<void> _onDetect(BarcodeCapture capture) async {
    if (_isProcessing) return;
    final List<Barcode> barcodes = capture.barcodes;
    if (barcodes.isEmpty) return;
    final String? code = barcodes.first.rawValue;
    if (code == null || code.trim().isEmpty) return;
    final String raw = code.trim();

    if (_manualMode) {
      setState(() => _pendingBarcode = raw);
      return;
    }

    // Auto mode — inline validation exactly as in proven working branch
    if (raw.length < 30 || raw.length > 35) {
      setState(() => _isProcessing = true);
      _showErrorDialog('Please scan the right VIN model code.');
      return;
    }

    setState(() => _isProcessing = true);

    final String vin = raw.substring(0, 17);
    final String suffix = raw.substring(17);
    final String extractedModelCode = _resolveModelCode(suffix);

    if (!_isKnownModelCode(extractedModelCode)) {
      _showErrorDialog('Model code is not present, please add code and rebuild app.');
      return;
    }

    if (!mounted) return;
    _scannerController.stop();
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => HomeScreen(
          vin: vin,
          modelCode: extractedModelCode,
          cameras: [],
        ),
      ),
    ).then((_) async {
      if (mounted) {
        await _scannerController.stop();
        await _scannerController.start();
        setState(() {
          _isProcessing = false;
          _pendingBarcode = null;
        });
      }
    });
  }

  void _processScan() {
    final raw = _pendingBarcode;
    if (raw == null || _isProcessing) return;

    if (raw.length < 30 || raw.length > 35) {
      setState(() => _isProcessing = true);
      _showErrorDialog('Please scan the right VIN model code.');
      return;
    }

    setState(() => _isProcessing = true);

    final String vin = raw.substring(0, 17);
    final String suffix = raw.substring(17);
    final String extractedModelCode = _resolveModelCode(suffix);

    if (!_isKnownModelCode(extractedModelCode)) {
      _showErrorDialog('Model code is not present, please add code and rebuild app.');
      return;
    }

    if (!mounted) return;
    _scannerController.stop();
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => HomeScreen(
          vin: vin,
          modelCode: extractedModelCode,
          cameras: [],
        ),
      ),
    ).then((_) async {
      if (mounted) {
        await _scannerController.stop();
        await _scannerController.start();
        setState(() {
          _isProcessing = false;
          _pendingBarcode = null;
        });
      }
    });
  }

{% endif %}

  @override
  Widget build(BuildContext context) {
    final bool barcodeReady = _pendingBarcode != null && !_isProcessing;
    final Color frameColor = (_manualMode && barcodeReady)
        ? Colors.green
        : const Color(0xFFDC143C);

    return Scaffold(
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [Colors.white, Color(0xFFFFF5F5)],
          ),
        ),
        child: Column(
          children: [
            Container(
              width: double.infinity,
              padding: const EdgeInsets.symmetric(vertical: 16, horizontal: 16),
              decoration: const BoxDecoration(color: Color(0xFFDC143C)),
              child: SafeArea(
                bottom: false,
                child: Row(
                  children: [
                    const Expanded(
                      child: Text(
                        'SCAN BARCODE',
                        textAlign: TextAlign.center,
                        style: TextStyle(
                          color: Colors.white,
                          fontSize: 20,
                          fontWeight: FontWeight.bold,
                          letterSpacing: 1.5,
                        ),
                      ),
                    ),
                    GestureDetector(
                      onTap: () => Navigator.push(context, MaterialPageRoute(builder: (_) => const HistoryScreen())),
                      child: const Icon(Icons.history, color: Colors.white, size: 26),
                    ),
                  ],
                ),
              ),
            ),
            // Mode toggle row
            Container(
              color: Colors.white,
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(
                    _manualMode ? 'Manual Scan' : 'Auto Scan',
                    style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 14),
                  ),
                  Row(
                    children: [
                      Text(
                        'Auto',
                        style: TextStyle(
                          fontSize: 13,
                          color: !_manualMode ? const Color(0xFFDC143C) : Colors.grey,
                          fontWeight: !_manualMode ? FontWeight.bold : FontWeight.normal,
                        ),
                      ),
                      Switch(
                        value: _manualMode,
                        onChanged: (val) async {
                          setState(() {
                            _manualMode = val;
                            _pendingBarcode = null;
                          });
                          // Restart scanner to reset noDuplicates dedup state
                          await _scannerController.stop();
                          await _scannerController.start();
                        },
                        activeColor: const Color(0xFFDC143C),
                      ),
                      Text(
                        'Manual',
                        style: TextStyle(
                          fontSize: 13,
                          color: _manualMode ? const Color(0xFFDC143C) : Colors.grey,
                          fontWeight: _manualMode ? FontWeight.bold : FontWeight.normal,
                        ),
                      ),
                    ],
                  ),
                ],
              ),
            ),
            Expanded(
              child: Stack(
                children: [
                  MobileScanner(
                    controller: _scannerController,
                    onDetect: _onDetect,
                  ),
                  Center(
                    child: Column(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        AnimatedContainer(
                          duration: const Duration(milliseconds: 300),
                          width: 250,
                          height: 250,
                          decoration: BoxDecoration(
                            border: Border.all(color: frameColor, width: 2),
                          ),
                          child: Stack(
                            children: [
                              _bracket(top: 0, left: 0, isTop: true, isLeft: true, color: frameColor),
                              _bracket(top: 0, right: 0, isTop: true, isLeft: false, color: frameColor),
                              _bracket(bottom: 0, left: 0, isTop: false, isLeft: true, color: frameColor),
                              _bracket(bottom: 0, right: 0, isTop: false, isLeft: false, color: frameColor),
                            ],
                          ),
                        ),
                        const SizedBox(height: 12),
                        if (_manualMode)
                          AnimatedSwitcher(
                            duration: const Duration(milliseconds: 250),
                            child: barcodeReady
                                ? Container(
                                    key: const ValueKey('detected'),
                                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                                    decoration: BoxDecoration(
                                      color: Colors.green.withOpacity(0.85),
                                      borderRadius: BorderRadius.circular(6),
                                    ),
                                    child: const Text(
                                      'Barcode detected — tap SCAN to confirm',
                                      style: TextStyle(color: Colors.white, fontWeight: FontWeight.w600, fontSize: 13),
                                    ),
                                  )
                                : Container(
                                    key: const ValueKey('waiting'),
                                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                                    decoration: BoxDecoration(
                                      color: Colors.black54,
                                      borderRadius: BorderRadius.circular(6),
                                    ),
                                    child: const Text(
                                      'Aim at barcode to detect',
                                      style: TextStyle(color: Colors.white70, fontSize: 13),
                                    ),
                                  ),
                          )
                        else
                          Container(
                            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                            decoration: BoxDecoration(
                              color: Colors.black54,
                              borderRadius: BorderRadius.circular(6),
                            ),
                            child: const Text(
                              'Point camera at barcode',
                              style: TextStyle(color: Colors.white70, fontSize: 13),
                            ),
                          ),
                      ],
                    ),
                  ),
                  if (_isProcessing)
                    Container(
                      color: Colors.black.withOpacity(0.5),
                      child: const Center(
                        child: CircularProgressIndicator(color: Color(0xFFDC143C)),
                      ),
                    ),
                ],
              ),
            ),
            if (_manualMode)
              Padding(
                padding: const EdgeInsets.fromLTRB(24, 12, 24, 24),
                child: SizedBox(
                  width: double.infinity,
                  child: ElevatedButton(
                    onPressed: barcodeReady ? _processScan : null,
                    style: ElevatedButton.styleFrom(
                      backgroundColor: barcodeReady ? const Color(0xFFDC143C) : Colors.grey.shade400,
                      foregroundColor: Colors.white,
                      disabledBackgroundColor: Colors.grey.shade400,
                      disabledForegroundColor: Colors.white70,
                      padding: const EdgeInsets.symmetric(vertical: 16),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                    ),
                    child: const Text('SCAN', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16, letterSpacing: 1.2)),
                  ),
                ),
              )
            else
              const SizedBox(height: 24),
          ],
        ),
      ),
    );
  }

  Widget _bracket({double? top, double? bottom, double? left, double? right, required bool isTop, required bool isLeft, required Color color}) {
    return Positioned(
      top: top,
      bottom: bottom,
      left: left,
      right: right,
      child: Container(
        width: 30,
        height: 30,
        decoration: BoxDecoration(
          border: Border(
            top: isTop ? BorderSide(color: color, width: 3) : BorderSide.none,
            bottom: !isTop ? BorderSide(color: color, width: 3) : BorderSide.none,
            left: isLeft ? BorderSide(color: color, width: 3) : BorderSide.none,
            right: !isLeft ? BorderSide(color: color, width: 3) : BorderSide.none,
          ),
        ),
      ),
    );
  }
}
