// This template is normally rendered once as "ScanScreen". A "combined"
// app (VIN scan + Chakan/engine scan + OCR all in one app) renders it
// TWICE with different (scan_screen_class_name, scan_type) overrides --
// once per barcode format -- since scan_type/is_ocr_app drive Jinja
// conditionals that decide which code exists at all, not a runtime value;
// two differently-named classes is how both formats coexist in one app
// without changing a single line of behavior for existing single-format
// apps (scan_screen_class_name defaults to plain "ScanScreen" for them,
// identical output to before this existed).
class {{ SC }} extends StatefulWidget {
  final String modelCode;
  // Only used by the OCR engine-code-truth flow, to hand real cameras on to
  // OcrScanScreen after a successful barcode scan -- the VIN/model-code
  // flow doesn't need this (it navigates to HomeScreen with cameras: []
  // today, unrelated to this change).
  final List<CameraDescription> cameras;
  const {{ SC }}({super.key, required this.modelCode, this.cameras = const []});

  @override
  State<{{ SC }}> createState() => _{{ SC }}State();
}

class _{{ SC }}State extends State<{{ SC }}> with WidgetsBindingObserver {
  bool _isProcessing = false;
  List<dynamic> _scanData = [];
  String? _pendingBarcode;
  bool _manualMode = false;
  int _unsyncedCount = 0;

  // Whether the user wants the flash to stay on -- once turned on it stays
  // on across scans/mode switches (each of which briefly stops+starts the
  // camera), instead of silently resetting off like a single-shot toggle.
  bool _torchWanted = false;

  // "Always on" mode, set via double-tap on the flash button. Unlike a
  // single tap it survives scans, mode switches and a trip through another
  // screen (e.g. Sync), staying on until the user explicitly turns it off
  // (single tap, or double tap again) or leaves the app -- it is
  // deliberately session-only (not persisted to disk), so it does NOT come
  // back on its own the next time the app is opened.
  bool _torchAlwaysOn = false;

  final MobileScannerController _scannerController = MobileScannerController(
    detectionSpeed: DetectionSpeed.noDuplicates,
    facing: CameraFacing.back,
  );

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _loadScanData();
    _refreshUnsyncedBadge();
  }

  Future<void> _refreshUnsyncedBadge() async {
    final count = await SyncService.instance.getUnsyncedCount();
    if (mounted) setState(() => _unsyncedCount = count);
  }

  /// Single tap: plain on/off for this session only. Turning it off this
  /// way also cancels "always on" mode if it was active -- an explicit
  /// tap-to-turn-off should stick.
  Future<void> _toggleTorch() async {
    await _scannerController.toggleTorch();
    final isOn = _scannerController.torchState.value == TorchState.on;
    _torchWanted = isOn;
    if (!isOn && _torchAlwaysOn) {
      _torchAlwaysOn = false;
    }
    if (mounted) setState(() {});
  }

  /// Double tap: toggles "always on" mode -- stays on until explicitly
  /// turned off (single tap, or double tap again) or the app is exited.
  Future<void> _toggleTorchAlwaysOn() async {
    _torchAlwaysOn = !_torchAlwaysOn;
    _torchWanted = _torchAlwaysOn;

    final isOn = _scannerController.torchState.value == TorchState.on;
    if (_torchAlwaysOn && !isOn) {
      await _scannerController.toggleTorch();
    } else if (!_torchAlwaysOn && isOn) {
      await _scannerController.toggleTorch();
    }
    if (mounted) setState(() {});
  }

  /// Re-applies torch-on after a (re)start of the camera session if the user
  /// wants it on. A fresh camera session always starts with the torch
  /// physically off, but the controller's torchState listenable can briefly
  /// keep reporting the pre-restart value -- checking it immediately after
  /// start() can therefore wrongly conclude the torch is "already on" and
  /// skip re-enabling it, leaving the light off while the UI still thinks
  /// "always on" is active. The short delay lets that state settle first.
  Future<void> _reapplyTorchIfWanted() async {
    if (!_torchWanted) return;
    await Future.delayed(const Duration(milliseconds: 200));
    if (mounted && _torchWanted && _scannerController.torchState.value != TorchState.on) {
      await _scannerController.toggleTorch();
    }
  }

  /// Stops and restarts the camera session (used whenever we need to reset
  /// scanner state, e.g. switching Auto/Manual mode, or handing the camera
  /// back after another screen used it) while keeping the flash on if the
  /// user had turned it on -- start() can otherwise silently drop torch.
  Future<void> _restartScanner() async {
    try {
      await _scannerController.stop();
    } catch (_) {}

    // Give the OS camera HAL a moment to actually release the hardware --
    // stop() can resolve before the native camera device is fully closed
    // (especially right after another screen, e.g. the PC-pairing QR
    // scanner, had its own controller on it), and starting again too soon
    // throws or leaves a black/frozen preview that never recovers on its
    // own, forcing a full app restart to get VIN scanning back.
    await Future.delayed(const Duration(milliseconds: 300));
    if (!mounted) return;

    try {
      await _scannerController.start();
    } catch (e) {
      debugPrint('Scanner restart failed, retrying: $e');
      await Future.delayed(const Duration(milliseconds: 600));
      if (!mounted) return;
      try {
        await _scannerController.start();
      } catch (e2) {
        debugPrint('Scanner restart retry failed: $e2');
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text('Camera failed to restart. Tap here or reopen the app if scanning stays dead.'),
              backgroundColor: Colors.orange,
              duration: Duration(seconds: 4),
            ),
          );
        }
        return;
      }
    }
    await _reapplyTorchIfWanted();
  }

  Future<void> _loadScanData() async {
    try {
{% if scan_type == 'engine' %}
      final String jsonStr = await rootBundle.loadString('assets/engine_data.json');
{% else %}
      final String jsonStr = await rootBundle.loadString('assets/master_data.json');
{% endif %}
      final List<dynamic> data = json.decode(jsonStr);
      if (mounted) {
        setState(() => _scanData = data);
      }
    } catch (e) {
      debugPrint('Could not load scan data: $e');
    }
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _scannerController.dispose();
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.resumed) {
      setState(() => _pendingBarcode = null);
      _scannerController.start().then((_) => _reapplyTorchIfWanted());
    } else if (state == AppLifecycleState.inactive) {
      _scannerController.stop();
    } else if (state == AppLifecycleState.paused || state == AppLifecycleState.detached) {
      // The user has actually left the app (home button, app switcher, task
      // kill) rather than a brief interruption -- "always on" torch should
      // not silently resume the next time the app is opened, so cancel it
      // here rather than leaving it to reassert itself on resume.
      _torchAlwaysOn = false;
      _torchWanted = false;
    }
  }

  void _showErrorDialog(String message) {
    _scannerController.stop();
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        title: const Text('Invalid Barcode', style: TextStyle(color: Color(0xFFDC143C), fontWeight: FontWeight.bold)),
        content: Text(message),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.of(ctx).pop();
              if (mounted) {
                setState(() {
                  _isProcessing = false;
                  _pendingBarcode = null;
                });
                _restartScanner();
              }
            },
            child: const Text('OK', style: TextStyle(color: Color(0xFFDC143C))),
          ),
        ],
      ),
    );
  }

{% if scan_type != 'engine' %}
  // ── Model Code Lookup (shared by VIN and Chakan Plant scans) ───────────────

  bool _isKnownModelCode(String candidate) {
    if (candidate.isEmpty || _scanData.isEmpty) return false;
    final upper = candidate.toUpperCase();
    return _scanData.any(
      (m) => (m['model_code'] as String? ?? '').toUpperCase() == upper,
    );
  }

  String _resolveModelCode(String suffix) {
    for (final strip in [2, 1, 0]) {
      if (suffix.length > strip) {
        final candidate = suffix.substring(0, suffix.length - strip);
        if (_isKnownModelCode(candidate)) {
          return candidate;
        }
      }
    }
    if (suffix.length > 2) return suffix.substring(0, suffix.length - 2);
    return suffix;
  }
{% endif %}

{% if scan_type == 'engine' %}
  // ── Engine Code Scan Logic ────────────────────────────────────────────────

  bool _isKnownEngineCode(String candidate) {
    if (candidate.isEmpty || _scanData.isEmpty) return false;
    final upper = candidate.toUpperCase();
    return _scanData.any(
      (m) => (m['part_no'] as String? ?? '').toUpperCase() == upper,
    );
  }

  Future<void> _onDetect(BarcodeCapture capture) async {
    if (_isProcessing) return;
    final List<Barcode> barcodes = capture.barcodes;
    if (barcodes.isEmpty) return;
    final String? code = barcodes.first.rawValue;
    if (code == null || code.trim().isEmpty) return;
    final String raw = code.trim();

    if (_manualMode) {
      setState(() => _pendingBarcode = raw);
      return;
    }

    // Auto mode
    final int spaceIdx = raw.indexOf(' ');
    String partNo;
    String engineSerial;
    if (spaceIdx != -1) {
      partNo = raw.substring(0, spaceIdx).trim();
      engineSerial = raw.substring(spaceIdx + 1).trim();
      setState(() => _isProcessing = true);
{% if not skip_masterdata_validation %}
      if (!_isKnownEngineCode(partNo)) {
        _showErrorDialog('Engine code not found. Please add it and rebuild the app.');
        return;
      }
{% endif %}
    } else {
{% if is_ocr_app and ocr_expected_length %}
      // Second sticker format: no separator -- the engine number is a
      // fixed-length prefix. There's no part number in this format, so
      // nothing to validate against engine_data.json; only the length
      // gets checked.
      if (raw.length < {{ ocr_expected_length }}) {
        setState(() => _isProcessing = true);
        _showErrorDialog('Invalid engine barcode. Expected "PART_NO SERIAL_NO", or a code at least {{ ocr_expected_length }} characters long.');
        return;
      }
      partNo = '';
      engineSerial = raw.substring(0, {{ ocr_expected_length }});
      setState(() => _isProcessing = true);
{% else %}
      setState(() => _isProcessing = true);
      _showErrorDialog('Invalid engine barcode. Expected format: PART_NO SERIAL_NO');
      return;
{% endif %}
    }

    if (!mounted) return;
    // stop() can resolve before the camera HAL actually releases the
    // hardware -- without a head start here, the next screen's own
    // CameraController can start binding while this scanner's camera
    // session is still tearing down, and CameraX throws "No supported
    // surface combination is found for camera device" from two camera
    // clients contending for the same device at once. Same race (and same
    // fix) as the Sync/Pair-PC navigation elsewhere in this file.
    await _scannerController.stop();
    await Future.delayed(const Duration(milliseconds: 300));
    if (!mounted) return;
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => {% if is_ocr_app %}OcrScanScreen(cameras: widget.cameras, truthValue: engineSerial){% else %}HomeScreen(
          vin: engineSerial,
          modelCode: {% if skip_masterdata_validation %}''{% else %}partNo{% endif %},
          cameras: [],
        ){% endif %},
      ),
    ).then((_) async {
      if (mounted) {
        await _restartScanner();
        setState(() {
          _isProcessing = false;
          _pendingBarcode = null;
        });
        _refreshUnsyncedBadge();
      }
    });
  }

