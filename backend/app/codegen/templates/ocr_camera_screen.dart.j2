import 'dart:io';
import 'package:camera/camera.dart';
import 'package:flutter/material.dart';
import 'package:image/image.dart' as img;
import 'package:path_provider/path_provider.dart';
import '../ml/crnn_reader.dart';
import '../ml/detector.dart';
import '../widgets/camera_view.dart';
import '../widgets/capture_button.dart';

/// Sole screen of this app: camera -> YOLO plate/region detect -> CRNN read
/// -> editable result -> Save (for later review) or Retry. No VIN decoding,
/// no barcode scanning, no history/sync — this build exists only to read
/// whatever alphanumeric string the model sees inside the detected region.
class OcrCameraScreen extends StatefulWidget {
  final List<CameraDescription> cameras;

  const OcrCameraScreen({super.key, required this.cameras});

  @override
  State<OcrCameraScreen> createState() => _OcrCameraScreenState();
}

class _OcrCameraScreenState extends State<OcrCameraScreen> {
  final _cameraKey = GlobalKey<CameraViewState>();
  final _detector = ModelManager();
  final _reader = CrnnReader();
  final _textController = TextEditingController();

  // Which detector class marks the region to OCR (e.g. "plate"). Empty
  // means unconfigured — fall back to the highest-confidence detection of
  // any class rather than reading nothing.
  static const String _targetClass = '{{ detector_target_class }}';

  bool _modelsReady = false;
  bool _busy = false;
  img.Image? _capturedImage;
  String? _statusMessage;

  @override
  void initState() {
    super.initState();
    _loadModels();
  }

  Future<void> _loadModels() async {
    await _detector.loadModel(
      'assets/models/{{ detector_tflite_path }}',
      'assets/models/{{ detector_labels_path }}',
    );
    await _reader.loadModel('assets/models/{{ recognizer_tflite_path }}');
    if (mounted) setState(() => _modelsReady = true);
  }

  @override
  void dispose() {
    _detector.dispose();
    _reader.dispose();
    _textController.dispose();
    super.dispose();
  }

  Future<void> _capture() async {
    if (_busy || !_modelsReady) return;
    setState(() {
      _busy = true;
      _statusMessage = null;
      _capturedImage = null;
    });

    final bytes = await _cameraKey.currentState?.takePicture();
    if (bytes == null) {
      setState(() {
        _busy = false;
        _statusMessage = 'Could not capture image, try again.';
      });
      return;
    }

    img.Image? decoded = img.decodeImage(bytes);
    if (decoded == null) {
      setState(() {
        _busy = false;
        _statusMessage = 'Could not decode image, try again.';
      });
      return;
    }
    decoded = img.bakeOrientation(decoded);

    final allDetections = await _detector.predictImage(decoded);
    final detections = _targetClass.isEmpty
        ? allDetections
        : allDetections.where((d) => d.className == _targetClass).toList();

    if (detections.isEmpty) {
      setState(() {
        _busy = false;
        _capturedImage = decoded;
        _statusMessage = _targetClass.isEmpty
            ? 'No plate/region detected. Adjust framing and retry.'
            : "No '$_targetClass' detected. Adjust framing and retry.";
      });
      return;
    }

    detections.sort((a, b) => b.confidence.compareTo(a.confidence));
    final best = detections.first;
    final text = await _reader.readBbox(decoded, best.bbox);

    setState(() {
      _busy = false;
      _capturedImage = decoded;
      _textController.text = text;
      _statusMessage = text.isEmpty ? 'No characters read. Edit or save for review.' : null;
    });
  }

  void _retry() {
    setState(() {
      _capturedImage = null;
      _statusMessage = null;
      _textController.clear();
    });
  }

  Future<void> _saveForReview() async {
    final image = _capturedImage;
    if (image == null) return;

    final dir = await getApplicationDocumentsDirectory();
    final saveDir = Directory('${dir.path}/ocr_saves');
    await saveDir.create(recursive: true);

    final ts = DateTime.now().millisecondsSinceEpoch;
    final imageFile = File('${saveDir.path}/$ts.jpg');
    await imageFile.writeAsBytes(img.encodeJpg(image, quality: 90));
    final textFile = File('${saveDir.path}/$ts.txt');
    await textFile.writeAsString(_textController.text);

    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('Saved for later review.')),
    );
    _retry();
  }

  @override
  Widget build(BuildContext context) {
    final hasResult = _capturedImage != null;

    return Scaffold(
      appBar: AppBar(title: const Text('{{ app_name }}')),
      body: Column(
        children: [
          Expanded(
            child: hasResult
                ? Image.memory(img.encodeJpg(_capturedImage!), fit: BoxFit.contain)
                : CameraView(cameras: widget.cameras, key: _cameraKey),
          ),
          if (_statusMessage != null)
            Padding(
              padding: const EdgeInsets.all(12),
              child: Text(_statusMessage!, style: const TextStyle(color: Colors.red)),
            ),
          if (hasResult)
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16),
              child: TextField(
                controller: _textController,
                textAlign: TextAlign.center,
                style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold, letterSpacing: 2),
                decoration: const InputDecoration(labelText: 'Recognized text (editable)'),
              ),
            ),
          if (!_modelsReady)
            const Padding(
              padding: EdgeInsets.all(16),
              child: CircularProgressIndicator(),
            )
          else if (!hasResult)
            CaptureButton(label: 'Capture', onPressed: _busy ? null : _capture)
          else
            Padding(
              padding: const EdgeInsets.all(16),
              child: Row(
                children: [
                  Expanded(
                    child: OutlinedButton(
                      onPressed: _retry,
                      child: const Text('Retry'),
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: ElevatedButton(
                      onPressed: _saveForReview,
                      child: const Text('Save for review'),
                    ),
                  ),
                ],
              ),
            ),
        ],
      ),
    );
  }
}
