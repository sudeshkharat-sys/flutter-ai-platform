class HomeScreen extends StatefulWidget {
  final List<CameraDescription> cameras;
  final String? vin;
  final String? modelCode;
  const HomeScreen({super.key, required this.cameras, this.vin, this.modelCode});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  List<dynamic> _tasks = [];
  Map<int, dynamic> _taskResults = {}; // Index -> DetectionResult
  bool _loading = true;

  // True from the moment Submit is tapped (and past the incomplete/confirm
  // dialogs) until this screen pops. Grays out the Submit button and shows
  // a spinner in it instead of leaving it tappable while the DB write and
  // printer handoff run, so a slow printer connection reads as "working",
  // not "frozen" -- and a second tap can't fire a duplicate submission.
  bool _submitting = false;

  /// "NOT OK" means a wrong/defect part was actually detected; "NOT FOUND"
  /// means the camera simply didn't detect anything for this task at all.
  /// Those are different problems for the inspector (retake angle vs. a
  /// real defect), so don't collapse both into "NOT OK".
  String _resultLabel(int index) {
    final result = _taskResults[index];
    if (result == null || result['success'] == true) return 'OK';
    final className = (result['className'] as String?)?.trim().toLowerCase();
    if (className == null || className.isEmpty || className == 'none') {
      return 'NOT FOUND';
    }
    return 'NOT OK';
  }

  void _showReferenceImage(BuildContext context, String assetPath) {
    showDialog(
      context: context,
      builder: (ctx) => Dialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
              decoration: const BoxDecoration(
                color: Color(0xFFDC143C),
                borderRadius: BorderRadius.only(topLeft: Radius.circular(16), topRight: Radius.circular(16)),
              ),
              child: Row(
                children: [
                  const Expanded(
                    child: Text('Reference Image', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 15)),
                  ),
                  IconButton(
                    icon: const Icon(Icons.close, color: Colors.white, size: 20),
                    padding: EdgeInsets.zero,
                    constraints: const BoxConstraints(),
                    onPressed: () => Navigator.pop(ctx),
                  ),
                ],
              ),
            ),
            ClipRRect(
              borderRadius: const BorderRadius.only(bottomLeft: Radius.circular(16), bottomRight: Radius.circular(16)),
