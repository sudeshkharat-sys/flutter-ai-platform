name: {{ app_name_slug }}
description: Digi OCR — {{ app_name }} — generated by Flutter AI Studio
version: 1.0.0+1
publish_to: 'none'

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  camera: ^0.11.0+2
  image: ^4.2.0
  permission_handler: ^11.3.1
  google_mlkit_text_recognition: ^0.13.0
  mobile_scanner: ^3.5.2
  tflite_flutter: '>=0.10.4 <2.0.0'

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0

flutter:
  uses-material-design: true
  # Drop your trained OCR Character Training model here:
  #   assets/ocr/ocr_model.tflite  (download from the OCR panel)
  #   assets/ocr/labels.txt        (download from the OCR panel)
  # The app falls back to plain ML Kit reading if these files are missing.
  assets:
    - assets/ocr/
