import 'package:shared_preferences/shared_preferences.dart';

/// Remembers whether the camera torch should stay on. The inspection screens
/// re-apply it every time the camera starts (each task, each scan, after the
/// app resumes), so the light is on for every detection without tapping it each
/// time. Toggling the torch button off clears it again.
class TorchPref {
  static const String _key = 'torch_always_on';

  static Future<bool> isOn() async {
    try {
      return (await SharedPreferences.getInstance()).getBool(_key) ?? false;
    } catch (_) {
      return false;
    }
  }

  static Future<void> set(bool on) async {
    try {
      await (await SharedPreferences.getInstance()).setBool(_key, on);
    } catch (_) {}
  }
}
