import 'dart:typed_data';
import 'dart:ui';
import 'package:flutter/foundation.dart';
import 'package:image/image.dart' as img;
import 'package:tflite_flutter/tflite_flutter.dart';

/// Reads a cropped alphanumeric region (plate/engraving crop from the YOLO
/// detector) with the CRNN+CTC line-recognition model exported by
/// ai-vision-platform's crnn_training.py. Charset, geometry and the
/// CLAHE+Otsu preprocessing below must match that training script's
/// `_normalize_line` exactly — the tflite graph only contains the CNN, so
/// this preprocessing has to be reproduced identically on-device or the
/// model sees a different input distribution than it was trained on.
class CrnnReader {
  static const int imgH = 32;
  static const int imgW = 256;
  static const String _charset = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  static const int _blankIndex = 36; // CTC blank is the LAST class (37 total)

  Interpreter? _interpreter;
  bool get isLoaded => _interpreter != null;

  Future<void> loadModel(String modelPath) async {
    _interpreter?.close();
    try {
      _interpreter = await Interpreter.fromAsset(modelPath);
    } catch (e) {
      debugPrint('[CrnnReader] Error loading model: $e');
      _interpreter = null;
    }
  }

  void dispose() {
    _interpreter?.close();
    _interpreter = null;
  }

  /// CLAHE (contrast-limited adaptive histogram equalization), matching
  /// cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8)).apply(gray) — builds
  /// a per-tile histogram-equalization mapping, clips it, and bilinearly
  /// blends between the 4 nearest tile mappings per pixel.
  static List<int> _clahe(List<int> gray, int w, int h,
      {int tilesX = 8, int tilesY = 8, double clipLimit = 3.0}) {
    final tileW = (w / tilesX).ceil();
    final tileH = (h / tilesY).ceil();

    // Per-tile 256-entry mapping (equalization curve).
    final mappings = List.generate(
      tilesY,
      (_) => List.generate(tilesX, (_) => List<int>.filled(256, 0)),
    );

    for (int ty = 0; ty < tilesY; ty++) {
      for (int tx = 0; tx < tilesX; tx++) {
        final x0 = tx * tileW;
        final y0 = ty * tileH;
        final x1 = (x0 + tileW).clamp(0, w);
        final y1 = (y0 + tileH).clamp(0, h);
        final area = (x1 - x0) * (y1 - y0);
        if (area <= 0) continue;

        final hist = List<int>.filled(256, 0);
        for (int y = y0; y < y1; y++) {
          for (int x = x0; x < x1; x++) {
            hist[gray[y * w + x]]++;
          }
        }

        final clip = (clipLimit * area / 256).round().clamp(1, area);
        int excess = 0;
        for (int i = 0; i < 256; i++) {
          if (hist[i] > clip) {
            excess += hist[i] - clip;
            hist[i] = clip;
          }
        }
        final redistribute = excess ~/ 256;
        for (int i = 0; i < 256; i++) {
          hist[i] += redistribute;
        }

        int cum = 0;
        final mapping = mappings[ty][tx];
        for (int i = 0; i < 256; i++) {
          cum += hist[i];
          mapping[i] = ((cum / area) * 255).round().clamp(0, 255);
        }
      }
    }

    final out = List<int>.filled(w * h, 0);
    for (int y = 0; y < h; y++) {
      // Fractional tile-space y-position, clamped so edge pixels don't
      // extrapolate past the outermost tile centers.
      final fy = ((y - tileH / 2) / tileH).clamp(0.0, (tilesY - 1).toDouble());
      final ty0 = fy.floor().clamp(0, tilesY - 1);
      final ty1 = (ty0 + 1).clamp(0, tilesY - 1);
      final wy = fy - ty0;

      for (int x = 0; x < w; x++) {
        final fx = ((x - tileW / 2) / tileW).clamp(0.0, (tilesX - 1).toDouble());
        final tx0 = fx.floor().clamp(0, tilesX - 1);
        final tx1 = (tx0 + 1).clamp(0, tilesX - 1);
        final wx = fx - tx0;

        final v = gray[y * w + x];
        final m00 = mappings[ty0][tx0][v];
        final m01 = mappings[ty0][tx1][v];
        final m10 = mappings[ty1][tx0][v];
        final m11 = mappings[ty1][tx1][v];
        final top = m00 * (1 - wx) + m01 * wx;
        final bottom = m10 * (1 - wx) + m11 * wx;
        out[y * w + x] = (top * (1 - wy) + bottom * wy).round().clamp(0, 255);
      }
    }
    return out;
  }

  /// Otsu's method: the threshold that maximizes between-class variance of
  /// the 256-bin histogram. Matches cv2.threshold(..., cv2.THRESH_OTSU).
  static int _otsuThreshold(List<int> gray) {
    final hist = List<int>.filled(256, 0);
    for (final v in gray) {
      hist[v]++;
    }
    final total = gray.length;
    double sum = 0;
    for (int i = 0; i < 256; i++) {
      sum += i * hist[i];
    }

    double sumB = 0;
    int wB = 0;
    double maxVar = -1;
    int threshold = 127;
    for (int t = 0; t < 256; t++) {
      wB += hist[t];
      if (wB == 0) continue;
      final wF = total - wB;
      if (wF == 0) break;
      sumB += t * hist[t];
      final mB = sumB / wB;
      final mF = (sum - sumB) / wF;
      final between = wB * wF * (mB - mF) * (mB - mF);
      if (between > maxVar) {
        maxVar = between;
        threshold = t;
      }
    }
    return threshold;
  }

  /// Grayscale + CLAHE + Otsu-polarity-normalize + tighten-to-content +
  /// aspect-preserving resize + letterbox into a fixed imgH x imgW canvas
  /// (dark text on light background) — the same pipeline
  /// crnn_training.py's `_normalize_line` builds training data with.
  ///
  /// The tighten-to-content step has no Python equivalent: training lines
  /// are cropped from the tight union of labeled character boxes (zero
  /// margin), but a production YOLO "plate" detection is a much looser box
  /// with background/metal margin around the text. Without trimming to the
  /// actual dark-pixel content first, the resize-to-height-32 step shrinks
  /// the characters far more than the model ever saw in training.
  static img.Image _normalizeLine(img.Image src) {
    final grayImg = img.grayscale(src);
    final w = grayImg.width, h = grayImg.height;
    var gray = List<int>.generate(w * h, (i) => grayImg.getPixel(i % w, i ~/ w).r.toInt());

    gray = _clahe(gray, w, h, tilesX: 8, tilesY: 8, clipLimit: 3.0);

    // Otsu-based polarity: if the majority of pixels are above threshold
    // (bright), strokes are already the dark minority -> leave as-is;
    // otherwise invert so strokes end up dark-on-light.
    final thr = _otsuThreshold(gray);
    int brightCount = 0;
    for (final v in gray) {
      if (v > thr) brightCount++;
    }
    if (brightCount <= gray.length ~/ 2) {
      gray = gray.map((v) => 255 - v).toList();
    }

    // Tighten to the bounding box of foreground (dark) pixels using a fresh
    // Otsu threshold on the now-normalized polarity, with a couple pixels
    // of slack so stroke edges aren't clipped.
    final thr2 = _otsuThreshold(gray);
    int minX = w, minY = h, maxX = -1, maxY = -1;
    for (int y = 0; y < h; y++) {
      for (int x = 0; x < w; x++) {
        if (gray[y * w + x] < thr2) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    int cropX0 = 0, cropY0 = 0, cropW = w, cropH = h;
    if (maxX >= minX && maxY >= minY) {
      const pad = 2;
      cropX0 = (minX - pad).clamp(0, w - 1);
      cropY0 = (minY - pad).clamp(0, h - 1);
      final cropX1 = (maxX + pad).clamp(0, w - 1);
      final cropY1 = (maxY + pad).clamp(0, h - 1);
      cropW = cropX1 - cropX0 + 1;
      cropH = cropY1 - cropY0 + 1;
    }

    final normalizedImg = img.Image(width: w, height: h);
    for (int y = 0; y < h; y++) {
      for (int x = 0; x < w; x++) {
        final v = gray[y * w + x];
        normalizedImg.setPixelRgb(x, y, v, v, v);
      }
    }
    final tightened = (cropW > 0 && cropH > 0 && (cropW != w || cropH != h))
        ? img.copyCrop(normalizedImg, x: cropX0, y: cropY0, width: cropW, height: cropH)
        : normalizedImg;

    final double scale = imgH / tightened.height;
    final int newW = (tightened.width * scale).round().clamp(1, imgW);
    final resized = img.copyResize(
      tightened,
      width: newW,
      height: imgH,
      interpolation: img.Interpolation.average,
    );

    final canvas = img.Image(width: imgW, height: imgH);
    img.fill(canvas, color: img.ColorRgb8(255, 255, 255));
    img.compositeImage(canvas, resized, dstX: 0, dstY: 0);
    return canvas;
  }

  static Float32List _toFloat32(img.Image normalized) {
    final buffer = Float32List(imgH * imgW);
    int idx = 0;
    for (int y = 0; y < imgH; y++) {
      for (int x = 0; x < imgW; x++) {
        buffer[idx++] = normalized.getPixel(x, y).r.toDouble() / 255.0;
      }
    }
    return buffer;
  }

  /// Greedy CTC decode: argmax per timestep, collapse consecutive repeats,
  /// drop blanks.
  static String _greedyDecode(List<List<double>> probs) {
    final buf = StringBuffer();
    int prev = -1;
    for (final timestep in probs) {
      int best = 0;
      double bestScore = timestep[0];
      for (int c = 1; c < timestep.length; c++) {
        if (timestep[c] > bestScore) {
          bestScore = timestep[c];
          best = c;
        }
      }
      if (best != prev && best != _blankIndex) {
        buf.write(_charset[best]);
      }
      prev = best;
    }
    return buf.toString();
  }

  /// Crops [source] to the normalized [bbox] (left/top/width/height in 0..1
  /// coordinates, as produced by ModelManager's YOLO detector) and reads the
  /// alphanumeric string inside it.
  Future<String> readBbox(img.Image source, Rect bbox) async {
    final result = await readBboxDebug(source, bbox);
    return result.text;
  }

  /// Same as [readBbox] but also returns the intermediate images (the raw
  /// crop handed to preprocessing, and the final 32x256 tensor image handed
  /// to the model) so a debug UI can show exactly what the model saw —
  /// essential for telling apart "bad crop/orientation" from "bad
  /// preprocessing" from "model just doesn't generalize to this photo".
  Future<CrnnReadResult> readBboxDebug(img.Image source, Rect bbox) async {
    if (_interpreter == null) {
      return CrnnReadResult(text: '', cropped: source, normalized: source);
    }

    final int x = (bbox.left * source.width).round().clamp(0, source.width - 1);
    final int y = (bbox.top * source.height).round().clamp(0, source.height - 1);
    final int w = (bbox.width * source.width).round().clamp(1, source.width - x);
    final int h = (bbox.height * source.height).round().clamp(1, source.height - y);
    final cropped = img.copyCrop(source, x: x, y: y, width: w, height: h);

    final normalized = _normalizeLine(cropped);
    final input = _toFloat32(normalized).reshape([1, imgH, imgW, 1]);

    final outputShape = _interpreter!.getOutputTensor(0).shape; // [1, T, 37]
    final output = List.generate(
      outputShape[0],
      (_) => List.generate(
        outputShape[1],
        (_) => List.filled(outputShape[2], 0.0),
      ),
    );

    _interpreter!.run(input, output);
    final text = _greedyDecode(List<List<double>>.from(
      output[0].map((row) => List<double>.from(row)),
    ));
    return CrnnReadResult(text: text, cropped: cropped, normalized: normalized);
  }
}

/// Bundles the recognized text with the intermediate images for debugging.
class CrnnReadResult {
  final String text;
  final img.Image cropped;
  final img.Image normalized;

  const CrnnReadResult({
    required this.text,
    required this.cropped,
    required this.normalized,
  });
}
