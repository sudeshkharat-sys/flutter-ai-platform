    // can take long enough for a second tap to land while _isAnalyzing was
    // still false, re-entering this function and calling takePicture() a
    // second time on the same CameraController before the first capture
    // finished. That double-call is what caused "tap capture multiple times
    // -> app lags/freezes, no image captured".
    setState(() => _isAnalyzing = true);
    try {
      _addLog('--- Start Inference ---');
      final XFile image = await _cameraController!.takePicture();
      final bytes = await image.readAsBytes();

      Size? imageSize;
      img.Image? orientedImage;
      // Decode + orient + blur-score off the UI isolate -- see
      // _decodeAndCheckBlur's doc comment for why this used to be the main
      // source of capture lag. Only the small, lossless PNG round-trip
      // happens back here, so ModelManager()/box-drawing below still see
      // pixel-identical data to before.
      final blurCheck = await compute(_decodeAndCheckBlur, bytes);
      if (blurCheck.orientedPngBytes != null) {
        try {
          final oriented = img.decodePng(blurCheck.orientedPngBytes!);
          if (oriented != null) {
            orientedImage = oriented;
            imageSize = Size(oriented.width.toDouble(), oriented.height.toDouble());
          }
        } catch (_) {}
      }
      if (blurCheck.variance != null) {
        final blurVariance = blurCheck.variance!;
        _addLog("Blur variance: ${blurVariance.toStringAsFixed(1)}");
        if (blurVariance < 150.0 && mounted) {
          await showDialog(
            context: context,
            barrierDismissible: false,
            builder: (_) => AlertDialog(
              backgroundColor: const Color(0xFF1A1A24),
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(16)),
              title: const Row(children: [
                Icon(Icons.blur_on, color: Color(0xFFDC143C)),
                SizedBox(width: 8),
                Text('Image Not Clear',
                    style: TextStyle(color: Colors.white, fontSize: 18)),
              ]),
              content: const Text(
                'The photo appears blurry or out of focus.\nPlease hold the device steady and retake.',
                style: TextStyle(color: Colors.white70, height: 1.5),
              ),
              actions: [
                ElevatedButton.icon(
                  onPressed: () => Navigator.pop(context),
                  icon: const Icon(Icons.camera_alt,
                      color: Colors.white, size: 18),
                  label: const Text('Retake',
                      style: TextStyle(color: Colors.white)),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFFDC143C),
                    shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(8)),
                  ),
                ),
              ],
            ),
          );
          if (mounted) setState(() => _isAnalyzing = false);
          return;
        }
      }

      setState(() {
        _bestResult = null;
        _capturedImageBytes = bytes;
        _capturedImageSize = imageSize;
      });

      final currentTask = widget.tasks[_currentIndex];
      final List<String> targetClasses =
          List<String>.from(currentTask['classes'] ?? []);
      _addLog("Target: ${targetClasses.join(', ')}");

      final allDetections = orientedImage != null
          ? await ModelManager().predictImage(orientedImage, orientedPngBytes: blurCheck.orientedPngBytes)
          : await ModelManager().predictBytes(bytes);
      setState(() => _allDetections = allDetections);

      String? savedImagePath;
      String? savedBackupPath;
      try {
        // placeholder — path assigned below after filtered is computed
      } catch (e) {
        _addLog("Image save FAILED: $e");
        savedImagePath = null;
      }

      _addLog("Detections: ${allDetections.length}");
      for (final d in allDetections) {
        _addLog(
            "  ${d.className} ${(d.confidence * 100).toStringAsFixed(1)}%");
      }

      final filtered = allDetections
          .where((d) => targetClasses.any((tc) =>
              d.className.toLowerCase().trim() == tc.toLowerCase().trim()))
          .toList();
      _addLog("Matched target: ${filtered.length}");

      // Save image with bounding boxes after filtered is known
      try {
        // Request storage permission (photos for Android 13+, storage for older)
        PermissionStatus status = await Permission.photos.request();
        if (!status.isGranted) {
          status = await Permission.storage.request();
        }

        // Save to public Pictures folder — visible in Gallery and Files app
        // Directly use /storage/emulated/0/Pictures/ (public, always accessible)
        final baseDir = Directory('/storage/emulated/0/Pictures');
        if (!await baseDir.exists()) await baseDir.create(recursive: true);

        final safeVin = widget.vin.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final safeTask = (currentTask['name'] as String? ?? 'task')
            .replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final appName = '{{ app_name }}'.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final imgDir = Directory('${baseDir.path}/MAI/$appName/Inspections/$safeVin/$safeTask');
        await imgDir.create(recursive: true);

        // Determine result label
        final topDetection = filtered.isNotEmpty
            ? filtered.first
            : (allDetections.isNotEmpty ? allDetections.first : null);
        final resultLabel = topDetection != null
            ? topDetection.className.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_')
            : 'no_detection';
        final isPass = filtered.isNotEmpty;

        // Filename: {TaskName}_{label}_{OK|NOT_OK}_{YYYY-MM-DD_HH-mm-ss}.jpg
        final now = DateTime.now();
        final dateStr =
            '${now.year}-${now.month.toString().padLeft(2, '0')}-${now.day.toString().padLeft(2, '0')}';
        final timeStr =
            '${now.hour.toString().padLeft(2, '0')}-${now.minute.toString().padLeft(2, '0')}-${now.second.toString().padLeft(2, '0')}';
        final resultBadge = isPass ? 'OK' : 'NOT_OK';
        savedImagePath = '${imgDir.path}/${safeTask}_${resultLabel}_${resultBadge}_${dateStr}_$timeStr.jpg';

        // Decode, draw bounding boxes + labels, then compress and save
        final decoded = img.decodeImage(bytes);
        List<int> compressed;
        if (decoded != null) {
          final iw = decoded.width.toDouble();
          final ih = decoded.height.toDouble();

          for (final det in allDetections) {
            final isTarget = targetClasses.any(
              (tc) => det.className.toLowerCase().trim() == tc.toLowerCase().trim(),
            );
            // Green = expected target found, Red = unexpected/defect detection
            final boxColor = isTarget
                ? img.ColorRgb8(0, 200, 0)
                : img.ColorRgb8(220, 0, 0);

            final x1 = (det.bbox.left * iw).toInt().clamp(0, decoded.width - 1);
            final y1 = (det.bbox.top * ih).toInt().clamp(0, decoded.height - 1);
            final x2 = (det.bbox.right * iw).toInt().clamp(0, decoded.width - 1);
            final y2 = (det.bbox.bottom * ih).toInt().clamp(0, decoded.height - 1);

            for (int t = 0; t < 3; t++) {
              img.drawRect(decoded,
                  x1: x1 + t, y1: y1 + t, x2: x2 - t, y2: y2 - t,
                  color: boxColor);
            }

            final label =
                '${det.className} ${(det.confidence * 100).toStringAsFixed(0)}%';
            final labelY = (y1 - 20).clamp(0, decoded.height - 20);
            img.fillRect(decoded,
                x1: x1, y1: labelY, x2: x1 + label.length * 8 + 6, y2: labelY + 18,
                color: boxColor);
            img.drawString(decoded, label,
                font: img.arial14,
                x: x1 + 3,
                y: labelY + 2,
                color: img.ColorRgb8(255, 255, 255));
          }

          compressed = img.encodeJpg(decoded, quality: 40);
        } else {
          compressed = bytes;
        }
        await File(savedImagePath).writeAsBytes(compressed, flush: true);
        final savedLen = await File(savedImagePath).length();
        _addLog("Image saved (${savedLen}B): $savedImagePath");
        _addLog("Storage status: $status");

        // Save a heavily compressed backup to internal app storage so the
        // history screen can still show an image if the user deletes the
        // Pictures copy from the gallery.
        try {
          final appDir = await getApplicationSupportDirectory();
          final backupDir = Directory('${appDir.path}/inspection_backups/$safeVin/$safeTask');
          await backupDir.create(recursive: true);
          final backupFile = File('${backupDir.path}/${safeTask}_${resultLabel}_${resultBadge}_${dateStr}_$timeStr.jpg');
          if (decoded != null) {
            // Resize to max 480px wide and compress hard — thumbnail only
            final thumb = img.copyResize(decoded, width: 480);
            await backupFile.writeAsBytes(img.encodeJpg(thumb, quality: 15), flush: true);
          } else {
            await backupFile.writeAsBytes(compressed, flush: true);
          }
          savedBackupPath = backupFile.path;
          _addLog("Backup saved: $savedBackupPath");
        } catch (e) {
          _addLog("Backup save FAILED: $e");
        }
      } catch (e) {
        _addLog("Image save FAILED: $e");
        savedImagePath = null;
      }

      setState(() {
        if (filtered.isNotEmpty) {
          filtered.sort((a, b) => b.confidence.compareTo(a.confidence));
          _bestResult = filtered.first;
          final pass = _isPass(_bestResult!.className, targetClasses);
          _addLog("WINNER: ${_bestResult!.className} | pass=$pass");

          _results[_currentIndex] = {
            'className': _bestResult!.className,
            'success': pass,
            'imagePath': savedImagePath,
            'backupImagePath': savedBackupPath,
            'detectionsJson': jsonEncode([_bestResult!.toJson()]),
          };
        } else {
          // Keep only the single best non-target detection.
          // Taking more than 1 caused repeated rows of the same class
          // (e.g. "not ok 85%, not ok 72%, not ok 63%") which confused users.
          final nonTarget = List<DetectionResult>.from(allDetections)
            ..sort((a, b) => b.confidence.compareTo(a.confidence));
          _detectedNonTargetClasses = nonTarget.take(1).toList();
          final bestDetected = _detectedNonTargetClasses.isNotEmpty
              ? _detectedNonTargetClasses.first
              : null;
          _addLog("NON-TARGET: ${bestDetected?.className ?? 'nothing'}");

          _results[_currentIndex] = {
            'className': bestDetected?.className ?? 'None',
            'success': false,
            'imagePath': savedImagePath,
            'backupImagePath': savedBackupPath,
            'detectionsJson': bestDetected != null
                ? jsonEncode([bestDetected.toJson()])
                : jsonEncode([]),
          };
        }
        _isAnalyzing = false;
      });
    } catch (e) {
      _addLog("ERROR: $e");
      setState(() => _isAnalyzing = false);
      if (mounted) {
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('Capture failed: $e')));
      }
    }
  }

  Future<void> _toggleFlash() async {
    if (_cameraController == null || !_isCameraInitialized) return;
    final newOn = !_isFlashOn;
    try {
      await _cameraController!
          .setFlashMode(newOn ? FlashMode.torch : FlashMode.off);
      setState(() => _isFlashOn = newOn);
      _addLog(newOn ? 'Flash ON' : 'Flash OFF');
    } catch (e) {
      _addLog("Flash error: $e");
    }
  }

  void _retake() {
    _addLog('Retake');
    setState(() {
      _capturedImageBytes = null;
      _capturedImageSize = null;
      _bestResult = null;
      _isAnalyzing = false;
      _allDetections = [];
      _detectedNonTargetClasses = [];
    });
  }

  void _onSaveAndContinue() {
    _results[_currentIndex] ??= {
      'className': 'None',
      'success': false,
      'imagePath': null,
      'detectionsJson': jsonEncode([]),
    };

    if (_results.length == widget.tasks.length) {
      _addLog('All tasks done');
      Navigator.pop(context, _results);
      return;
    }

    final nextIdx = (_currentIndex + 1) % widget.tasks.length;
    _addLog("Moving to Task ${nextIdx + 1}");
    setState(() {
      _currentIndex = nextIdx;
      _capturedImageBytes = null;
      _bestResult = null;
      _detectedNonTargetClasses = [];
    });
    _loadCurrentModel();
  }

  @override
  Widget build(BuildContext context) {
    if (_error != null) {
      return Scaffold(body: Center(child: Text('Error: $_error')));
    }
    final currentTask = widget.tasks[_currentIndex];
    final List<String> taskClasses =
        List<String>.from(currentTask['classes'] ?? []);

    final bool badgeGreen =
        _bestResult != null && _isPass(_bestResult!.className, taskClasses);

    final DetectionResult? overlayResult = _bestResult ??
        (_detectedNonTargetClasses.isNotEmpty
            ? _detectedNonTargetClasses.first
            : null);

    return Scaffold(
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [Colors.white, Color(0xFFFFF5F5)],
          ),
        ),
        child: SafeArea(
          child: Column(
            children: [
              Container(
                width: double.infinity,
                padding:
                    const EdgeInsets.symmetric(vertical: 12, horizontal: 16),
                decoration: const BoxDecoration(color: Color(0xFFDC143C)),
                child: Row(
                  children: [
                    IconButton(
                      icon: const Icon(Icons.arrow_back, color: Colors.white),
                      onPressed: () => Navigator.pop(context, _results),
                    ),
                    Expanded(
                      child: Center(
                        child: Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Text(
                              'TASK ${_currentIndex + 1} OF ${widget.tasks.length}',
                              style: const TextStyle(
                                  color: Colors.white,
                                  fontSize: 14,
                                  fontWeight: FontWeight.bold),
                            ),
                            Text(
                              '{% if scan_type == "engine" %}Engine No{% else %}VIN{% endif %}: ${widget.vin}',
                              style: const TextStyle(
                                  color: Colors.white70, fontSize: 10),
                            ),
                          ],
                        ),
                      ),
                    ),
                    IconButton(
                      icon: Icon(
                        _showDebugConsole
                            ? Icons.bug_report
                            : Icons.bug_report_outlined,
                        color: Colors.white70,
                      ),
                      onPressed: () => setState(
                          () => _showDebugConsole = !_showDebugConsole),
                    ),
                  ],
                ),
              ),
              Container(
                width: double.infinity,
                padding:
                    const EdgeInsets.symmetric(vertical: 12, horizontal: 16),
                color: Colors.white.withOpacity(0.9),
                child: Column(
                  children: [
                    Text(
                      currentTask['name'] as String,
                      style: const TextStyle(
                          color: Color(0xFFDC143C),
                          fontWeight: FontWeight.w900,
                          fontSize: 18),
                    ),
                    const SizedBox(height: 4),
                    const Text(
                      'Align object within the frame and capture',
                      style: TextStyle(color: Colors.grey, fontSize: 12),
                    ),
                  ],
                ),
              ),
              Expanded(
                child: Stack(
                  children: [
                    if (_capturedImageBytes == null)
                      Positioned.fill(
                        child: _isCameraInitialized && _cameraController != null
                            ? CameraPreview(_cameraController!)
                            : const Center(
                                child: CircularProgressIndicator(
                                    color: Color(0xFFDC143C))),
                      ),
                    if (_capturedImageBytes != null)
                      Positioned.fill(
                        child: _capturedImageSize != null
                            ? FittedBox(
                                fit: BoxFit.contain,
                                child: SizedBox(
                                  width: _capturedImageSize!.width,
                                  height: _capturedImageSize!.height,
                                  child: Stack(
                                    fit: StackFit.expand,
                                    children: [
                                      Image.memory(
                                        _capturedImageBytes!,
                                        fit: BoxFit.fill,
                                        width: _capturedImageSize!.width,
                                        height: _capturedImageSize!.height,
                                      ),
                                      if (overlayResult != null)
                                        DetectionOverlay(
                                          results: [overlayResult],
                                          previewSize: _capturedImageSize!,
                                          overrideColor: badgeGreen
                                              ? Colors.green
                                              : Colors.red,
                                        ),
                                    ],
                                  ),
                                ),
                              )
                            : Image.memory(_capturedImageBytes!,
                                fit: BoxFit.contain),
                      ),
                    if (_capturedImageBytes == null)
                      Center(
                        child: Container(
                          width: 280,
                          height: 280,
                          decoration: BoxDecoration(
                            border: Border.all(
                                color: const Color(0xFFDC143C), width: 2),
                          ),
                        ),
                      ),
                    if (_isLoadingModel && _capturedImageBytes == null)
                      Container(
                        color: Colors.black45,
                        child: const Center(
                            child: CircularProgressIndicator(
                                color: Colors.white)),
                      ),
                    if (_isAnalyzing)
                      Container(
                        color: Colors.black54,
                        child: const Center(
                            child: CircularProgressIndicator(
                                color: Color(0xFFDC143C))),
                      ),
                    if (_capturedImageBytes == null && _isCameraInitialized)
                      Positioned(
                        top: 16,
                        left: 16,
                        child: GestureDetector(
                          onTap: _toggleFlash,
                          child: Container(
                            width: 48,
                            height: 48,
                            decoration: BoxDecoration(
                              color: _isFlashOn
                                  ? const Color(0xFFFFD700)
                                  : Colors.black54,
                              shape: BoxShape.circle,
                              border: Border.all(
                                color: _isFlashOn
                                    ? const Color(0xFFFFD700)
                                    : Colors.white30,
                                width: 1.5,
                              ),
                            ),
                            child: Icon(
                              _isFlashOn
                                  ? Icons.flashlight_on
                                  : Icons.flashlight_off,
                              color:
                                  _isFlashOn ? Colors.black : Colors.white,
                              size: 24,
                            ),
                          ),
                        ),
                      ),
                    if (!_isAnalyzing && _capturedImageBytes != null)
                      Positioned(
                        top: 16,
                        right: 16,
                        child: Container(
                          padding: const EdgeInsets.symmetric(
                              horizontal: 16, vertical: 8),
                          decoration: BoxDecoration(
                            color: badgeGreen ? Colors.green : Colors.red,
                            borderRadius: BorderRadius.circular(20),
                          ),
                          child: Text(
                            badgeGreen
                                ? '✓ ${_bestResult!.className}'
                                : overlayResult != null
                                    ? '✗ ${overlayResult.className}'
                                    : 'NOT FOUND',
                            style: const TextStyle(
                                color: Colors.white,
                                fontWeight: FontWeight.bold,
                                fontSize: 13),
                          ),
                        ),
                      ),
                    if (!_isAnalyzing &&
                        _capturedImageBytes != null &&
                        _bestResult == null &&
                        !_showDebugConsole)
                      Positioned(
                        bottom: 0,
                        left: 0,
                        right: 0,
                        child: Container(
                          padding:
                              const EdgeInsets.fromLTRB(16, 14, 16, 14),
                          decoration: BoxDecoration(
                            color: Colors.black.withOpacity(0.88),
                            borderRadius: const BorderRadius.vertical(
                                top: Radius.circular(16)),
                          ),
                          child: Column(
                            mainAxisSize: MainAxisSize.min,
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Row(children: [
                                const Icon(Icons.cancel,
                                    color: Colors.red, size: 16),
                                const SizedBox(width: 6),
                                Expanded(
                                  child: Text(
                                    "Target not found: ${taskClasses.join(', ')}",
                                    style: const TextStyle(
                                        color: Colors.red,
                                        fontWeight: FontWeight.bold,
                                        fontSize: 13),
                                    overflow: TextOverflow.ellipsis,
                                  ),
                                ),
                              ]),
                              if (_detectedNonTargetClasses.isNotEmpty) ...[
                                const SizedBox(height: 10),
                                const Text('Detected instead:',
                                    style: TextStyle(
                                        color: Colors.white54,
                                        fontSize: 11)),
                                const SizedBox(height: 6),
                                ..._detectedNonTargetClasses
                                    .map((d) => Padding(
                                          padding: const EdgeInsets.only(
                                              bottom: 4),
                                          child: Row(children: [
                                            const Icon(Icons.close,
                                                color: Colors.orange,
                                                size: 14),
                                            const SizedBox(width: 6),
                                            Text(
                                              d.className,
                                              style: const TextStyle(
                                                  color: Colors.orange,
                                                  fontSize: 13,
                                                  fontWeight:
                                                      FontWeight.w600),
                                            ),
                                            const SizedBox(width: 8),
                                            Text(
                                              "${(d.confidence * 100).toStringAsFixed(0)}%",
                                              style: const TextStyle(
                                                  color: Colors.white54,
                                                  fontSize: 12),
                                            ),
                                          ]),
                                        )),
                              ] else ...[
                                const SizedBox(height: 8),
                                const Text('Nothing detected.',
                                    style: TextStyle(
                                        color: Colors.white54,
                                        fontSize: 12)),
                              ],
                            ],
                          ),
                        ),
                      ),
                    if (_showDebugConsole)
                      Positioned(
                        bottom: 0,
                        left: 0,
                        right: 0,
                        height: 200,
                        child: Container(
                          color: Colors.black.withOpacity(0.85),
                          padding: const EdgeInsets.all(8),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Row(
                                mainAxisAlignment:
                                    MainAxisAlignment.spaceBetween,
                                children: [
                                  const Text('DEBUG CONSOLE',
                                      style: TextStyle(
                                          color: Colors.yellow,
                                          fontWeight: FontWeight.bold,
                                          fontSize: 10)),
                                  IconButton(
                                    icon: const Icon(Icons.delete_sweep,
                                        color: Colors.white, size: 16),
                                    onPressed: () =>
                                        setState(() => _debugLogs = []),
                                    padding: EdgeInsets.zero,
                                    constraints: const BoxConstraints(),
                                  ),
                                ],
                              ),
                              const Divider(color: Colors.white24),
                              Expanded(
                                child: ListView.builder(
                                  itemCount: _debugLogs.length,
                                  itemBuilder: (_, idx) => Padding(
                                    padding:
                                        const EdgeInsets.only(bottom: 2),
                                    child: Text(
                                      _debugLogs[idx],
