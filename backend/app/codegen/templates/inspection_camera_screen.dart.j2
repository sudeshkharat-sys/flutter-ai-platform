/// Result of [_decodeAndCheckBlur] -- only primitives/typed data cross the
/// isolate boundary, so the oriented image comes back as a lossless PNG
/// rather than as an img.Image object.
class _BlurCheckResult {
  final double? variance;
  final Uint8List? orientedPngBytes;
  const _BlurCheckResult({this.variance, this.orientedPngBytes});
}

/// Runs on a background isolate via compute(). Decoding a full-resolution
/// JPEG, baking in its EXIF orientation, and walking a 150x150 grayscale
/// copy pixel-by-pixel to score blur is real CPU work -- a few hundred ms
/// on a mid-range phone. Doing all of that inline on the UI isolate (as
/// this used to) blocked every frame for that long on *every* capture,
/// which is what showed up as the app "lagging while capturing" through an
/// inspection with many task photos.
_BlurCheckResult _decodeAndCheckBlur(Uint8List bytes) {
  try {
    final decoded = img.decodeImage(bytes);
    if (decoded == null) return const _BlurCheckResult();
    final oriented = img.bakeOrientation(decoded);

    final small = img.copyResize(oriented, width: 150, height: 150);
    final gray = img.grayscale(small);
    double sumLap = 0, sumLapSq = 0;
    int count = 0;
    for (int y = 1; y < gray.height - 1; y++) {
      for (int x = 1; x < gray.width - 1; x++) {
        final c = gray.getPixel(x, y).r.toDouble();
        final t = gray.getPixel(x, y - 1).r.toDouble();
        final b = gray.getPixel(x, y + 1).r.toDouble();
        final l = gray.getPixel(x - 1, y).r.toDouble();
        final rv = gray.getPixel(x + 1, y).r.toDouble();
        final lap = t + b + l + rv - 4 * c;
        sumLap += lap;
        sumLapSq += lap * lap;
        count++;
      }
    }
    double? variance;
    if (count > 0) {
      final mean = sumLap / count;
      variance = (sumLapSq / count) - (mean * mean);
    }
    return _BlurCheckResult(
      variance: variance,
      orientedPngBytes: Uint8List.fromList(img.encodePng(oriented)),
    );
  } catch (_) {
    return const _BlurCheckResult();
  }
}

class InspectionCameraScreen extends StatefulWidget {
  final String vin;
  final String modelCode;
  final List<dynamic> tasks;
  final int initialIndex;

  const InspectionCameraScreen({
    super.key,
    required this.vin,
    required this.modelCode,
    required this.tasks,
    required this.initialIndex,
  });

  @override
  State<InspectionCameraScreen> createState() => _InspectionCameraScreenState();
}

class _InspectionCameraScreenState extends State<InspectionCameraScreen>
    with WidgetsBindingObserver {
  CameraController? _cameraController;
  bool _isCameraInitialized = false;
  Uint8List? _capturedImageBytes;
  Size? _capturedImageSize;
  DetectionResult? _bestResult;
  bool _isAnalyzing = false;
  bool _isModelLoaded = false;
  bool _isLoadingModel = true;
  String? _error;

  List<String> _debugLogs = [];
  bool _showDebugConsole = false;
  bool _isFlashOn = false;

  List<DetectionResult> _allDetections = [];
  List<DetectionResult> _detectedNonTargetClasses = [];
  // Maps mandatory class name -> best DetectionResult found (null = not detected)
  Map<String, DetectionResult?> _mandatoryClassResults = {};
  // Unchecked classes for current task — detecting any of these = fail
  List<String> _failClasses = [];
  // Maps fail class name -> best DetectionResult found (null = not detected)
  Map<String, DetectionResult?> _failClassResults = {};
  int _currentIndex = 0;
  final Map<int, dynamic> _results = {};

  @override
  void initState() {
    super.initState();
    _currentIndex = widget.initialIndex;
    WidgetsBinding.instance.addObserver(this);
    _initializeCamera();
    _loadCurrentModel();
    _addLog("Screen initialized for {% if scan_type == "engine" %}Engine No{% else %}VIN{% endif %}: ${widget.vin}");
  }

  void _addLog(String msg) {
    if (!mounted) return;
    setState(() {
      _debugLogs.insert(
          0,
          "${DateTime.now().toString().split('.').first.split(' ').last} | $msg");
      if (_debugLogs.length > 50) _debugLogs.removeLast();
    });
    debugPrint(msg);
  }

  bool _isNotOkClass(String? className) {
    if (className == null) return false;
    final cn =
        className.toLowerCase().replaceAll('_', ' ').replaceAll('-', ' ');
    return cn.contains('not') && cn.contains('ok');
  }

  bool _isPass(String? className, List<String> targetClasses) {
    if (className == null) return false;
    if (_isNotOkClass(className)) return false;
    final cn = className.toLowerCase().trim();
    return targetClasses.any((tc) => tc.toLowerCase().trim() == cn);
  }

  // A class the user explicitly marked "Ignore" has no effect on the result
  // at all -- not even the "not ok" name-substring heuristic below, since an
  // explicit user choice should always win over that fragile guess (e.g. a
  // class literally named "notebook" would otherwise false-positive as a
  // defect class with no way to opt back out).
  bool _isIgnored(String? className, List<String> ignoredClasses) {
    if (className == null) return false;
    final cn = className.toLowerCase().trim();
    return ignoredClasses.any((ig) => ig.toLowerCase().trim() == cn);
  }

  // Returns true only if:
  //  1. ALL pass (checked) classes are detected
  //  2. NO "not ok" class detected (hard block — always fails), unless ignored
  //  3. NO fail (unchecked) class detected — unchecked classes are fail conditions
  bool _allMandatoryPassed(
    Map<String, DetectionResult?> mandatory,
    List<DetectionResult> allDetections,
    List<String> failClasses,
    List<String> ignoredClasses,
  ) {
    if (mandatory.isEmpty) return false;
    // Hard block: any non-ignored "not ok" detection → always fail
    if (allDetections.any((d) => _isNotOkClass(d.className) && !_isIgnored(d.className, ignoredClasses))) return false;
    // Any unchecked (fail) class detected → fail
    final failNamesLower = failClasses.map((c) => c.toLowerCase().trim()).toSet();
    if (allDetections.any((d) => failNamesLower.contains(d.className.toLowerCase().trim()))) return false;
    // All pass classes must be detected
    return mandatory.values.every((r) => r != null);
  }

  /// True only when a genuine defect/wrong part was actually detected (an
  /// explicit "not ok" class, or a fail/unchecked class). False when the
  /// failure is just an absence of detections -- that case is "not found",
  /// not "not ok", and the two should read differently to the inspector.
  bool _hasDefectDetected(
    List<DetectionResult> allDetections,
    List<String> failClasses,
    List<String> ignoredClasses,
  ) {
    if (allDetections.any((d) => _isNotOkClass(d.className) && !_isIgnored(d.className, ignoredClasses))) return true;
    final failNamesLower = failClasses.map((c) => c.toLowerCase().trim()).toSet();
    return allDetections.any((d) => failNamesLower.contains(d.className.toLowerCase().trim()));
  }

  Future<void> _loadCurrentModel() async {
    setState(() {
      _isLoadingModel = true;
      _isModelLoaded = false;
    });
    try {
      final task = widget.tasks[_currentIndex];
      _addLog("Loading Task: ${task['name']}");
      _addLog("TFLite: ${task['tflite_path']}");
      await ModelManager().loadModel(task['tflite_path'], task['labels_path']);
{% if ocr_enabled %}
      // Whatever code was scanned to reach this inspection (VIN/engine
      // serial/Chakan VIN) -- used as the OCR target for any mandatory
      // class configured to check its read against the scanned code
      // instead of a fixed expected-text string.
      ModelManager().setScanTruthValue(widget.vin);
{% endif %}
{% if ocr_uses_crnn %}
      await ModelManager().loadOcrModel(
        '{{ ocr_class_recognizer_tflite | default("", true) }}',
        '{{ ocr_class_recognizer_charset | default("", true) }}',
        metaPath: {% if ocr_class_recognizer_meta %}'{{ ocr_class_recognizer_meta }}'{% else %}null{% endif %},
      );
{% endif %}
      if (mounted) {
        setState(() {
          _isLoadingModel = false;
          _isModelLoaded = true;
        });
        _addLog("Model loaded. Target: ${task['classes']}");
      }
    } catch (e) {
      _addLog("AI Init error: $e");
      if (mounted) setState(() => _error = "AI Init error: $e");
    }
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    if (_isFlashOn) {
      _cameraController?.setFlashMode(FlashMode.off).catchError((_) {});
    }
    _cameraController?.dispose();
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    final ctrl = _cameraController;
    if (ctrl == null || !ctrl.value.isInitialized) return;
    if (state == AppLifecycleState.inactive) {
      if (_isFlashOn) {
        ctrl.setFlashMode(FlashMode.off).catchError((_) {});
        setState(() => _isFlashOn = false);
      }
      ctrl.dispose();
    } else if (state == AppLifecycleState.resumed) {
      _initializeCamera();
    }
  }

  Future<void> _initializeCamera() async {
    try {
      final cameras = await availableCameras();
      if (cameras.isEmpty) {
        _addLog('No cameras found');
        if (mounted) setState(() => _error = 'No cameras found');
        return;
      }
      final back = cameras.firstWhere(
          (c) => c.lensDirection == CameraLensDirection.back,
          orElse: () => cameras.first);
      final controller =
          CameraController(back, ResolutionPreset.medium, enableAudio: false);
      _cameraController = controller;
      await controller.initialize();
      if (mounted) setState(() => _isCameraInitialized = true);
      _addLog('Camera initialized');
    } catch (e) {
      _addLog("Camera error: $e");
      if (mounted) setState(() => _error = "Camera error: $e");
    }
  }

  Future<void> _handleCapture() async {
    if (_isAnalyzing || !_isModelLoaded || _cameraController == null) {
      _addLog(
          "Capture blocked: analyzing=$_isAnalyzing modelReady=$_isModelLoaded");
      return;
    }
    // Set this before the first await -- takePicture()/the blur check below
    // can take long enough for a second tap to land while _isAnalyzing was
    // still false, re-entering this function and calling takePicture() a
    // second time on the same CameraController before the first capture
    // finished. That double-call is what caused "tap capture multiple times
    // -> app lags/freezes, no image captured".
    setState(() => _isAnalyzing = true);
    try {
      _addLog('--- Start Inference ---');
      final XFile image = await _cameraController!.takePicture();
      final bytes = await image.readAsBytes();

      Size? imageSize;
      img.Image? orientedImage;
      // Decode + orient + blur-score off the UI isolate -- see
      // _decodeAndCheckBlur's doc comment for why this used to be the main
      // source of capture lag. Only the small, lossless PNG round-trip
      // happens back here, so ModelManager()/box-drawing below still see
      // pixel-identical data to before.
      final blurCheck = await compute(_decodeAndCheckBlur, bytes);
      if (blurCheck.orientedPngBytes != null) {
        try {
          final oriented = img.decodePng(blurCheck.orientedPngBytes!);
          if (oriented != null) {
            orientedImage = oriented;
            imageSize = Size(oriented.width.toDouble(), oriented.height.toDouble());
          }
        } catch (_) {}
      }
      if (blurCheck.variance != null) {
        final blurVariance = blurCheck.variance!;
        _addLog("Blur variance: ${blurVariance.toStringAsFixed(1)}");
        if (blurVariance < 150.0 && mounted) {
          await showDialog(
            context: context,
            barrierDismissible: false,
            builder: (_) => AlertDialog(
              backgroundColor: const Color(0xFF1A1A24),
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(16)),
              title: const Row(children: [
                Icon(Icons.blur_on, color: Color(0xFFDC143C)),
                SizedBox(width: 8),
                Text('Image Not Clear',
                    style: TextStyle(color: Colors.white, fontSize: 18)),
              ]),
              content: const Text(
                'The photo appears blurry or out of focus.\nPlease hold the device steady and retake.',
                style: TextStyle(color: Colors.white70, height: 1.5),
              ),
              actions: [
                ElevatedButton.icon(
                  onPressed: () => Navigator.pop(context),
                  icon: const Icon(Icons.camera_alt,
                      color: Colors.white, size: 18),
                  label: const Text('Retake',
                      style: TextStyle(color: Colors.white)),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFFDC143C),
                    shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(8)),
                  ),
                ),
              ],
            ),
          );
          if (mounted) setState(() => _isAnalyzing = false);
          return;
        }
      }

      setState(() {
        _bestResult = null;
        _mandatoryClassResults = {};
        _failClassResults = {};
        _capturedImageBytes = bytes;
        _capturedImageSize = imageSize;
      });

      final currentTask = widget.tasks[_currentIndex];
      final List<String> allModelClasses =
          List<String>.from(currentTask['classes'] ?? []);
      final List<String> mandatoryClasses =
          List<String>.from(currentTask['mandatoryClasses'] ?? []);
      final List<String> ignoredClasses =
          List<String>.from(currentTask['ignoredClasses'] ?? []);
      // Pass classes = checked by user. Fail classes = everything else in the model,
      // except classes explicitly marked ignored (neither required nor forbidden --
      // their presence or absence has no effect on the result).
      // If mandatoryClasses is empty (nothing checked), treat all classes as mandatory.
      final List<String> targetClasses = mandatoryClasses.isNotEmpty
          ? mandatoryClasses
          : allModelClasses;
      final List<String> failClasses = mandatoryClasses.isNotEmpty
          ? allModelClasses.where((c) =>
              !mandatoryClasses.any((m) => m.toLowerCase().trim() == c.toLowerCase().trim()) &&
              !ignoredClasses.any((ig) => ig.toLowerCase().trim() == c.toLowerCase().trim())).toList()
          : [];
      // Safety check: if targetClasses somehow still contains everything, it means
      // mandatory was not configured — log it for debugging.
      if (mandatoryClasses.isEmpty) _addLog("WARNING: no mandatoryClasses configured — treating all as mandatory");
      _addLog("Pass: ${targetClasses.join(', ')}  Fail: ${failClasses.join(', ')}");

      final allDetections = orientedImage != null
          ? await ModelManager().predictImage(orientedImage, orientedPngBytes: blurCheck.orientedPngBytes)
          : await ModelManager().predictBytes(bytes);
      setState(() => _allDetections = allDetections);

      _addLog("Detections: ${allDetections.length}");
      for (final d in allDetections) {
        _addLog("  ${d.className} ${(d.confidence * 100).toStringAsFixed(1)}%");
      }

      // For each mandatory class, find the best (highest confidence) detection
      final Map<String, DetectionResult?> mandatoryResults = {};
      for (final mc in targetClasses) {
        final matches = allDetections.where((d) =>
            d.className.toLowerCase().trim() == mc.toLowerCase().trim());
        mandatoryResults[mc] = matches.isNotEmpty
            ? (matches.toList()..sort((a, b) => b.confidence.compareTo(a.confidence))).first
            : null;
        _addLog("  [$mc] → ${mandatoryResults[mc]?.className ?? 'NOT FOUND'} | ocrText=${mandatoryResults[mc]?.ocrText} | ocrMatch=${mandatoryResults[mc]?.isOcrMatch}");
      }

      // For each fail class, check if it was detected
      final Map<String, DetectionResult?> failResults = {};
      for (final fc in failClasses) {
        final matches = allDetections.where((d) =>
            d.className.toLowerCase().trim() == fc.toLowerCase().trim());
        failResults[fc] = matches.isNotEmpty
            ? (matches.toList()..sort((a, b) => b.confidence.compareTo(a.confidence))).first
            : null;
      }

      final bool overallPass = _allMandatoryPassed(mandatoryResults, allDetections, failClasses, ignoredClasses);

      String? savedImagePath;
      String? savedBackupPath;
      try {
        PermissionStatus status = await Permission.photos.request();
        if (!status.isGranted) {
          status = await Permission.storage.request();
        }

        final baseDir = Directory('/storage/emulated/0/Pictures');
        if (!await baseDir.exists()) await baseDir.create(recursive: true);

        final safeVin = widget.vin.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final safeTask = (currentTask['name'] as String? ?? 'task')
            .replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final appName = '{{ app_name }}'.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final imgDir = Directory('${baseDir.path}/MAI/$appName/Inspections/$safeVin/$safeTask');
        await imgDir.create(recursive: true);

        final now = DateTime.now();
        final dateStr =
            '${now.year}-${now.month.toString().padLeft(2, '0')}-${now.day.toString().padLeft(2, '0')}';
        final timeStr =
            '${now.hour.toString().padLeft(2, '0')}-${now.minute.toString().padLeft(2, '0')}-${now.second.toString().padLeft(2, '0')}';
        final resultBadge = overallPass ? 'OK' : 'NOT_OK';
        savedImagePath = '${imgDir.path}/${safeTask}_${resultBadge}_${dateStr}_$timeStr.jpg';

        // Use orientedImage so boxes align with model inference coordinates
        final decoded = orientedImage ?? img.decodeImage(bytes);
        List<int> compressed;
        if (decoded != null) {
          final iw = decoded.width.toDouble();
          final ih = decoded.height.toDouble();

          for (final det in allDetections) {
            // An explicitly ignored class has no effect on the result --
            // drawing a box for it anyway just clutters the saved photo
            // with something the inspector doesn't need to look at, and
            // burning it in red would make a genuinely-OK inspection look
            // like it failed when reviewed later. Skip it entirely instead
            // of giving it its own color, keeping the clean green/red look.
            if (_isIgnored(det.className, ignoredClasses)) continue;

            final isMandatory = targetClasses.any(
              (tc) => det.className.toLowerCase().trim() == tc.toLowerCase().trim(),
            );
            // 2-color logic: green=mandatory found, red=not ok or unexpected unchecked
            final img.Color boxColor;
            if (isMandatory) {
              boxColor = img.ColorRgb8(0, 200, 0);       // green — mandatory found
            } else {
              boxColor = img.ColorRgb8(220, 0, 0);       // red — unexpected/unchecked or defect
            }

            final x1 = (det.bbox.left * iw).toInt().clamp(0, decoded.width - 1);
            final y1 = (det.bbox.top * ih).toInt().clamp(0, decoded.height - 1);
            final x2 = (det.bbox.right * iw).toInt().clamp(0, decoded.width - 1);
            final y2 = (det.bbox.bottom * ih).toInt().clamp(0, decoded.height - 1);

            for (int t = 0; t < 3; t++) {
              img.drawRect(decoded,
                  x1: x1 + t, y1: y1 + t, x2: x2 - t, y2: y2 - t,
                  color: boxColor);
            }

            final label =
                '${det.className} ${(det.confidence * 100).toStringAsFixed(0)}%';
            final labelY = (y1 - 20).clamp(0, decoded.height - 20);
            img.fillRect(decoded,
                x1: x1, y1: labelY, x2: x1 + label.length * 8 + 6, y2: labelY + 18,
                color: boxColor);
            img.drawString(decoded, label,
                font: img.arial14,
                x: x1 + 3,
                y: labelY + 2,
                color: img.ColorRgb8(255, 255, 255));
          }

          compressed = img.encodeJpg(decoded, quality: 40);
        } else {
          compressed = bytes;
        }
        await File(savedImagePath).writeAsBytes(compressed, flush: true);
        final savedLen = await File(savedImagePath).length();
        _addLog("Image saved (${savedLen}B): $savedImagePath");

        try {
          final appDir = await getApplicationSupportDirectory();
          final backupDir = Directory('${appDir.path}/inspection_backups/$safeVin/$safeTask');
          await backupDir.create(recursive: true);
          final backupFile = File('${backupDir.path}/${safeTask}_${resultBadge}_${dateStr}_$timeStr.jpg');
          if (decoded != null) {
            final thumb = img.copyResize(decoded, width: 480);
            await backupFile.writeAsBytes(img.encodeJpg(thumb, quality: 15), flush: true);
          } else {
            await backupFile.writeAsBytes(compressed, flush: true);
          }
          savedBackupPath = backupFile.path;
          _addLog("Backup saved: $savedBackupPath");
        } catch (e) {
          _addLog("Backup save FAILED: $e");
        }
      } catch (e) {
        _addLog("Image save FAILED: $e");
        savedImagePath = null;
      }

      setState(() {
        _mandatoryClassResults = mandatoryResults;
        _failClasses = failClasses;
        _failClassResults = failResults;
        // Keep _bestResult as the highest-confidence mandatory detection (for overlay compat)
        final found = mandatoryResults.values.whereType<DetectionResult>().toList()
          ..sort((a, b) => b.confidence.compareTo(a.confidence));
        _bestResult = found.isNotEmpty ? found.first : null;

        _results[_currentIndex] = {
          'className': overallPass
              ? 'OK'
              : (_hasDefectDetected(allDetections, failClasses, ignoredClasses) ? 'NOT OK' : 'None'),
          'success': overallPass,
          'imagePath': savedImagePath,
          'backupImagePath': savedBackupPath,
          'mandatoryResults': mandatoryResults.map((k, v) => MapEntry(k, v != null ? v.toJson() : null)),
          'detectionsJson': jsonEncode(allDetections.map((d) => d.toJson()).toList()),
        };
        _isAnalyzing = false;
      });
    } catch (e) {
      _addLog("ERROR: $e");
      setState(() => _isAnalyzing = false);
      if (mounted) {
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('Capture failed: $e')));
      }
    }
  }

  Future<void> _toggleFlash() async {
    if (_cameraController == null || !_isCameraInitialized) return;
    final newOn = !_isFlashOn;
    try {
      await _cameraController!
          .setFlashMode(newOn ? FlashMode.torch : FlashMode.off);
      setState(() => _isFlashOn = newOn);
      _addLog(newOn ? 'Flash ON' : 'Flash OFF');
    } catch (e) {
      _addLog("Flash error: $e");
    }
  }

  void _retake() {
    _addLog('Retake');
    setState(() {
      _capturedImageBytes = null;
      _capturedImageSize = null;
      _bestResult = null;
      _mandatoryClassResults = {};
      _isAnalyzing = false;
      _allDetections = [];
      _detectedNonTargetClasses = [];
    });
  }

  void _onSaveAndContinue() {
    _results[_currentIndex] ??= {
      'className': 'None',
      'success': false,
      'imagePath': null,
      'detectionsJson': jsonEncode([]),
    };

    if (_results.length == widget.tasks.length) {
      _addLog('All tasks done');
      Navigator.pop(context, _results);
      return;
    }

    final nextIdx = (_currentIndex + 1) % widget.tasks.length;
    _addLog("Moving to Task ${nextIdx + 1}");
    setState(() {
      _currentIndex = nextIdx;
      _capturedImageBytes = null;
      _bestResult = null;
      _mandatoryClassResults = {};
      _detectedNonTargetClasses = [];
    });
    _loadCurrentModel();
  }

  @override
  Widget build(BuildContext context) {
    if (_error != null) {
      return Scaffold(body: Center(child: Text('Error: $_error')));
    }
    final currentTask = widget.tasks[_currentIndex];
    final List<String> mandatoryClasses =
        List<String>.from(currentTask['mandatoryClasses'] ?? currentTask['classes'] ?? []);
    final List<String> ignoredClasses =
        List<String>.from(currentTask['ignoredClasses'] ?? []);

    final bool badgeGreen = _mandatoryClassResults.isNotEmpty
        ? _allMandatoryPassed(_mandatoryClassResults, _allDetections, _failClasses, ignoredClasses)
        : (_bestResult != null && !_isNotOkClass(_bestResult!.className) && !_allDetections.any((d) => _isNotOkClass(d.className) && !_isIgnored(d.className, ignoredClasses)));
    final bool badgeHasDefect = _hasDefectDetected(_allDetections, _failClasses, ignoredClasses);

    final DetectionResult? overlayResult = _bestResult;

    return Scaffold(
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [Colors.white, Color(0xFFFFF5F5)],
          ),
        ),
        child: SafeArea(
          child: Column(
            children: [
              Container(
                width: double.infinity,
                padding:
                    const EdgeInsets.symmetric(vertical: 12, horizontal: 16),
                decoration: const BoxDecoration(color: Color(0xFFDC143C)),
                child: Row(
                  children: [
                    IconButton(
                      icon: const Icon(Icons.arrow_back, color: Colors.white),
