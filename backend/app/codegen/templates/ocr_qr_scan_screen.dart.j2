import 'package:camera/camera.dart';
import 'package:flutter/material.dart';
import 'package:mobile_scanner/mobile_scanner.dart';
import 'ocr_scan_screen.dart';

/// Scans the engine's QR/barcode sticker for the real engine number before
/// the camera OCR step -- a barcode is checksum-protected, so a successful
/// scan is trustworthy in a way no OCR read can be. The extracted value
/// becomes the "truth" the camera read gets checked against.
///
/// The sticker carries two QR codes with different payload layouts, so two
/// extraction strategies are tried in order and whichever produces a
/// plausible result (right length, alphanumeric) wins:
///   1. Space-separated: "0301BBH00960N KYT4H69548" -> last token.
///   2. Fixed-length prefix: "KYT4H69548AH77GNC8..." -> first N characters.
class OcrQrScanScreen extends StatefulWidget {
  final List<CameraDescription> cameras;
  const OcrQrScanScreen({super.key, required this.cameras});

  @override
  State<OcrQrScanScreen> createState() => _OcrQrScanScreenState();
}

class _OcrQrScanScreenState extends State<OcrQrScanScreen> {
  static const int? expectedLength = {{ ocr_expected_length | default('null') }};

  bool _processing = false;
  String? _error;

  final MobileScannerController _scannerController = MobileScannerController(
    detectionSpeed: DetectionSpeed.noDuplicates,
    facing: CameraFacing.back,
  );

  @override
  void dispose() {
    _scannerController.dispose();
    super.dispose();
  }

  /// Returns the extracted engine number, or null if neither strategy
  /// produced a plausible result.
  static String? _extractTruthValue(String raw) {
    final trimmed = raw.trim();
    if (trimmed.isEmpty) return null;

    bool isPlausible(String s) {
      if (s.isEmpty) return false;
      if (!RegExp(r'^[A-Za-z0-9]+$').hasMatch(s)) return false;
      if (expectedLength != null) return s.length == expectedLength;
      return true;
    }

    // Strategy 1: space-separated, engine number is the last token.
    final tokens = trimmed.split(RegExp(r'\s+'));
    if (tokens.isNotEmpty) {
      final lastToken = tokens.last;
      if (isPlausible(lastToken)) return lastToken.toUpperCase();
    }

    // Strategy 2: no separator, engine number is a fixed-length prefix.
    if (expectedLength != null && trimmed.length >= expectedLength!) {
      final prefix = trimmed.substring(0, expectedLength);
      if (isPlausible(prefix)) return prefix.toUpperCase();
    }

    // Neither strategy validated -- if there's no configured length to
    // check against, fall back to the whole first token as a best guess
    // rather than blocking the scan entirely.
    if (expectedLength == null && tokens.isNotEmpty) {
      final candidate = tokens.first.replaceAll(RegExp(r'[^A-Za-z0-9]'), '');
      if (candidate.isNotEmpty) return candidate.toUpperCase();
    }

    return null;
  }

  void _onDetect(BarcodeCapture capture) {
    if (_processing) return;
    final barcodes = capture.barcodes;
    if (barcodes.isEmpty) return;
    final raw = barcodes.first.rawValue;
    if (raw == null) return;

    final truthValue = _extractTruthValue(raw);
    if (truthValue == null) {
      setState(() => _error = 'Could not read a valid engine number from this code. Raw: $raw');
      return;
    }

    setState(() => _processing = true);
    _scannerController.stop();
    Navigator.of(context).pushReplacement(
      MaterialPageRoute(
        builder: (context) => OcrScanScreen(cameras: widget.cameras, truthValue: truthValue),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Scan Engine QR Code')),
      body: Stack(
        children: [
          MobileScanner(controller: _scannerController, onDetect: _onDetect),
          Center(
            child: Container(
              width: 260,
              height: 260,
              decoration: BoxDecoration(
                border: Border.all(color: const Color(0xFFDC143C), width: 2),
                borderRadius: BorderRadius.circular(8),
              ),
            ),
          ),
          Positioned(
            top: 16,
            left: 16,
            right: 16,
            child: Text(
              'Scan either QR code on the engine sticker',
              textAlign: TextAlign.center,
              style: const TextStyle(color: Colors.white, backgroundColor: Colors.black54, fontSize: 14),
            ),
          ),
          if (_error != null)
            Positioned(
              bottom: 24,
              left: 16,
              right: 16,
              child: Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(color: Colors.red.shade700, borderRadius: BorderRadius.circular(8)),
                child: Text(_error!, style: const TextStyle(color: Colors.white), textAlign: TextAlign.center),
              ),
            ),
        ],
      ),
    );
  }
}
