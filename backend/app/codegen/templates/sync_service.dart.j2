/// mDNS service type the PC receiver app advertises on the LAN. Discovery
/// only ever sees devices on the same WiFi/hotspot -- it does not reach
/// outside the local network.
const String kSyncServiceType = '_flutteraisync._tcp';

/// Folder name this app's data is grouped under on the PC (alongside the
/// phone's name), so multiple generated apps sending to the same PC don't
/// mix their data together.
const String kAppFolderName = '{{ app_name_slug }}';

class DiscoveredPc {
  final String name;
  final String ip;
  final int port;
  const DiscoveredPc({required this.name, required this.ip, required this.port});
}

/// A PC this phone has completed the one-time QR pairing handshake with.
/// [secret] is only ever known to this phone and that PC -- it's what lets
/// the PC reject data from any other device on the network.
class PairedPc {
  final String deviceId;
  final String name;
  String ip;
  int port;
  final String secret;

  PairedPc({
    required this.deviceId,
    required this.name,
    required this.ip,
    required this.port,
    required this.secret,
  });

  Map<String, dynamic> toJson() =>
      {'deviceId': deviceId, 'name': name, 'ip': ip, 'port': port, 'secret': secret};

  factory PairedPc.fromJson(Map<String, dynamic> j) => PairedPc(
        deviceId: j['deviceId'] as String,
        name: j['name'] as String,
        ip: j['ip'] as String,
        port: j['port'] as int,
        secret: j['secret'] as String,
      );
}

class SyncResult {
  final bool success;
  final String message;
  final int sentCount;
  const SyncResult(this.success, this.message, {this.sentCount = 0});
}

class _ExportBundle {
  final Uint8List zipBytes;
  final List<int> inspectionIds;
  const _ExportBundle(this.zipBytes, this.inspectionIds);
}

class SyncService {
  static final SyncService instance = SyncService._();
  SyncService._();

  static const _storage = FlutterSecureStorage();
  static const _kPairedDevicesKey = 'synced_pc_devices';
  static const _kDeviceLabelKey = 'sync_device_label';

  // ── This phone's display name (e.g. "Sudesh") ───────────────────────────
  // Shown on the PC's paired-device list and used as the top-level folder
  // name under which this phone's data is saved, so multiple phones sending
  // to the same PC land in clearly separate folders.

  Future<String?> getDeviceLabel() async {
    final prefs = await SharedPreferences.getInstance();
    final v = prefs.getString(_kDeviceLabelKey);
    return (v == null || v.trim().isEmpty) ? null : v.trim();
  }

  Future<void> setDeviceLabel(String label) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_kDeviceLabelKey, label.trim());
  }

  /// Discover PC receivers advertising on the local network via mDNS.
  Future<List<DiscoveredPc>> discoverPcs({Duration timeout = const Duration(seconds: 4)}) async {
    final client = MDnsClient();
    final found = <String, DiscoveredPc>{};
    try {
      await client.start();
      await for (final ptr in client
          .lookup<PtrResourceRecord>(ResourceRecordQuery.serverPointer('$kSyncServiceType.local'))
          .timeout(timeout, onTimeout: (sink) => sink.close())) {
        await for (final srv in client
            .lookup<SrvResourceRecord>(ResourceRecordQuery.service(ptr.domainName))
            .timeout(const Duration(seconds: 2), onTimeout: (sink) => sink.close())) {
          await for (final ip in client
              .lookup<IPAddressResourceRecord>(ResourceRecordQuery.addressIPv4(srv.target))
              .timeout(const Duration(seconds: 2), onTimeout: (sink) => sink.close())) {
            final name = ptr.domainName.split('.').first;
            found[srv.target] = DiscoveredPc(name: name, ip: ip.address.address, port: srv.port);
          }
        }
      }
    } catch (_) {
      // mDNS blocked/unsupported on this network -- caller falls back to the
      // last known IP for already-paired PCs, or manual QR pairing.
    } finally {
      client.stop();
    }
    return found.values.toList();
  }

  Future<List<PairedPc>> getPairedPcs() async {
    final raw = await _storage.read(key: _kPairedDevicesKey);
    if (raw == null || raw.isEmpty) return [];
    final list = jsonDecode(raw) as List;
    return list.map((e) => PairedPc.fromJson(e as Map<String, dynamic>)).toList();
  }

  Future<void> _savePairedPcs(List<PairedPc> devices) async {
    await _storage.write(
        key: _kPairedDevicesKey, value: jsonEncode(devices.map((d) => d.toJson()).toList()));
  }

  Future<void> removePairedPc(String deviceId) async {
    final devices = await getPairedPcs();
    devices.removeWhere((d) => d.deviceId == deviceId);
    await _savePairedPcs(devices);
  }

  /// Complete one-time pairing using the JSON payload scanned from the QR
  /// code the PC receiver shows on screen: {name, ip, port, token}. The
  /// token is single-use and expires PC-side after a few minutes, so a
  /// screenshot of an old QR code can't be replayed later to pair a
  /// different phone.
  Future<PairedPc> pairFromQrData(String qrRaw) async {
    final data = jsonDecode(qrRaw) as Map<String, dynamic>;
    final ip = data['ip'] as String;
    final port = data['port'] as int;
    final pcName = data['name'] as String? ?? 'PC';
    final token = data['token'] as String;

    final deviceLabel = await getDeviceLabel() ?? _fallbackDeviceLabel();

    final resp = await http
        .post(
          Uri.parse('http://$ip:$port/pair'),
          headers: {'Content-Type': 'application/json'},
          body: jsonEncode({
            'token': token,
            'deviceName': deviceLabel,
            'appName': kAppFolderName,
          }),
        )
        .timeout(const Duration(seconds: 10));

    if (resp.statusCode != 200) {
      throw Exception('Pairing rejected by PC (${resp.statusCode}): ${resp.body}');
    }
    final body = jsonDecode(resp.body) as Map<String, dynamic>;
    final paired = PairedPc(
      deviceId: body['deviceId'] as String,
      name: pcName,
      ip: ip,
      port: port,
      secret: body['secret'] as String,
    );

    final devices = await getPairedPcs();
    devices.removeWhere((d) => d.name == pcName && d.ip == ip);
    devices.add(paired);
    await _savePairedPcs(devices);
    return paired;
  }

  String _fallbackDeviceLabel() =>
      'phone-${DateTime.now().millisecondsSinceEpoch.toRadixString(36)}';

  Future<int> getUnsyncedCount() => db.countUnsyncedInspections();

  /// Sends any not-yet-uploaded inspections to the first paired PC, if any
  /// is paired. Intended to be called automatically right after a
  /// submission (mirrors auto-print) -- returns null (no-op, no error to
  /// surface) if no PC has ever been paired yet.
  Future<SyncResult?> autoSendIfPaired() async {
    final devices = await getPairedPcs();
    if (devices.isEmpty) return null;
    return sendToPc(devices.first);
  }

  /// Exports every inspection not yet confirmed received by [pc] (database
  /// rows + their images) into a zip, uploads it with an HMAC-signed
  /// request, and marks those inspections synced only once the PC confirms
  /// receipt. Already-synced inspections are never re-sent. Local data is
  /// never deleted or modified by a failed send -- it simply stays flagged
  /// unsynced until the next successful attempt.
  Future<SyncResult> sendToPc(PairedPc pc) async {
    try {
      final bundle = await _buildExportBundle();
      if (bundle.inspectionIds.isEmpty) {
        return const SyncResult(true, 'Already up to date -- nothing to send.');
      }

      // Refresh the PC's current LAN IP in case DHCP changed it since
      // pairing; fall back to the last known IP if discovery finds nothing.
      final discovered = await discoverPcs(timeout: const Duration(seconds: 2));
      final match = discovered.where((d) => d.name == pc.name);
      if (match.isNotEmpty) {
        pc.ip = match.first.ip;
        pc.port = match.first.port;
        final devices = await getPairedPcs();
        final idx = devices.indexWhere((d) => d.deviceId == pc.deviceId);
        if (idx != -1) {
          devices[idx] = pc;
          await _savePairedPcs(devices);
        }
      }

      final timestamp = DateTime.now().millisecondsSinceEpoch.toString();
      final bodyHash = sha256.convert(bundle.zipBytes).toString();
      final signaturePayload = '${pc.deviceId}:$timestamp:$bodyHash';
      final signature =
          Hmac(sha256, utf8.encode(pc.secret)).convert(utf8.encode(signaturePayload)).toString();

      final uri = Uri.parse('http://${pc.ip}:${pc.port}/upload');
      final request = http.MultipartRequest('POST', uri)
        ..headers['X-Device-Id'] = pc.deviceId
        ..headers['X-Timestamp'] = timestamp
        ..headers['X-Signature'] = signature
        ..files.add(http.MultipartFile.fromBytes('data', bundle.zipBytes,
            filename: 'inspection_export.zip'));

      final streamed = await request.send().timeout(const Duration(seconds: 60));
      final resp = await http.Response.fromStream(streamed);

      if (resp.statusCode == 200) {
        await db.markInspectionsSynced(bundle.inspectionIds);
        return SyncResult(true, 'Sent ${bundle.inspectionIds.length} inspection(s) to PC.',
            sentCount: bundle.inspectionIds.length);
      }
      if (resp.statusCode == 401) {
        return const SyncResult(false, 'Rejected: this phone is not paired with that PC.');
      }
      return SyncResult(false, 'PC rejected the upload (${resp.statusCode}).');
    } on TimeoutException {
      return const SyncResult(false, "Timed out -- is the PC on this WiFi/hotspot and the receiver running?");
    } catch (e) {
      return SyncResult(false, 'Send failed: $e');
    }
  }

  // Same A/B/C shift windows used by the History screen, so the PC-side
  // data matches what the inspector sees on the phone.
  String _shiftFor(DateTime dt) {
    final mins = dt.hour * 60 + dt.minute;
    if (mins >= 420 && mins < 930) return 'A';
    if (mins >= 930) return 'B';
    return 'C';
  }

  // Shift C runs past midnight, so a 1am scan belongs to the *previous*
  // day's shift for reporting purposes -- same rollover rule as the
  // History screen's shift-day grouping.
  String _shiftDateFor(DateTime dt) {
    final d = dt.hour < 7 ? dt.subtract(const Duration(days: 1)) : dt;
    return '${d.year.toString().padLeft(4, '0')}-${d.month.toString().padLeft(2, '0')}-${d.day.toString().padLeft(2, '0')}';
  }

  /// Maps model/engine code -> human-readable name using the same lookup
  /// data already bundled for VIN/engine-code scanning, so the PC side gets
  /// a readable name without needing its own copy of the master data.
  Future<Map<String, String>> _loadModelNameMap() async {
    try {
{% if scan_type == 'engine' %}
      final raw = await rootBundle.loadString('assets/engine_data.json');
      final List<dynamic> data = jsonDecode(raw);
      return {
        for (final e in data)
          (e['part_no'] as String? ?? '').toUpperCase(): (e['model_name'] as String? ?? ''),
      };
{% else %}
      final raw = await rootBundle.loadString('assets/master_data.json');
      final List<dynamic> data = jsonDecode(raw);
      return {
        for (final e in data)
          (e['model_code'] as String? ?? '').toUpperCase(): (e['platform_name'] as String? ?? ''),
      };
{% endif %}
    } catch (_) {
      return {};
    }
  }

  Future<_ExportBundle> _buildExportBundle() async {
    final archive = Archive();
    final unsynced = await db.getUnsyncedInspections();
    final manifest = <Map<String, dynamic>>[];
    final seenImagePaths = <String>{};
    final modelNames = await _loadModelNameMap();

    for (final insp in unsynced) {
      final results = await db.getResultsForInspection(insp.id);
      final taskList = <Map<String, dynamic>>[];

      for (final r in results) {
        String? zipImagePath;
        String? zipBackupPath;
        for (final entry in [
          MapEntry(r.imagePath, (String p) => zipImagePath = p),
          MapEntry(r.backupImagePath, (String p) => zipBackupPath = p),
        ]) {
          final path = entry.key;
          if (path == null || path.isEmpty) continue;
          final f = File(path);
          final arcName = 'images/${f.uri.pathSegments.last}';
          if (await f.exists()) {
            if (!seenImagePaths.contains(path)) {
              seenImagePaths.add(path);
              final bytes = await f.readAsBytes();
              archive.addFile(ArchiveFile(arcName, bytes.length, bytes));
            }
            entry.value(arcName);
          }
        }

        taskList.add({
          'taskName': r.taskName,
          'className': r.className,
          'success': r.success,
          'imagePath': zipImagePath,
          'backupImagePath': zipBackupPath,
          'timestamp': r.timestamp.toIso8601String(),
        });
      }

      final dt = insp.createdAt;
      manifest.add({
        'inspectionId': insp.id,
        'vin': insp.vin,
        'modelCode': insp.modelCode,
        'modelName': modelNames[insp.modelCode.toUpperCase()] ?? '',
        'createdAt': dt.toIso8601String(),
        'date': '${dt.year.toString().padLeft(4, '0')}-${dt.month.toString().padLeft(2, '0')}-${dt.day.toString().padLeft(2, '0')}',
        'time': '${dt.hour.toString().padLeft(2, '0')}:${dt.minute.toString().padLeft(2, '0')}:${dt.second.toString().padLeft(2, '0')}',
        'shift': _shiftFor(dt),
        'shiftDate': _shiftDateFor(dt),
        'tasks': taskList,
      });
    }

    final manifestBytes = utf8.encode(jsonEncode(manifest));
    archive.addFile(ArchiveFile('manifest.json', manifestBytes.length, manifestBytes));

    final zipped = ZipEncoder().encode(archive);
    return _ExportBundle(
        Uint8List.fromList(zipped ?? const []), unsynced.map((e) => e.id).toList());
  }
}
