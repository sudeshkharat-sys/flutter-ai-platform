import 'package:flutter/material.dart';
import 'package:permission_handler/permission_handler.dart';
import '../services/print_service.dart';

const _crimson = Color(0xFFDC143C);
const _crimsonLight = Color(0xFFFFEBEE);
const _crimsonDark = Color(0xFFB01030);

class PrinterDiscoveryScreen extends StatefulWidget {
  /// When true the screen only lets the user pick + save a default printer
  /// (no report is printed). Used for "Select / Change Printer" from settings.
  final bool selectOnly;
  final String vin;
  final String modelCode;
  final String timestamp;
  final bool overallSuccess;
  final List<Map<String, dynamic>> tasks;

  const PrinterDiscoveryScreen({
    super.key,
    this.selectOnly = false,
    this.vin = 'UNKNOWN',
    this.modelCode = 'UNKNOWN',
    this.timestamp = '',
    this.overallSuccess = false,
    this.tasks = const [],
  });

  @override
  State<PrinterDiscoveryScreen> createState() =>
      _PrinterDiscoveryScreenState();
}

class _PrinterDiscoveryScreenState extends State<PrinterDiscoveryScreen> {
  final List<DiscoveredPrinter> _printers = [];
  bool _scanning = false;
  bool _printing = false;
  String _statusMessage = '';
  final TextEditingController _macController = TextEditingController();
  int _dpi = PrintService.defaultDpi;

  @override
  void initState() {
    super.initState();
    _loadBondedDevices();
    _loadDpi();
  }

  Future<void> _loadDpi() async {
    final dpi = await PrintService.instance.getPrinterDpi();
    if (mounted) setState(() => _dpi = dpi);
  }

  Future<void> _setDpi(int dpi) async {
    setState(() => _dpi = dpi);
    await PrintService.instance.setPrinterDpi(dpi);
  }

  @override
  void dispose() {
    _macController.dispose();
    super.dispose();
  }

  /// Request the Bluetooth permissions needed for the requested operation.
  ///
  /// Listing already-paired devices (getBondedDevices) only needs
  /// BLUETOOTH_CONNECT on Android 12+, and nothing extra on Android 11-.
  ///
  /// Active discovery (startDiscovery) additionally needs BLUETOOTH_SCAN on
  /// Android 12+ and ACCESS_FINE_LOCATION on Android 11- (a BT scan can be
  /// used to derive physical location, so the OS gates it behind location).
  ///
  /// We therefore only hard-require location/scan when [forScan] is true, so
  /// denying location never blocks the paired-printer path.
  Future<bool> _ensureBluetoothPermissions({required bool forScan}) async {
    final requests = <Permission>[Permission.bluetoothConnect];
    if (forScan) {
      requests.add(Permission.bluetoothScan);
      requests.add(Permission.location);
    }
    final statuses = await requests.request();

    // permission_handler abstracts SDK differences: on Android 11- it returns
    // granted for bluetoothConnect since no runtime grant is needed there.
    final connectBlocked =
        !(statuses[Permission.bluetoothConnect]?.isGranted ?? false);

    bool scanBlocked = false;
    if (forScan) {
      final scanGranted =
          statuses[Permission.bluetoothScan]?.isGranted ?? false;
      final locationGranted =
          statuses[Permission.location]?.isGranted ?? false;
      scanBlocked = !scanGranted || !locationGranted;
    }

    if (connectBlocked || scanBlocked) {
      if (mounted) {
        setState(() {
          _scanning = false;
          _statusMessage = forScan
              ? 'Bluetooth scan / location permission denied. Grant in App Settings.'
              : 'Bluetooth permission denied. Grant in App Settings.';
        });
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(forScan
                ? 'Bluetooth & location permissions are required to scan for printers.'
                : 'Bluetooth permission is required to list paired printers.'),
            backgroundColor: _crimson,
            action: SnackBarAction(
              label: 'Settings',
              textColor: Colors.white,
              onPressed: openAppSettings,
            ),
          ),
        );
      }
      return false;
    }
    return true;
  }

  Future<void> _loadBondedDevices() async {
    setState(() {
      _printers.clear();
      _scanning = true;
      _statusMessage = 'Loading paired devices…';
    });

    if (!await _ensureBluetoothPermissions(forScan: false)) return;

    try {
      final bonded = await PrintService.instance.getBondedPrinters();
      if (mounted) {
        setState(() {
          _printers.addAll(bonded);
          _scanning = false;
          _statusMessage = bonded.isEmpty
              ? 'No paired devices found. Pair printer in Android Bluetooth settings first.'
              : '${bonded.length} paired device(s) found';
        });
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          _scanning = false;
          _statusMessage = 'Error loading devices: $e';
        });
      }
    }
  }

  Future<void> _discoverPrinters() async {
    setState(() {
      _printers.clear();
      _scanning = true;
      _statusMessage = 'Scanning for Zebra printers…';
    });

    if (!await _ensureBluetoothPermissions(forScan: true)) return;

    try {
      final found = await PrintService.instance.discoverBluetoothPrinters();
      if (mounted) {
        setState(() {
          _printers.addAll(found);
          _scanning = false;
          _statusMessage = found.isEmpty
              ? 'No printers found. Try the "Paired" list or enter MAC manually.'
              : '${found.length} printer(s) found';
        });
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          _scanning = false;
          _statusMessage = 'Error scanning: $e';
        });
      }
    }
  }

  void _addManualMac() {
    final mac = _macController.text.trim().toUpperCase();
    if (mac.isEmpty) return;

    final macRegex = RegExp(r'^([0-9A-F]{2}:){5}[0-9A-F]{2}$');
    if (!macRegex.hasMatch(mac)) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Enter a valid MAC address (e.g. C4:D3:6A:AC:F0:AE)'),
          backgroundColor: _crimson,
        ),
      );
      return;
    }

    setState(() {
      if (!_printers.any((p) => p.address == mac)) {
        _printers.add(DiscoveredPrinter(name: 'Printer @ $mac', address: mac));
      }
    });
    _macController.clear();
    FocusScope.of(context).unfocus();
  }

  Future<void> _printTo(DiscoveredPrinter printer) async {
    // Remember this printer so future auto-prints target it directly
    // instead of guessing the first paired Bluetooth device.
    await PrintService.instance.setDefaultPrinter(printer);

    // Selection-only mode: just save the default and return, no printing.
    if (widget.selectOnly) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text('Default printer set: ${printer.name}'),
        backgroundColor: Colors.green[700],
      ));
      Navigator.of(context).pop();
      return;
    }

    setState(() => _printing = true);

    final ok = await PrintService.instance.printInspectionReport(
      printer: printer,
      vin: widget.vin,
      modelCode: widget.modelCode,
      timestamp: widget.timestamp,
      overallSuccess: widget.overallSuccess,
      tasks: widget.tasks,
    );

    if (!mounted) return;
    setState(() => _printing = false);

    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: Text(ok
          ? 'Report printed — saved as default printer.'
          : 'Print failed: ${PrintService.instance.lastPrintError ?? 'ensure printer is on, in range, and in ZPL mode'}'),
      backgroundColor: ok ? Colors.green[700] : _crimson,
      duration: const Duration(seconds: 6),
    ));

    // Return to the inspection flow either way -- a failed print (printer
    // off/out of range) shouldn't trap the inspector here away from the next
    // scan. The chosen printer is already saved as default, so they can
    // retry later via the Print icon on the scan screen.
    if (mounted) Navigator.of(context).pop();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFFFF5F5),
      appBar: AppBar(
        backgroundColor: _crimson,
        title: Text(widget.selectOnly ? 'Select Printer' : 'Print Report',
            style: const TextStyle(color: Colors.white, fontSize: 16, fontWeight: FontWeight.w600)),
        iconTheme: const IconThemeData(color: Colors.white),
        elevation: 0,
      ),
      body: _printing
          ? Center(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  const CircularProgressIndicator(color: _crimson),
                  const SizedBox(height: 16),
                  Text('Sending to printer…',
                      style: TextStyle(color: Colors.grey[700], fontSize: 14)),
                ],
              ),
            )
          : Column(
              children: [
                // ── Status bar ────────────────────────────────────────────────
                Container(
                  padding: const EdgeInsets.symmetric(
                      horizontal: 16, vertical: 10),
                  color: Colors.white,
                  child: Row(
                    children: [
                      if (_scanning)
                        const SizedBox(
                          width: 14,
                          height: 14,
                          child: CircularProgressIndicator(
                              strokeWidth: 2, color: _crimson),
                        )
                      else
                        const Icon(Icons.bluetooth,
                            size: 16, color: _crimson),
                      const SizedBox(width: 10),
                      Expanded(
                        child: Text(
                          _statusMessage,
                          style: TextStyle(
                              color: Colors.grey[700], fontSize: 13),
                        ),
                      ),
                      TextButton.icon(
                        onPressed: _scanning ? null : _loadBondedDevices,
                        icon: const Icon(Icons.bluetooth_connected,
                            size: 14, color: _crimson),
                        label: const Text('Paired',
                            style: TextStyle(color: _crimson, fontSize: 12)),
                        style: TextButton.styleFrom(
                            padding: const EdgeInsets.symmetric(
                                horizontal: 6, vertical: 4)),
                      ),
                      TextButton.icon(
                        onPressed: _scanning ? null : _discoverPrinters,
                        icon: const Icon(Icons.radar,
                            size: 14, color: _crimson),
                        label: const Text('Scan',
                            style: TextStyle(color: _crimson, fontSize: 12)),
                        style: TextButton.styleFrom(
                            padding: const EdgeInsets.symmetric(
                                horizontal: 6, vertical: 4)),
                      ),
                    ],
                  ),
                ),
                if (_scanning)
                  const LinearProgressIndicator(
                    minHeight: 3,
                    backgroundColor: _crimsonLight,
                    color: _crimson,
                  ),

                // ── Label DPI toggle ─────────────────────────────────────────
                Container(
                  padding: const EdgeInsets.fromLTRB(16, 10, 16, 4),
                  color: Colors.white,
                  child: Row(
                    children: [
                      const Icon(Icons.print, size: 16, color: _crimson),
                      const SizedBox(width: 10),
                      const Text('Label DPI:',
                          style: TextStyle(color: Colors.black87, fontSize: 13)),
                      const Spacer(),
                      ToggleButtons(
                        borderRadius: BorderRadius.circular(8),
                        selectedColor: Colors.white,
                        fillColor: _crimson,
                        color: _crimson,
                        borderColor: _crimson,
                        selectedBorderColor: _crimson,
                        constraints: const BoxConstraints(minHeight: 32, minWidth: 68),
                        isSelected: PrintService.supportedDpi
                            .map((dpi) => dpi == _dpi)
                            .toList(),
                        onPressed: (index) =>
                            _setDpi(PrintService.supportedDpi[index]),
                        children: PrintService.supportedDpi
                            .map((dpi) => Text('$dpi dpi',
                                style: const TextStyle(fontSize: 12)))
                            .toList(),
                      ),
                    ],
                  ),
                ),

                // ── Manual MAC entry ──────────────────────────────────────────
                Padding(
                  padding: const EdgeInsets.fromLTRB(12, 12, 12, 4),
                  child: Row(
                    children: [
                      Expanded(
                        child: TextField(
                          controller: _macController,
                          style: const TextStyle(
                              color: Colors.black87, fontSize: 14),
                          textCapitalization: TextCapitalization.characters,
                          onSubmitted: (_) => _addManualMac(),
                          decoration: InputDecoration(
                            hintText: 'Enter MAC (e.g. C4:D3:6A:AC:F0:AE)',
                            hintStyle: const TextStyle(
                                color: Colors.grey, fontSize: 13),
                            filled: true,
                            fillColor: Colors.white,
                            prefixIcon: const Icon(Icons.bluetooth_searching,
                                color: _crimson, size: 18),
                            contentPadding: const EdgeInsets.symmetric(
                                horizontal: 12, vertical: 10),
                            border: OutlineInputBorder(
                                borderRadius: BorderRadius.circular(8),
                                borderSide: const BorderSide(
                                    color: Color(0xFFE0E0E0))),
                            enabledBorder: OutlineInputBorder(
                                borderRadius: BorderRadius.circular(8),
                                borderSide: const BorderSide(
                                    color: Color(0xFFE0E0E0))),
                            focusedBorder: OutlineInputBorder(
                                borderRadius: BorderRadius.circular(8),
                                borderSide: const BorderSide(
                                    color: _crimson, width: 1.5)),
                          ),
                        ),
                      ),
                      const SizedBox(width: 8),
                      ElevatedButton(
                        onPressed: _addManualMac,
                        style: ElevatedButton.styleFrom(
                          backgroundColor: _crimson,
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(
                              horizontal: 14, vertical: 13),
                          shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(8)),
                        ),
                        child: const Text('Add',
                            style: TextStyle(fontWeight: FontWeight.bold)),
                      ),
                    ],
                  ),
                ),

                // ── Printer list ──────────────────────────────────────────────
                Expanded(
                  child: _printers.isEmpty
                      ? Center(
                          child: Padding(
                            padding: const EdgeInsets.all(24),
                            child: Column(
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                Icon(
                                  _scanning
                                      ? Icons.radar
                                      : Icons.bluetooth_disabled,
                                  size: 56,
                                  color: _crimson.withOpacity(0.25),
                                ),
                                const SizedBox(height: 14),
                                Text(
                                  _scanning
                                      ? 'Searching for Bluetooth printers…'
                                      : 'No printers found.\nPair your Zebra printer in Android Bluetooth settings,\nthen tap "Paired" — or enter the MAC address manually.',
                                  textAlign: TextAlign.center,
                                  style: TextStyle(
                                      color: Colors.grey[600], fontSize: 13),
                                ),
                              ],
                            ),
                          ),
                        )
                      : ListView.builder(
                          padding:
                              const EdgeInsets.fromLTRB(12, 8, 12, 12),
                          itemCount: _printers.length,
                          itemBuilder: (_, i) {
                            final p = _printers[i];
                            return Container(
                              margin: const EdgeInsets.only(bottom: 8),
                              decoration: BoxDecoration(
                                color: Colors.white,
                                borderRadius: BorderRadius.circular(10),
                                border: Border.all(
                                    color: const Color(0xFFE8E8E8)),
                                boxShadow: [
                                  BoxShadow(
                                    color: Colors.black.withOpacity(0.04),
                                    blurRadius: 4,
                                    offset: const Offset(0, 2),
                                  ),
                                ],
                              ),
                              child: ListTile(
                                contentPadding:
                                    const EdgeInsets.symmetric(
                                        horizontal: 12, vertical: 4),
                                leading: Container(
                                  width: 40,
                                  height: 40,
                                  decoration: BoxDecoration(
                                    color: _crimsonLight,
                                    shape: BoxShape.circle,
                                  ),
                                  child: const Icon(Icons.bluetooth,
                                      color: _crimson, size: 20),
                                ),
                                title: Text(p.name,
                                    style: const TextStyle(
                                        color: Colors.black87,
                                        fontWeight: FontWeight.w600,
                                        fontSize: 14)),
                                subtitle: Text(p.address,
                                    style: TextStyle(
                                        color: Colors.grey[500],
                                        fontSize: 12)),
                                trailing: ElevatedButton.icon(
                                  onPressed: () => _printTo(p),
                                  icon: Icon(
                                      widget.selectOnly
                                          ? Icons.check
                                          : Icons.print,
                                      size: 15),
                                  label: Text(
                                      widget.selectOnly ? 'Select' : 'Print',
                                      style: const TextStyle(fontSize: 13)),
                                  style: ElevatedButton.styleFrom(
                                    backgroundColor: _crimson,
                                    foregroundColor: Colors.white,
                                    padding: const EdgeInsets.symmetric(
                                        horizontal: 12, vertical: 8),
                                    shape: RoundedRectangleBorder(
                                        borderRadius:
                                            BorderRadius.circular(8)),
                                  ),
                                ),
                              ),
                            );
                          },
                        ),
                ),
              ],
            ),
    );
  }
}
