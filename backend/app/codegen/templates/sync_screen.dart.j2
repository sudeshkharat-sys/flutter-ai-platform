import 'package:flutter/material.dart';
import 'package:mobile_scanner/mobile_scanner.dart';
import '../services/sync_service.dart';

const _crimson = Color(0xFFDC143C);
const _gold = Color(0xFFD4AF37);

class SyncScreen extends StatefulWidget {
  const SyncScreen({super.key});

  @override
  State<SyncScreen> createState() => _SyncScreenState();
}

class _SyncScreenState extends State<SyncScreen> {
  List<PairedPc> _pairedPcs = [];
  List<DiscoveredPc> _discovered = [];
  bool _loadingPaired = true;
  bool _scanning = false;
  String? _busyDeviceId;
  String? _deviceLabel;
  int _unsyncedCount = 0;

  @override
  void initState() {
    super.initState();
    _loadPaired();
    _loadDeviceLabel();
    _loadUnsyncedCount();
  }

  Future<void> _loadPaired() async {
    setState(() => _loadingPaired = true);
    final devices = await SyncService.instance.getPairedPcs();
    if (mounted) setState(() {
      _pairedPcs = devices;
      _loadingPaired = false;
    });
  }

  Future<void> _loadDeviceLabel() async {
    final label = await SyncService.instance.getDeviceLabel();
    if (mounted) setState(() => _deviceLabel = label);
  }

  Future<void> _loadUnsyncedCount() async {
    final count = await SyncService.instance.getUnsyncedCount();
    if (mounted) setState(() => _unsyncedCount = count);
  }

  /// Prompts for a name the first time (so data lands in a clearly-labelled
  /// folder on the PC, e.g. "Samsung"), and lets it be changed afterward.
  Future<String?> _promptDeviceLabel({required bool required}) async {
    final controller = TextEditingController(text: _deviceLabel ?? '');
    return showDialog<String>(
      context: context,
      barrierDismissible: !required,
      builder: (ctx) => AlertDialog(
        title: const Text('Name this phone'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'This name is used to label your data on the PC (e.g. "Samsung") so it stays separate from other phones\' data.',
              style: TextStyle(fontSize: 12, color: Colors.grey),
            ),
            const SizedBox(height: 12),
            TextField(
              controller: controller,
              autofocus: true,
              decoration: const InputDecoration(
                hintText: 'e.g. Samsung',
                border: OutlineInputBorder(),
              ),
            ),
          ],
        ),
        actions: [
          if (!required)
            TextButton(onPressed: () => Navigator.of(ctx).pop(), child: const Text('Cancel')),
          ElevatedButton(
            onPressed: () {
              final v = controller.text.trim();
              if (v.isEmpty) return;
              Navigator.of(ctx).pop(v);
            },
            style: ElevatedButton.styleFrom(backgroundColor: _crimson, foregroundColor: Colors.white),
            child: const Text('Save'),
          ),
        ],
      ),
    );
  }

  Future<void> _editDeviceLabel() async {
    final name = await _promptDeviceLabel(required: false);
    if (name == null || name.isEmpty) return;
    await SyncService.instance.setDeviceLabel(name);
    if (mounted) setState(() => _deviceLabel = name);
  }

  Future<void> _discover() async {
    setState(() => _scanning = true);
    final found = await SyncService.instance.discoverPcs();
    if (mounted) setState(() {
      _discovered = found;
      _scanning = false;
    });
  }

  Future<void> _openScanner() async {
    if (_deviceLabel == null || _deviceLabel!.isEmpty) {
      final name = await _promptDeviceLabel(required: true);
      if (name == null || name.isEmpty) return;
      await SyncService.instance.setDeviceLabel(name);
      if (mounted) setState(() => _deviceLabel = name);
    }
    if (!mounted) return;

    final code = await Navigator.of(context).push<String>(
      MaterialPageRoute(builder: (_) => const _QrScanScreen()),
    );
    if (code == null || !mounted) return;

    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (_) => const Center(child: CircularProgressIndicator(color: _crimson)),
    );

    try {
      final paired = await SyncService.instance.pairFromQrData(code);
      if (!mounted) return;
      Navigator.of(context).pop(); // close spinner
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text('Paired with ${paired.name}'),
        backgroundColor: Colors.green[700],
      ));
      _loadPaired();
    } catch (e) {
      if (!mounted) return;
      Navigator.of(context).pop();
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text('Pairing failed: $e'),
        backgroundColor: _crimson,
        duration: const Duration(seconds: 5),
      ));
    }
  }

  Future<void> _sendTo(PairedPc pc) async {
    setState(() => _busyDeviceId = pc.deviceId);
    final result = await SyncService.instance.sendToPc(pc);
    if (!mounted) return;
    setState(() => _busyDeviceId = null);
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: Text(result.message),
      backgroundColor: result.success ? Colors.green[700] : _crimson,
      duration: const Duration(seconds: 5),
    ));
    _loadUnsyncedCount();
  }

  /// Resends this phone's entire local history, not just what's currently
  /// flagged unsynced -- for when the sync state can't be trusted (e.g.
  /// re-pairing after an app reinstall) or inspections seem to be missing
  /// on the PC. Confirmed first since it's a heavier, deliberate action,
  /// not the everyday "Send" button.
  Future<void> _resyncAll(PairedPc pc) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Resync all data?'),
        content: Text(
          'This resends every inspection this phone has ever recorded to "${pc.name}", '
          'not just what\'s new. Use this if some data seems to be missing on the PC '
          '(e.g. after re-pairing this phone). Already-received inspections won\'t be '
          'duplicated -- the PC skips anything it already has.',
        ),
        actions: [
          TextButton(onPressed: () => Navigator.of(ctx).pop(false), child: const Text('Cancel')),
          ElevatedButton(
            onPressed: () => Navigator.of(ctx).pop(true),
            style: ElevatedButton.styleFrom(backgroundColor: _crimson, foregroundColor: Colors.white),
            child: const Text('Resync All'),
          ),
        ],
      ),
    );
    if (confirm != true) return;

    setState(() => _busyDeviceId = pc.deviceId);
    final result = await SyncService.instance.resyncAll(pc);
    if (!mounted) return;
    setState(() => _busyDeviceId = null);
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: Text(result.message),
      backgroundColor: result.success ? Colors.green[700] : _crimson,
      duration: const Duration(seconds: 5),
    ));
    _loadUnsyncedCount();
  }

  Future<void> _remove(PairedPc pc) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Remove paired PC?'),
        content: Text('This phone will no longer be able to send data to "${pc.name}" until you re-pair.'),
        actions: [
          TextButton(onPressed: () => Navigator.of(ctx).pop(false), child: const Text('Cancel')),
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(true),
            child: const Text('Remove', style: TextStyle(color: _crimson)),
          ),
        ],
      ),
    );
    if (confirm == true) {
      await SyncService.instance.removePairedPc(pc.deviceId);
      _loadPaired();
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFFFF5F5),
      appBar: AppBar(
        backgroundColor: _crimson,
        elevation: 0,
        iconTheme: const IconThemeData(color: Colors.white),
        title: const Text('Send to PC',
            style: TextStyle(color: Colors.white, fontSize: 16, fontWeight: FontWeight.w600)),
      ),
      body: RefreshIndicator(
        onRefresh: () async {
          await _loadPaired();
          await _loadUnsyncedCount();
        },
        child: ListView(
          padding: const EdgeInsets.all(16),
          children: [
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
              margin: const EdgeInsets.only(bottom: 12),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(10),
                border: Border.all(color: const Color(0xFFE8E8E8)),
              ),
              child: Row(
                children: [
                  const Icon(Icons.badge_outlined, color: _crimson, size: 20),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      _deviceLabel == null
                          ? 'This phone has no name set yet'
                          : 'This phone: ${_deviceLabel!}',
                      style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w600),
                    ),
                  ),
                  TextButton(
                    onPressed: _editDeviceLabel,
                    child: Text(_deviceLabel == null ? 'Set Name' : 'Edit',
                        style: const TextStyle(color: _crimson, fontSize: 12)),
                  ),
                ],
              ),
            ),
            if (_unsyncedCount > 0)
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
                margin: const EdgeInsets.only(bottom: 12),
                decoration: BoxDecoration(
                  color: Colors.orange.withOpacity(0.1),
                  borderRadius: BorderRadius.circular(10),
                  border: Border.all(color: Colors.orange.shade300),
                ),
                child: Row(
                  children: [
                    const Icon(Icons.cloud_off, color: Colors.orange, size: 18),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Text(
                        '$_unsyncedCount inspection${_unsyncedCount == 1 ? '' : 's'} not uploaded yet',
                        style: const TextStyle(fontSize: 12, color: Colors.black87, fontWeight: FontWeight.w600),
                      ),
                    ),
                  ],
                ),
              ),
            Container(
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: _gold),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('Paired PCs',
                      style: TextStyle(fontWeight: FontWeight.bold, fontSize: 14, color: _crimson)),
                  const SizedBox(height: 4),
                  Text(
                    'One tap sends the local inspection data (database + images) to a PC you have paired with by scanning its QR code. Both devices must be on the same WiFi/hotspot.',
                    style: TextStyle(fontSize: 12, color: Colors.grey[700]),
                  ),
                  const SizedBox(height: 12),
                  if (_loadingPaired)
                    const Center(child: CircularProgressIndicator(color: _crimson))
                  else if (_pairedPcs.isEmpty)
                    Padding(
                      padding: const EdgeInsets.symmetric(vertical: 16),
                      child: Center(
                        child: Text('No PC paired yet. Scan a PC\'s QR code below to get started.',
                            textAlign: TextAlign.center,
                            style: TextStyle(color: Colors.grey[600], fontSize: 13)),
                      ),
                    )
                  else
                    ..._pairedPcs.map((pc) => Container(
                          margin: const EdgeInsets.only(bottom: 8),
                          decoration: BoxDecoration(
                            color: const Color(0xFFFFF5F5),
                            borderRadius: BorderRadius.circular(10),
                            border: Border.all(color: const Color(0xFFE8E8E8)),
                          ),
                          child: ListTile(
                            leading: const CircleAvatar(
                              backgroundColor: Color(0xFFFFEBEE),
                              child: Icon(Icons.computer, color: _crimson),
                            ),
                            title: Text(pc.name,
                                style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 14)),
                            subtitle: Text('Paired device',
                                style: TextStyle(fontSize: 11, color: Colors.grey[500])),
                            trailing: Row(
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                if (_busyDeviceId == pc.deviceId)
                                  const SizedBox(
                                    width: 20,
                                    height: 20,
                                    child: CircularProgressIndicator(strokeWidth: 2, color: _crimson),
                                  )
                                else
                                  ElevatedButton.icon(
                                    onPressed: () => _sendTo(pc),
                                    icon: const Icon(Icons.send, size: 15),
                                    label: const Text('Send', style: TextStyle(fontSize: 12)),
                                    style: ElevatedButton.styleFrom(
                                      backgroundColor: _crimson,
                                      foregroundColor: Colors.white,
                                      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                                      shape: RoundedRectangleBorder(
                                          borderRadius: BorderRadius.circular(8)),
                                    ),
                                  ),
                                if (_busyDeviceId != pc.deviceId)
                                  IconButton(
                                    icon: const Icon(Icons.sync_problem, size: 18, color: Colors.grey),
                                    tooltip: 'Resync all data (use if some data seems missing on the PC)',
                                    onPressed: () => _resyncAll(pc),
                                  ),
                                IconButton(
                                  icon: const Icon(Icons.close, size: 18, color: Colors.grey),
                                  tooltip: 'Remove pairing',
                                  onPressed: () => _remove(pc),
                                ),
                              ],
                            ),
                          ),
                        )),
                  const SizedBox(height: 4),
                  SizedBox(
                    width: double.infinity,
                    child: OutlinedButton.icon(
                      onPressed: _openScanner,
                      icon: const Icon(Icons.qr_code_scanner, color: _crimson),
                      label: const Text('Pair New PC (Scan QR)', style: TextStyle(color: _crimson)),
                      style: OutlinedButton.styleFrom(
                        side: const BorderSide(color: _crimson),
                        padding: const EdgeInsets.symmetric(vertical: 12),
                        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                      ),
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 16),
            Container(
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: const Color(0xFFE8E8E8)),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      const Expanded(
                        child: Text('PCs visible on this network',
                            style: TextStyle(fontWeight: FontWeight.bold, fontSize: 13)),
                      ),
                      TextButton.icon(
                        onPressed: _scanning ? null : _discover,
                        icon: _scanning
                            ? const SizedBox(
                                width: 12,
                                height: 12,
                                child: CircularProgressIndicator(strokeWidth: 2, color: _crimson))
                            : const Icon(Icons.refresh, size: 15, color: _crimson),
                        label: const Text('Scan', style: TextStyle(fontSize: 12, color: _crimson)),
                      ),
                    ],
                  ),
                  Text(
                    'This list is just for confirming a PC is reachable -- pairing still requires scanning its QR code, so being visible here is not enough to receive data.',
                    style: TextStyle(fontSize: 11, color: Colors.grey[500]),
                  ),
                  const SizedBox(height: 8),
                  if (_discovered.isEmpty)
                    Padding(
                      padding: const EdgeInsets.symmetric(vertical: 8),
                      child: Text('No PCs found. Tap "Scan".',
                          style: TextStyle(fontSize: 12, color: Colors.grey[500])),
                    )
                  else
                    ..._discovered.map((d) => Padding(
                          padding: const EdgeInsets.symmetric(vertical: 4),
                          child: Row(
                            children: [
                              const Icon(Icons.wifi, size: 14, color: Colors.grey),
                              const SizedBox(width: 8),
                              Text(d.name, style: const TextStyle(fontSize: 13)),
                            ],
                          ),
                        )),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _QrScanScreen extends StatefulWidget {
  const _QrScanScreen();

  @override
  State<_QrScanScreen> createState() => _QrScanScreenState();
}

class _QrScanScreenState extends State<_QrScanScreen> {
  bool _handled = false;
  bool _cameraReady = false;
  bool _startFailed = false;
  // Explicit controller (instead of letting MobileScanner create its own
  // default one) so we can await its camera being fully released before
  // handing control back to the VIN scan screen. Without this, the camera
  // session here can still be tearing down when ScanScreen's own controller
  // tries to restart, and the two fight over the hardware -- VIN scanning
  // then stays dead until the app is force-closed and reopened.
  //
  // autoStart is disabled because the widget mounting and starting its own
  // camera the instant this screen appears can race ScanScreen's controller
  // still releasing the hardware it just had -- that race is what shows up
  // as a black preview here (camera opened but no frames), not just as the
  // VIN scanner dying afterward. Starting it ourselves after a short delay
  // (with a retry) gives that release time to finish first.
  final MobileScannerController _controller =
      MobileScannerController(autoStart: false);

  @override
  void initState() {
    super.initState();
    _startCamera();
  }

  Future<void> _startCamera() async {
    // start() throwing is the easy case to catch and retry -- but the more
    // common way this races the VIN scanner's camera release is start()
    // resolving successfully while the OS camera HAL hasn't actually handed
    // over the hardware yet, which shows up as a black preview with no
    // error at all. Escalating delays across a few attempts (instead of a
    // single short one) gives that release more time to land before we give
    // up and ask the user to back out and retry manually.
    const delays = [
      Duration(milliseconds: 400),
      Duration(milliseconds: 800),
      Duration(milliseconds: 1400),
    ];
    for (int attempt = 0; attempt < delays.length; attempt++) {
      await Future.delayed(delays[attempt]);
      if (!mounted) return;
      try {
        await _controller.start();
        if (mounted) setState(() => _cameraReady = true);
        return;
      } catch (e) {
        debugPrint('[QrScanScreen] camera start attempt ${attempt + 1} failed: $e');
      }
    }
    // Out of attempts. Surface a retry button in the page itself rather
    // than only a snackbar -- the snackbar disappears and leaves a black
    // screen with no way forward except backing out and re-entering,
    // which is exactly the manual workaround this is meant to remove.
    if (mounted) setState(() => _startFailed = true);
  }

  /// Tears down whatever half-open session exists and starts over. Exposed
  /// as a button because this race can also end with start() reporting
  /// success while the preview stays black (the camera was handed over but
  /// no frames arrive) -- there's no error to catch in that case, so the
  /// only reliable recovery is letting the user re-trigger it in place
  /// instead of making them leave the screen and come back.
  Future<void> _retryCamera() async {
    if (!mounted) return;
    setState(() {
      _cameraReady = false;
      _startFailed = false;
    });
    try {
      await _controller.stop();
    } catch (_) {}
    await _startCamera();
  }

  void _onDetect(BarcodeCapture capture) async {
    if (_handled) return;
    final value = capture.barcodes.isNotEmpty ? capture.barcodes.first.rawValue : null;
    if (value == null) return;
    setState(() => _handled = true);
    // Brief, visible confirmation before leaving -- without this the screen
    // can pop so fast (a QR decodes in a handful of milliseconds) that it's
    // unclear whether a scan actually happened or the screen just closed.
    await Future.delayed(const Duration(milliseconds: 550));
    await _controller.stop();
    if (mounted) Navigator.of(context).pop(value);
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return WillPopScope(
      onWillPop: () async {
        await _controller.stop();
        return true;
      },
      child: Scaffold(
        backgroundColor: Colors.black,
        appBar: AppBar(
          backgroundColor: _crimson,
          title: const Text('Scan PC Pairing QR', style: TextStyle(color: Colors.white, fontSize: 15)),
          iconTheme: const IconThemeData(color: Colors.white),
        ),
        body: Stack(
          fit: StackFit.expand,
          children: [
            if (_cameraReady) MobileScanner(controller: _controller, onDetect: _onDetect),
            if (!_cameraReady && !_startFailed)
              const Center(
                child: CircularProgressIndicator(color: Colors.white),
              ),
            if (_startFailed)
              Center(
                child: Padding(
                  padding: const EdgeInsets.all(28),
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      const Icon(Icons.videocam_off, color: Colors.white54, size: 56),
                      const SizedBox(height: 14),
                      const Text(
                        'Camera did not start',
                        style: TextStyle(color: Colors.white, fontSize: 16, fontWeight: FontWeight.bold),
                      ),
                      const SizedBox(height: 6),
                      const Text(
                        'The VIN scanner may still be releasing the camera.',
                        textAlign: TextAlign.center,
                        style: TextStyle(color: Colors.white70, fontSize: 12),
                      ),
                      const SizedBox(height: 18),
                      ElevatedButton.icon(
                        onPressed: _retryCamera,
                        icon: const Icon(Icons.refresh, size: 18),
                        label: const Text('Retry Camera'),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: _crimson,
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 12),
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            // Always reachable while scanning: the camera can also come up
            // "successfully" but stay black (handed over, no frames), which
            // throws no error to detect -- so keep a manual restart within
            // reach instead of requiring a trip back out to the Sync screen.
            if (_cameraReady && !_handled)
              Positioned(
                left: 0,
                right: 0,
                bottom: 24,
                child: Center(
                  child: TextButton.icon(
                    onPressed: _retryCamera,
                    icon: const Icon(Icons.refresh, size: 16, color: Colors.white70),
                    label: const Text('Screen black? Restart camera',
                        style: TextStyle(color: Colors.white70, fontSize: 12)),
                    style: TextButton.styleFrom(
                      backgroundColor: Colors.black54,
                      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
                    ),
                  ),
                ),
              ),
            if (_handled)
              Container(
                color: Colors.black87,
                child: const Center(
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(Icons.check_circle, color: Colors.greenAccent, size: 72),
                      SizedBox(height: 14),
                      Text('QR Code Detected',
                          style: TextStyle(color: Colors.white, fontSize: 16, fontWeight: FontWeight.bold)),
                    ],
                  ),
                ),
              ),
          ],
        ),
      ),
    );
  }
}
