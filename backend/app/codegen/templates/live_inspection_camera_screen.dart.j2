import 'dart:async';
import 'dart:io';
import 'package:camera/camera.dart';
import 'package:flutter/material.dart';
import 'dart:convert';
import 'dart:typed_data';
import 'package:image/image.dart' as img;
import 'package:path_provider/path_provider.dart';
import 'package:permission_handler/permission_handler.dart';
import '../ml/detector.dart';
import '../ml/detection_result.dart';
import '../widgets/detection_overlay.dart';
import 'package:flutter/foundation.dart' show compute;

/// Live Scan (Beta) -- experimental alternative to the normal "aim, tap,
/// capture" flow. Instead of waiting for a manual tap, it continuously
/// watches the live preview for the current task's target class and, once
/// it has been seen confidently for a few consecutive checks in a row,
/// automatically freezes and analyzes that frame -- same full pipeline
/// (blur check, detection, save) as a manual capture. The frozen result
/// still needs a manual "Save & Continue" -- an auto-detected frame is
/// never written to history without that confirmation, so a false-positive
/// "OK" never gets recorded silently. A manual capture tap still works too,
/// as a fallback if live detection never locks on. If the target is never
/// seen confidently within 45 seconds of watching starting, the pipeline
/// auto-fires anyway on the current frame and records the existing
/// not-found outcome, rather than watching forever.
///
/// Ticks are driven by CameraController.startImageStream, not a
/// takePicture()-per-tick timer -- a full shutter + JPEG round trip
/// measured ~2s per tick on a real device, which is what made the earlier
/// version feel dead rather than live. Each raw stream frame is converted
/// to a small JPEG on a background isolate (_convertCameraFrameToJpeg) and
/// fed through the exact same ModelManager().predictBytes() path a manual
/// capture uses, so nothing about detection itself is new to get wrong.
class _BlurCheckResult {
  final double? variance;
  final Uint8List? orientedPngBytes;
  const _BlurCheckResult({this.variance, this.orientedPngBytes});
}

_BlurCheckResult _decodeAndCheckBlur(Uint8List bytes) {
  try {
    final decoded = img.decodeImage(bytes);
    if (decoded == null) return const _BlurCheckResult();
    final oriented = img.bakeOrientation(decoded);

    final small = img.copyResize(oriented, width: 150, height: 150);
    final gray = img.grayscale(small);
    double sumLap = 0, sumLapSq = 0;
    int count = 0;
    for (int y = 1; y < gray.height - 1; y++) {
      for (int x = 1; x < gray.width - 1; x++) {
        final c = gray.getPixel(x, y).r.toDouble();
        final t = gray.getPixel(x, y - 1).r.toDouble();
        final b = gray.getPixel(x, y + 1).r.toDouble();
        final l = gray.getPixel(x - 1, y).r.toDouble();
        final rv = gray.getPixel(x + 1, y).r.toDouble();
        final lap = t + b + l + rv - 4 * c;
        sumLap += lap;
        sumLapSq += lap * lap;
        count++;
      }
    }
    double? variance;
    if (count > 0) {
      final mean = sumLap / count;
      variance = (sumLapSq / count) - (mean * mean);
    }
    return _BlurCheckResult(
      orientedPngBytes: Uint8List.fromList(img.encodeJpg(oriented, quality: 92)),
    );
  } catch (_) {
    return const _BlurCheckResult();
  }
}

/// Runs on a background isolate via compute(). Converts one raw camera
/// stream frame (YUV420 -- 3 planes on Android, or a 2-plane NV12-style
/// frame on iOS) into a small RGB JPEG the existing detector pipeline
/// already knows how to read (ModelManager().predictBytes). Downscaling to
/// [targetWidth] here (not after) is what keeps each live tick cheap --
/// converting at full sensor resolution would cost far more than the
/// inference itself.
///
/// [rotationDegrees] should be the camera's sensorOrientation (typically
/// 90 for a phone's back camera held in portrait). If live boxes come out
/// sideways/upside-down on a given device, that's the constant to check --
/// this couldn't be verified against real hardware while building it.
Uint8List? _convertCameraFrameToJpeg(Map<String, dynamic> args) {
  try {
    final int width = args['width'] as int;
    final int height = args['height'] as int;
    final List<dynamic> planes = args['planes'] as List<dynamic>;
    final int rotationDegrees = args['rotationDegrees'] as int;
    final int targetWidth = args['targetWidth'] as int;

    final Map yPlane = planes[0] as Map;
    final Uint8List yBytes = yPlane['bytes'] as Uint8List;
    final int yRowStride = yPlane['bytesPerRow'] as int;

    final Uint8List uBytes;
    final Uint8List vBytes;
    final int uvRowStride;
    final int uvPixelStride;
    // Android's yuv420 format group usually delivers 3 separate planes
    // (Y, U, V), each with its own pixel stride. iOS's yuv420 group
    // delivers 2 planes (Y, and interleaved UV -- NV12 order), so treat
    // anything with fewer than 3 planes as that layout instead.
    final bool threePlane = planes.length >= 3;
    if (threePlane) {
      final Map uPlane = planes[1] as Map;
      final Map vPlane = planes[2] as Map;
      uBytes = uPlane['bytes'] as Uint8List;
      vBytes = vPlane['bytes'] as Uint8List;
      uvRowStride = uPlane['bytesPerRow'] as int;
      uvPixelStride = (uPlane['bytesPerPixel'] as int?) ?? 1;
    } else {
      final Map uvPlane = planes[1] as Map;
      final Uint8List uv = uvPlane['bytes'] as Uint8List;
      uBytes = uv;
      vBytes = uv;
      uvRowStride = uvPlane['bytesPerRow'] as int;
      uvPixelStride = 2;
    }

    // Sample directly at (approximately) targetWidth instead of building a
    // full sensor-resolution image first and downscaling after -- a live
    // tick only ever needs a small frame, and converting every source pixel
    // just to throw most of them away in a resize step afterward was most
    // of this function's cost per tick.
    final double scale = width > targetWidth ? targetWidth / width : 1.0;
    final int outW = (width * scale).round().clamp(1, width);
    final int outH = (height * scale).round().clamp(1, height);

    final out = img.Image(width: outW, height: outH);
    for (int oy = 0; oy < outH; oy++) {
      final int y = (oy / scale).floor().clamp(0, height - 1);
      final int yRow = y * yRowStride;
      final int uvRow = (y >> 1) * uvRowStride;
      for (int ox = 0; ox < outW; ox++) {
        final int x = (ox / scale).floor().clamp(0, width - 1);
        final int yIndex = yRow + x;
        if (yIndex >= yBytes.length) continue;
        final int uvIndex = uvRow + (x >> 1) * uvPixelStride;

        final int yVal = yBytes[yIndex];
        int uVal, vVal;
        if (threePlane) {
          if (uvIndex >= uBytes.length || uvIndex >= vBytes.length) continue;
          uVal = uBytes[uvIndex];
          vVal = vBytes[uvIndex];
        } else {
          // NV12: U then V interleaved in the same buffer.
          if (uvIndex + 1 >= uBytes.length) continue;
          uVal = uBytes[uvIndex];
          vVal = uBytes[uvIndex + 1];
        }

        final double yy = yVal.toDouble();
        final double uu = uVal.toDouble() - 128.0;
        final double vv = vVal.toDouble() - 128.0;
        final int r = (yy + 1.402 * vv).round().clamp(0, 255);
        final int g = (yy - 0.344136 * uu - 0.714136 * vv).round().clamp(0, 255);
        final int b = (yy + 1.772 * uu).round().clamp(0, 255);
        out.setPixelRgb(ox, oy, r, g, b);
      }
    }

    // Rotating the already-small image here is cheap -- this is the same
    // img.copyRotate call as before, just no longer applied to a
    // full-resolution frame.
    img.Image rotated = out;
    if (rotationDegrees == 90 || rotationDegrees == 180 || rotationDegrees == 270) {
      rotated = img.copyRotate(out, angle: rotationDegrees);
    }

    return Uint8List.fromList(img.encodeJpg(rotated, quality: 75));
  } catch (_) {
    return null;
  }
}

class LiveInspectionCameraScreen extends StatefulWidget {
  final String vin;
  final String modelCode;
  final List<dynamic> tasks;
  final int initialIndex;

  const LiveInspectionCameraScreen({
    super.key,
    required this.vin,
    required this.modelCode,
    required this.tasks,
    required this.initialIndex,
  });

  @override
  State<LiveInspectionCameraScreen> createState() => _LiveInspectionCameraScreenState();
}

class _LiveInspectionCameraScreenState extends State<LiveInspectionCameraScreen>
    with WidgetsBindingObserver {
  CameraController? _cameraController;
  bool _isCameraInitialized = false;
  Uint8List? _capturedImageBytes;
  Size? _capturedImageSize;
  DetectionResult? _bestResult;
  bool _isAnalyzing = false;
  bool _isModelLoaded = false;
  bool _isLoadingModel = true;
  String? _error;

  List<String> _debugLogs = [];
  bool _showDebugConsole = false;
  bool _isFlashOn = false;

  CameraDescription? _backCamera;
  List<DetectionResult> _allDetections = [];
  List<DetectionResult> _detectedNonTargetClasses = [];
  int _currentIndex = 0;
  final Map<int, dynamic> _results = {};

  // Live-watch state. _holdCount fills toward _holdTarget every consecutive
  // watch tick that sees the current task's target class confidently; any
  // tick that doesn't resets it to 0. Hitting the target auto-fires the
  // full capture+analyze pipeline exactly once (_watchActive guards against
  // a second auto-fire while that capture is still in flight). If the
  // target is never held for long enough, the 45s deadline below fires the
  // same pipeline anyway on whatever the camera currently sees, landing on
  // the normal not-found result.
  bool _watchActive = false;
  bool _watching = false;
  int _holdCount = 0;
  static const int _holdTarget = 3;
  static const double _watchConfidenceThreshold = 0.55;
  static const Duration _watchInterval = Duration(milliseconds: 700);
  static const Duration _watchTimeout = Duration(seconds: 45);
  DateTime? _watchDeadline;

  // Streaming: the watch/sim ticks below no longer call takePicture() per
  // tick (a full shutter + JPEG round trip, measured ~2s per tick on a real
  // device) -- instead CameraController.startImageStream keeps
  // _latestFrame updated with whatever the sensor currently sees, cheaply,
  // and each tick just converts whatever's in it to a small JPEG on a
  // background isolate. A tick that finds no frame yet (stream still
  // warming up) just skips itself rather than blocking.
  CameraImage? _latestFrame;
  bool _isStreaming = false;

  // Simultaneous scan mode -- the primary path when every task in this run
  // shares one tflite/labels pair (the real-world case: one detector, many
  // target classes). One continuous watch loop checks ALL still-pending
  // tasks against each tick's detections; whichever task locks on first
  // auto-captures in the background without freezing the feed, while the
  // rest keep scanning, until every task resolves or the shared 45s
  // deadline hits. Tasks that don't all share a model fall back to the
  // sequential per-task flow above (_startWatching/_watchLoop) unchanged.
  bool _simultaneousMode = false;
  bool _simScanActive = false;
  bool _simScanDone = false;
  bool _simTicking = false;
  bool _simCapturingTask = false;
  DateTime? _simDeadline;
  final Map<int, String> _taskStatus = {}; // 'pending' | 'found' | 'notFound'
  final Map<int, int> _taskHoldCount = {};
  List<DetectionResult> _liveTickDetections = [];

  @override
  void initState() {
    super.initState();
    _currentIndex = widget.initialIndex;
    WidgetsBinding.instance.addObserver(this);
    _simultaneousMode = widget.tasks.length > 1 &&
        widget.tasks.every((t) =>
            t['tflite_path'] == widget.tasks[0]['tflite_path'] &&
            t['labels_path'] == widget.tasks[0]['labels_path']);
    for (var i = 0; i < widget.tasks.length; i++) {
      _taskStatus[i] = 'pending';
      _taskHoldCount[i] = 0;
    }
    _initializeCamera();
    if (_simultaneousMode) {
      _loadSharedModelAndStartSim();
    } else {
      _loadCurrentModel();
    }
    _addLog("Live Scan screen initialized for {% if scan_type == "engine" %}Engine No{% else %}VIN{% endif %}: ${widget.vin}");
  }

  void _addLog(String msg) {
    if (!mounted) return;
    setState(() {
      _debugLogs.insert(
          0, "${DateTime.now().toString().split('.').first.split(' ').last} | $msg");
      if (_debugLogs.length > 50) _debugLogs.removeLast();
    });
    debugPrint(msg);
  }

  bool _isNotOkClass(String? className) {
    if (className == null) return false;
    final cn = className.toLowerCase().replaceAll('_', ' ').replaceAll('-', ' ');
    return cn.contains('not') && cn.contains('ok');
  }

  bool _isPass(String? className, List<String> targetClasses) {
    if (className == null) return false;
    if (_isNotOkClass(className)) return false;
    final cn = className.toLowerCase().trim();
    return targetClasses.any((tc) => tc.toLowerCase().trim() == cn);
  }

  bool _simTaskPasses(dynamic task, List<DetectionResult> confident) {
    final List<String> targetClasses = List<String>.from(task['classes'] ?? []);
    return confident.any((d) =>
        !_isNotOkClass(d.className) &&
        targetClasses.any((tc) => tc.toLowerCase().trim() == d.className.toLowerCase().trim()));
  }

  /// Background full-quality capture+save for one task, fired once its hold
  /// counter reaches target. Deliberately skips the blur-retry dialog the
  /// manual/sequential flow shows -- this must not interrupt the feed or
  /// block on user input; a blurry auto-capture just lands as whatever
  /// pass/fail it detects, same as any other tick's result would.
  Future<void> _autoCaptureSimTask(int index) async {
    final task = widget.tasks[index];
    try {
      _addLog('--- Sim auto-capture: ${task['name']} ---');
      final XFile image = await _takeFullQualityPicture();
      final bytes = await image.readAsBytes();
      final decodedRaw = img.decodeImage(bytes);
      final oriented = decodedRaw != null ? img.bakeOrientation(decodedRaw) : null;

      final allDetections = oriented != null
          ? await ModelManager().predictImage(oriented)
          : await ModelManager().predictBytes(bytes);

      final List<String> targetClasses = List<String>.from(task['classes'] ?? []);
      final filtered = allDetections
          .where((d) => targetClasses.any((tc) => d.className.toLowerCase().trim() == tc.toLowerCase().trim()))
          .toList()
        ..sort((a, b) => b.confidence.compareTo(a.confidence));
      final DetectionResult? winner = filtered.isNotEmpty
          ? filtered.first
          : (allDetections.isNotEmpty
              ? (List<DetectionResult>.from(allDetections)..sort((a, b) => b.confidence.compareTo(a.confidence))).first
              : null);
      final bool isPass = filtered.isNotEmpty;

      String? savedImagePath;
      String? savedBackupPath;
      String? savedNegativePath;
      try {
        PermissionStatus status = await Permission.photos.request();
        if (!status.isGranted) status = await Permission.storage.request();

        final baseDir = Directory('/storage/emulated/0/Pictures');
        if (!await baseDir.exists()) await baseDir.create(recursive: true);
        final safeVin = widget.vin.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final safeTask = (task['name'] as String? ?? 'task').replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final appName = '{{ app_name }}'.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final imgDir = Directory('${baseDir.path}/MAI/$appName/Inspections/$safeVin/$safeTask');
        await imgDir.create(recursive: true);

        final resultLabel = winner != null
            ? winner.className.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_')
            : 'no_detection';

        final now = DateTime.now();
        final dateStr =
            '${now.year}-${now.month.toString().padLeft(2, '0')}-${now.day.toString().padLeft(2, '0')}';
        final timeStr =
            '${now.hour.toString().padLeft(2, '0')}-${now.minute.toString().padLeft(2, '0')}-${now.second.toString().padLeft(2, '0')}';
        final resultBadge = isPass ? 'OK' : 'NOT_OK';
        savedImagePath = '${imgDir.path}/${safeTask}_${resultLabel}_${resultBadge}_${dateStr}_$timeStr.jpg';

        List<int> compressed;
        if (decodedRaw != null) {
          final iw = decodedRaw.width.toDouble();
          final ih = decodedRaw.height.toDouble();
          for (final det in allDetections) {
            final isTarget = targetClasses.any((tc) => det.className.toLowerCase().trim() == tc.toLowerCase().trim());
            final boxColor = isTarget ? img.ColorRgb8(0, 200, 0) : img.ColorRgb8(220, 0, 0);
            final x1 = (det.bbox.left * iw).toInt().clamp(0, decodedRaw.width - 1);
            final y1 = (det.bbox.top * ih).toInt().clamp(0, decodedRaw.height - 1);
            final x2 = (det.bbox.right * iw).toInt().clamp(0, decodedRaw.width - 1);
            final y2 = (det.bbox.bottom * ih).toInt().clamp(0, decodedRaw.height - 1);
            for (int t = 0; t < 3; t++) {
              img.drawRect(decodedRaw, x1: x1 + t, y1: y1 + t, x2: x2 - t, y2: y2 - t, color: boxColor);
            }
            final label = '${det.className} ${(det.confidence * 100).toStringAsFixed(0)}%';
            final labelY = (y1 - 20).clamp(0, decodedRaw.height - 20);
            img.fillRect(decodedRaw, x1: x1, y1: labelY, x2: x1 + label.length * 8 + 6, y2: labelY + 18, color: boxColor);
            img.drawString(decodedRaw, label, font: img.arial14, x: x1 + 3, y: labelY + 2, color: img.ColorRgb8(255, 255, 255));
          }
          compressed = img.encodeJpg(decodedRaw, quality: 40);
        } else {
          compressed = bytes;
        }
        await File(savedImagePath).writeAsBytes(compressed, flush: true);
        _addLog("Sim image saved [${task['name']}]: $savedImagePath");

        try {
          final appDir = await getApplicationSupportDirectory();
          final backupDir = Directory('${appDir.path}/inspection_backups/$safeVin/$safeTask');
          await backupDir.create(recursive: true);
          final backupFile = File('${backupDir.path}/${safeTask}_${resultLabel}_${resultBadge}_${dateStr}_$timeStr.jpg');
          if (decodedRaw != null) {
            final thumb = img.copyResize(decodedRaw, width: 480);
            await backupFile.writeAsBytes(img.encodeJpg(thumb, quality: 15), flush: true);
          } else {
            await backupFile.writeAsBytes(compressed, flush: true);
          }
          savedBackupPath = backupFile.path;
        } catch (e) {
          _addLog("Sim backup save FAILED: $e");
        }

        // NOT OK captures only: keep a near-original-quality copy in a
        // parallel folder tree for building a negative-example dataset.
        if (!isPass && decodedRaw != null) {
          try {
            final negDir = Directory('${baseDir.path}/MAI/$appName/NegativeDataset/$safeVin/$safeTask');
            await negDir.create(recursive: true);
            final negFile = File('${negDir.path}/${resultLabel}_${dateStr}_$timeStr.jpg');
            await negFile.writeAsBytes(img.encodeJpg(decodedRaw, quality: 95), flush: true);
            savedNegativePath = negFile.path;
          } catch (e) {
            _addLog("Sim negative dataset save FAILED: $e");
          }
        }
      } catch (e) {
        _addLog("Sim image save FAILED: $e");
        savedImagePath = null;
      }

      _results[index] = {
        'className': winner?.className ?? 'None',
        'success': isPass,
        'imagePath': savedImagePath,
        'backupImagePath': savedBackupPath,
        'negativeImagePath': savedNegativePath,
        'detectionsJson': winner != null ? jsonEncode([winner.toJson()]) : jsonEncode([]),
      };
      if (mounted) setState(() => _taskStatus[index] = 'found');
      _addLog("Sim task done [${task['name']}]: ${isPass ? 'OK' : 'NOT OK'}");
    } catch (e) {
      _addLog('Sim auto-capture failed for ${task['name']}: $e');
    }
  }

  Future<void> _loadCurrentModel() async {
    setState(() {
      _isLoadingModel = true;
      _isModelLoaded = false;
    });
    try {
      final task = widget.tasks[_currentIndex];
      _addLog("Loading Task: ${task['name']}");
      await ModelManager().loadModel(task['tflite_path'], task['labels_path']);
      if (mounted) {
        setState(() {
          _isLoadingModel = false;
          _isModelLoaded = true;
        });
        _addLog("Model loaded. Target: ${task['classes']}");
        _startWatching();
      }
    } catch (e) {
      _addLog("AI Init error: $e");
      if (mounted) setState(() => _error = "AI Init error: $e");
    }
  }

  @override
  void dispose() {
    _watchActive = false;
    _simScanActive = false;
    WidgetsBinding.instance.removeObserver(this);
    if (_isStreaming) {
      _cameraController?.stopImageStream().catchError((_) {});
    }
    if (_isFlashOn) {
      _cameraController?.setFlashMode(FlashMode.off).catchError((_) {});
    }
    _cameraController?.dispose();
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    final ctrl = _cameraController;
    if (ctrl == null || !ctrl.value.isInitialized) return;
    if (state == AppLifecycleState.inactive) {
      _watchActive = false;
      _simScanActive = false;
      if (_isStreaming) {
        ctrl.stopImageStream().catchError((_) {});
        _isStreaming = false;
      }
      if (_isFlashOn) {
        ctrl.setFlashMode(FlashMode.off).catchError((_) {});
        setState(() => _isFlashOn = false);
      }
      ctrl.dispose();
    } else if (state == AppLifecycleState.resumed) {
      _initializeCamera().then((_) {
        if (_simultaneousMode) {
          if (!_simScanDone) _startSimScan();
        } else {
          _startWatching();
        }
      });
    }
  }

  // ResolutionPreset.low, not medium -- see _takeFullQualityPicture below.
  // This controller is what CameraPreview shows and what startImageStream
  // reads frames from; low is plenty since _convertCameraFrameToJpeg
  // downscales every streamed frame further before inference anyway, and a
  // smaller sensor image means less work per frame to begin with.
  // imageFormatGroup is explicit (not left to the platform default) since
  // _convertCameraFrameToJpeg's YUV/NV12 handling assumes it.
  Future<void> _initializeCamera() async {
    try {
      final cameras = await availableCameras();
      if (cameras.isEmpty) {
        _addLog('No cameras found');
        if (mounted) setState(() => _error = 'No cameras found');
        return;
      }
      final back = cameras.firstWhere(
          (c) => c.lensDirection == CameraLensDirection.back,
          orElse: () => cameras.first);
      _backCamera = back;
      final controller = CameraController(
        back,
        ResolutionPreset.low,
        enableAudio: false,
        imageFormatGroup: ImageFormatGroup.yuv420,
      );
      _cameraController = controller;
      await controller.initialize();
      if (mounted) setState(() => _isCameraInitialized = true);
      _addLog('Camera initialized');
    } catch (e) {
      _addLog("Camera error: $e");
      if (mounted) setState(() => _error = "Camera error: $e");
    }
  }

  /// Takes the one photo that actually gets analyzed, saved and shown on
  /// the review screen -- at full quality, regardless of the low-res
  /// controller the live preview and watch ticks use. Only one
  /// CameraController can hold the camera open at a time, so this briefly
  /// disposes the low-res controller, opens a medium-res one for a single
  /// takePicture(), then hands back to _initializeCamera() to restore the
  /// low-res preview/watch controller. That swap is not its own visible
  /// glitch: _handleCapture already shows a spinner overlay for the
  /// duration, and the preview is about to be replaced by the frozen
  /// result frame anyway.
  Future<XFile> _takeFullQualityPicture() async {
    final camera = _backCamera;
    // takePicture() and an active image stream can't run concurrently on
    // the same controller, and the hi-res swap below needs sole ownership
    // of the camera anyway.
    await _stopImageStream();
    if (camera == null) {
      // Shouldn't happen once the camera has initialized once, but fail
      // toward "still take the photo" rather than a hard crash.
      final pic = await _cameraController!.takePicture();
      if (mounted && (_watchActive || _simScanActive)) _startImageStream();
      return pic;
    }
    final wasFlashOn = _isFlashOn;
    CameraController? hiResController;
    try {
      await _cameraController?.dispose();
      hiResController = CameraController(camera, ResolutionPreset.medium, enableAudio: false);
      await hiResController.initialize();
      if (wasFlashOn) {
        await hiResController.setFlashMode(FlashMode.torch).catchError((_) {});
      }
      return await hiResController.takePicture();
    } finally {
      await hiResController?.dispose();
      if (mounted) await _initializeCamera();
      if (wasFlashOn && mounted) {
        await _cameraController?.setFlashMode(FlashMode.torch).catchError((_) {});
      }
      // Simultaneous mode keeps ticking for the other still-pending tasks
      // while this one's full-quality capture runs in the background, so
      // the stream needs to come straight back for them. Sequential mode
      // already sets _watchActive false before calling this (retake/next
      // task/timeout paths restart it themselves via _startWatching), so
      // this is a no-op there.
      if (mounted && (_watchActive || _simScanActive)) _startImageStream();
    }
  }

  /// Cheap per-frame callback for CameraController.startImageStream --
  /// just remembers the latest frame. The actual conversion+inference work
  /// happens on the watch/sim tick's own cadence (see _watchLoop /
  /// _simWatchLoop), reading whatever _latestFrame currently holds, so this
  /// callback itself stays effectively free and never falls behind the
  /// sensor's frame rate even while a previous tick is still busy.
  void _startImageStream() {
    if (_isStreaming || _cameraController == null || !_isCameraInitialized) return;
    try {
      _cameraController!.startImageStream((image) => _latestFrame = image);
      _isStreaming = true;
    } catch (e) {
      _addLog('startImageStream failed: $e');
    }
  }

  Future<void> _stopImageStream() async {
    if (!_isStreaming) return;
    try {
      await _cameraController?.stopImageStream();
    } catch (_) {}
    _isStreaming = false;
    _latestFrame = null;
  }

  /// Starts the live-watch loop: every [_watchInterval], while nothing else
  /// is going on, read the latest live-stream frame and run it through the same
  /// detector already loaded for this task. This is deliberately the exact
  /// same detection call _handleCapture() uses, just without the blur
  /// dialog or the save-to-disk work -- those only need to happen once, on
  /// the frame that's actually kept. [_watchDeadline] resets here every
  /// time watching (re)starts -- new task, retake, or resume from
  /// backgrounding -- so a task that never finds its target still
  /// auto-captures within 45s instead of watching forever.
  void _startWatching() {
    if (_watchActive) return;
    _watchActive = true;
    _holdCount = 0;
    _watchDeadline = DateTime.now().add(_watchTimeout);
    _startImageStream();
    _watchLoop();
  }

  void _stopWatching() {
    _watchActive = false;
    if (mounted) setState(() => _holdCount = 0);
  }

  int _watchSecondsLeft() {
    final deadline = _watchDeadline;
    if (deadline == null) return 0;
    final left = deadline.difference(DateTime.now()).inSeconds;
    return left < 0 ? 0 : left;
  }

  int _simSecondsLeft() {
    final deadline = _simDeadline;
    if (deadline == null) return 0;
    final left = deadline.difference(DateTime.now()).inSeconds;
    return left < 0 ? 0 : left;
  }

  /// Loads the ONE model shared by every task in this run (the real-world
  /// shape: one detector, many target classes) and starts the simultaneous
  /// watch loop once it's ready.
  Future<void> _loadSharedModelAndStartSim() async {
    setState(() {
      _isLoadingModel = true;
      _isModelLoaded = false;
    });
    try {
      final task = widget.tasks[0];
      _addLog("Simultaneous scan: loading shared model for ${widget.tasks.length} tasks");
      await ModelManager().loadModel(task['tflite_path'], task['labels_path']);
      if (mounted) {
        setState(() {
          _isLoadingModel = false;
          _isModelLoaded = true;
        });
        _startSimScan();
      }
    } catch (e) {
      _addLog("AI Init error: $e");
      if (mounted) setState(() => _error = "AI Init error: $e");
    }
  }

  void _startSimScan() {
    if (_simScanActive) return;
    _simScanActive = true;
    _simDeadline = DateTime.now().add(_watchTimeout);
    _startImageStream();
    _simWatchLoop();
  }

  /// One continuous loop for the whole task list: every tick reads the
  /// latest live-stream frame, runs it through the shared model once, then checks
  /// EVERY still-pending task's classes against that one tick's detections.
  /// A task whose hold counter reaches target fires its own background
  /// full-quality capture+save (_autoCaptureSimTask) without pausing this
  /// loop for the others. On the shared 45s deadline, every still-pending
  /// task is marked not-found and the loop stops.
  Future<void> _simWatchLoop() async {
    while (_simScanActive && mounted) {
      await Future.delayed(_watchInterval);
      if (!_simScanActive || !mounted) return;
      if (_simTicking || !_isModelLoaded || _cameraController == null || !_isCameraInitialized) {
        continue;
      }
      if (_simDeadline != null && DateTime.now().isAfter(_simDeadline!)) {
        _finishSimTimeouts();
        return;
      }
      _simTicking = true;
      final tickStopwatch = Stopwatch()..start();
      try {
        final frame = _latestFrame;
        if (frame == null) {
          // Stream still warming up (or briefly paused around a
          // full-quality capture) -- skip this tick rather than block.
          tickStopwatch.stop();
          continue;
        }
        final int sensorOrientation = _cameraController?.description.sensorOrientation ?? 90;
        final bytes = await compute(_convertCameraFrameToJpeg, {
          'width': frame.width,
          'height': frame.height,
          'planes': frame.planes
              .map((p) => {
                    'bytes': p.bytes,
                    'bytesPerRow': p.bytesPerRow,
                    'bytesPerPixel': p.bytesPerPixel ?? 1,
                  })
              .toList(),
          'rotationDegrees': sensorOrientation,
          'targetWidth': 480,
        });
        if (bytes == null) continue;
        final detections = await ModelManager().predictBytes(bytes);
        tickStopwatch.stop();
        _addLog("Sim tick: ${tickStopwatch.elapsedMilliseconds}ms, ${detections.length} detections");

        if (!mounted || !_simScanActive) return;
        final confident = detections.where((d) => d.confidence >= _watchConfidenceThreshold).toList();
        // Only boxes for still-pending tasks' own target classes are shown
        // -- an already-found task doesn't need to keep drawing, and a
        // confident detection of some unrelated class would otherwise show
        // as a box that looks like progress but isn't for anything this
        // scan still needs.
        final pendingTargetClasses = <String>{
          for (var i = 0; i < widget.tasks.length; i++)
            if (_taskStatus[i] == 'pending')
              ...List<String>.from(widget.tasks[i]['classes'] ?? [])
                  .map((c) => c.toLowerCase().trim()),
        };
        setState(() => _liveTickDetections = confident
            .where((d) => pendingTargetClasses.contains(d.className.toLowerCase().trim()))
            .toList());

        int? matchedTaskIndex;
        for (var i = 0; i < widget.tasks.length; i++) {
          if (_taskStatus[i] != 'pending') continue;
          final tickPass = _simTaskPasses(widget.tasks[i], confident);
          if (tickPass) {
            _taskHoldCount[i] = (_taskHoldCount[i] ?? 0) + 1;
            if (_taskHoldCount[i]! >= _holdTarget && matchedTaskIndex == null) {
              matchedTaskIndex = i;
            }
          } else if ((_taskHoldCount[i] ?? 0) != 0) {
            _taskHoldCount[i] = 0;
          }
        }
        if (mounted) setState(() {});

        if (matchedTaskIndex != null && !_simCapturingTask) {
          final idx = matchedTaskIndex;
          _addLog("Sim: task ${idx + 1} steady -- auto-capturing in background");
          _simCapturingTask = true;
          // Fire-and-forget: the watch loop keeps ticking for the other
          // pending tasks while this one's full-quality capture+save runs.
          unawaited(_autoCaptureSimTask(idx).whenComplete(() {
            _simCapturingTask = false;
            _maybeFinishSimScan();
          }));
        }
      } catch (e) {
        _addLog("Sim tick failed: $e");
      } finally {
        _simTicking = false;
      }
    }
  }

  void _finishSimTimeouts() {
    _simScanActive = false;
    for (var i = 0; i < widget.tasks.length; i++) {
      if (_taskStatus[i] == 'pending') {
        _taskStatus[i] = 'notFound';
        _results[i] ??= {
          'className': 'None',
          'success': false,
          'imagePath': null,
          'detectionsJson': jsonEncode([]),
        };
        _addLog("Sim: task ${i + 1} (${widget.tasks[i]['name']}) NOT FOUND at 45s deadline");
      }
    }
    if (mounted) setState(() => _simScanDone = true);
  }

  void _maybeFinishSimScan() {
    if (!mounted || !_simScanActive) return;
    final allResolved = widget.tasks
        .asMap()
        .keys
        .every((i) => _taskStatus[i] != 'pending');
    if (allResolved) {
      _simScanActive = false;
      setState(() => _simScanDone = true);
      _addLog('Sim: all tasks resolved');
    }
  }

  /// Small fallback for when auto-detect never locks on: forces an
  /// immediate full-quality capture attempt for the first still-pending
  /// task, using the same background pipeline the watch loop uses.
  Future<void> _manualSimCapture() async {
    if (_simCapturingTask || !_simScanActive) return;
    final pendingEntry = _taskStatus.entries.firstWhere(
      (e) => e.value == 'pending',
      orElse: () => const MapEntry(-1, ''),
    );
    if (pendingEntry.key < 0) return;
    _simCapturingTask = true;
    _addLog('Manual capture for task ${pendingEntry.key + 1}');
    await _autoCaptureSimTask(pendingEntry.key);
    _simCapturingTask = false;
    _maybeFinishSimScan();
  }

  void _retrySimScan() {
    setState(() {
      for (var i = 0; i < widget.tasks.length; i++) {
        _taskStatus[i] = 'pending';
        _taskHoldCount[i] = 0;
      }
      _results.clear();
      _simScanDone = false;
      _liveTickDetections = [];
    });
    _startSimScan();
  }

  Future<void> _watchLoop() async {
    while (_watchActive && mounted) {
      await Future.delayed(_watchInterval);
      if (!_watchActive || !mounted) return;
      if (_isAnalyzing || _watching || _capturedImageBytes != null ||
          !_isModelLoaded || _cameraController == null || !_isCameraInitialized) {
        continue;
      }
      if (_watchDeadline != null && DateTime.now().isAfter(_watchDeadline!)) {
        _watchActive = false;
        setState(() => _holdCount = 0);
        _addLog('Live watch: 45s elapsed with no confident match -- auto-capturing anyway');
        await _handleCapture();
        return;
      }
      _watching = true;
      // Reads the latest CameraController.startImageStream frame instead of
      // calling takePicture() -- a full shutter + JPEG round trip was the
      // real floor on tick speed before (measured ~2s per tick on device).
      // The frame is already sitting in memory, so a tick now costs only
      // the isolate conversion + inference.
      final tickStopwatch = Stopwatch()..start();
      try {
        final frame = _latestFrame;
        if (frame == null) {
          // Stream still warming up (or briefly paused around a
          // full-quality capture) -- skip this tick rather than block.
          tickStopwatch.stop();
          continue;
        }
        final int sensorOrientation = _cameraController?.description.sensorOrientation ?? 90;
        final bytes = await compute(_convertCameraFrameToJpeg, {
          'width': frame.width,
          'height': frame.height,
          'planes': frame.planes
              .map((p) => {
                    'bytes': p.bytes,
                    'bytesPerRow': p.bytesPerRow,
                    'bytesPerPixel': p.bytesPerPixel ?? 1,
                  })
              .toList(),
          'rotationDegrees': sensorOrientation,
          'targetWidth': 480,
        });
        if (bytes == null) continue;
        final detections = await ModelManager().predictBytes(bytes);
        tickStopwatch.stop();
        final tickSummary = detections.isEmpty
            ? 'none'
            : detections.map((d) => '${d.className} ${(d.confidence * 100).toStringAsFixed(0)}%').join(', ');
        _addLog("Watch tick: ${tickStopwatch.elapsedMilliseconds}ms, ${detections.length} detections ($tickSummary)");

        final currentTask = widget.tasks[_currentIndex];
        final List<String> targetClasses = List<String>.from(currentTask['classes'] ?? []);
        final match = detections.where((d) =>
            d.confidence >= _watchConfidenceThreshold &&
            targetClasses.any((tc) => d.className.toLowerCase().trim() == tc.toLowerCase().trim()) &&
            !_isNotOkClass(d.className));
        // Drawn live over the preview below -- without this the feed looks
        // static for the whole hold-steady countdown even while it's
        // actually seeing and tracking the part. Only the target-class
        // match is shown (not every confident detection of anything) and
        // forced green, so a visible box actually means "this is
        // progressing toward capture", not just "something was seen".
        if (mounted) {
          setState(() => _liveTickDetections = match.toList());
        }

        if (!mounted || !_watchActive) return;
        if (match.isNotEmpty) {
          setState(() => _holdCount++);
          _addLog("Live watch: target seen (${_holdCount}/${_holdTarget})");
          if (_holdCount >= _holdTarget) {
            _watchActive = false;
            setState(() => _holdCount = 0);
            _addLog('Live watch: steady -- auto-capturing');
            await _handleCapture();
            return;
          }
        } else if (_holdCount != 0) {
          setState(() => _holdCount = 0);
        } else {
          // Force a rebuild even with nothing else changing, so the
          // on-screen countdown keeps ticking down.
          setState(() {});
        }
      } catch (e) {
        _addLog("Live watch tick failed: $e");
      } finally {
        _watching = false;
      }
    }
  }

  Future<void> _handleCapture() async {
    if (_isAnalyzing || !_isModelLoaded || _cameraController == null) {
      _addLog("Capture blocked: analyzing=$_isAnalyzing modelReady=$_isModelLoaded");
      return;
    }
    _watchActive = false;
    setState(() => _isAnalyzing = true);
    try {
      _addLog('--- Start Inference ---');
      final XFile image = await _takeFullQualityPicture();
      final bytes = await image.readAsBytes();

      Size? imageSize;
      img.Image? orientedImage;
      final blurCheck = await compute(_decodeAndCheckBlur, bytes);
      if (blurCheck.orientedPngBytes != null) {
        try {
          final oriented = img.decodeImage(blurCheck.orientedPngBytes!);
          if (oriented != null) {
            orientedImage = oriented;
            imageSize = Size(oriented.width.toDouble(), oriented.height.toDouble());
          }
        } catch (_) {}
      }
      if (blurCheck.variance != null) {
        final blurVariance = blurCheck.variance!;
        _addLog("Blur variance: ${blurVariance.toStringAsFixed(1)}");
        if (blurVariance < 150.0 && mounted) {
          await showDialog(
            context: context,
            barrierDismissible: false,
            builder: (_) => AlertDialog(
              backgroundColor: const Color(0xFF1A1A24),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
              title: const Row(children: [
                Icon(Icons.blur_on, color: Color(0xFFDC143C)),
                SizedBox(width: 8),
                Text('Image Not Clear', style: TextStyle(color: Colors.white, fontSize: 18)),
              ]),
              content: const Text(
                'The photo appears blurry or out of focus.\nHold steady -- resuming live scan.',
                style: TextStyle(color: Colors.white70, height: 1.5),
              ),
              actions: [
                ElevatedButton.icon(
                  onPressed: () => Navigator.pop(context),
                  icon: const Icon(Icons.camera_alt, color: Colors.white, size: 18),
                  label: const Text('OK', style: TextStyle(color: Colors.white)),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFFDC143C),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                  ),
                ),
              ],
            ),
          );
          if (mounted) setState(() => _isAnalyzing = false);
          _startWatching();
          return;
        }
      }

      setState(() {
        _bestResult = null;
        _capturedImageBytes = bytes;
        _capturedImageSize = imageSize;
      });

      final currentTask = widget.tasks[_currentIndex];
      final List<String> targetClasses = List<String>.from(currentTask['classes'] ?? []);
      _addLog("Target: ${targetClasses.join(', ')}");

      final allDetections = orientedImage != null
          ? await ModelManager().predictImage(orientedImage, orientedPngBytes: blurCheck.orientedPngBytes)
          : await ModelManager().predictBytes(bytes);
      setState(() => _allDetections = [
            ...allDetections,
            for (final d in allDetections) ...?d.ocrCharBoxes,
          ]);

      String? savedImagePath;
      String? savedBackupPath;
      String? savedNegativePath;

      _addLog("Detections: ${allDetections.length}");
      for (final d in allDetections) {
        _addLog("  ${d.className} ${(d.confidence * 100).toStringAsFixed(1)}%");
      }

      final filtered = allDetections
          .where((d) => targetClasses.any((tc) =>
              d.className.toLowerCase().trim() == tc.toLowerCase().trim()))
          .toList();
      _addLog("Matched target: ${filtered.length}");

      try {
        PermissionStatus status = await Permission.photos.request();
        if (!status.isGranted) {
          status = await Permission.storage.request();
        }

        final baseDir = Directory('/storage/emulated/0/Pictures');
        if (!await baseDir.exists()) await baseDir.create(recursive: true);

        final safeVin = widget.vin.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final currentTaskName = currentTask['name'] as String? ?? 'task';
        final safeTask = currentTaskName.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final appName = '{{ app_name }}'.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final imgDir = Directory('${baseDir.path}/MAI/$appName/Inspections/$safeVin/$safeTask');
        await imgDir.create(recursive: true);

        final topDetection = filtered.isNotEmpty
            ? filtered.first
            : (allDetections.isNotEmpty ? allDetections.first : null);
        final resultLabel = topDetection != null
            ? topDetection.className.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_')
            : 'no_detection';
        final isPass = filtered.isNotEmpty;

        final now = DateTime.now();
        final dateStr =
            '${now.year}-${now.month.toString().padLeft(2, '0')}-${now.day.toString().padLeft(2, '0')}';
        final timeStr =
            '${now.hour.toString().padLeft(2, '0')}-${now.minute.toString().padLeft(2, '0')}-${now.second.toString().padLeft(2, '0')}';
        final resultBadge = isPass ? 'OK' : 'NOT_OK';
        savedImagePath = '${imgDir.path}/${safeTask}_${resultLabel}_${resultBadge}_${dateStr}_$timeStr.jpg';

        final decoded = img.decodeImage(bytes);
        List<int> compressed;
        if (decoded != null) {
          final iw = decoded.width.toDouble();
          final ih = decoded.height.toDouble();

          for (final det in allDetections) {
            final isTarget = targetClasses.any(
              (tc) => det.className.toLowerCase().trim() == tc.toLowerCase().trim(),
            );
            final boxColor = isTarget ? img.ColorRgb8(0, 200, 0) : img.ColorRgb8(220, 0, 0);

            final x1 = (det.bbox.left * iw).toInt().clamp(0, decoded.width - 1);
            final y1 = (det.bbox.top * ih).toInt().clamp(0, decoded.height - 1);
            final x2 = (det.bbox.right * iw).toInt().clamp(0, decoded.width - 1);
            final y2 = (det.bbox.bottom * ih).toInt().clamp(0, decoded.height - 1);

            for (int t = 0; t < 3; t++) {
              img.drawRect(decoded, x1: x1 + t, y1: y1 + t, x2: x2 - t, y2: y2 - t, color: boxColor);
            }

            final label = '${det.className} ${(det.confidence * 100).toStringAsFixed(0)}%';
            final labelY = (y1 - 20).clamp(0, decoded.height - 20);
            img.fillRect(decoded, x1: x1, y1: labelY, x2: x1 + label.length * 8 + 6, y2: labelY + 18, color: boxColor);
            img.drawString(decoded, label, font: img.arial14, x: x1 + 3, y: labelY + 2, color: img.ColorRgb8(255, 255, 255));
          }

          compressed = img.encodeJpg(decoded, quality: 40);
        } else {
          compressed = bytes;
        }
        await File(savedImagePath).writeAsBytes(compressed, flush: true);
        _addLog("Image saved: $savedImagePath");

        try {
          final appDir = await getApplicationSupportDirectory();
          final backupDir = Directory('${appDir.path}/inspection_backups/$safeVin/$safeTask');
          await backupDir.create(recursive: true);
          final backupFile = File('${backupDir.path}/${safeTask}_${resultLabel}_${resultBadge}_${dateStr}_$timeStr.jpg');
          if (decoded != null) {
            final thumb = img.copyResize(decoded, width: 480);
            await backupFile.writeAsBytes(img.encodeJpg(thumb, quality: 15), flush: true);
          } else {
            await backupFile.writeAsBytes(compressed, flush: true);
          }
          savedBackupPath = backupFile.path;
        } catch (e) {
          _addLog("Backup save FAILED: $e");
        }

        // NOT OK captures only: keep a near-original-quality copy in a
        // parallel folder tree for building a negative-example dataset.
        if (!isPass && decoded != null) {
          try {
            final negDir = Directory('${baseDir.path}/MAI/$appName/NegativeDataset/$safeVin/$safeTask');
            await negDir.create(recursive: true);
            final negFile = File('${negDir.path}/${resultLabel}_${dateStr}_$timeStr.jpg');
            await negFile.writeAsBytes(img.encodeJpg(decoded, quality: 95), flush: true);
            savedNegativePath = negFile.path;
          } catch (e) {
            _addLog("Negative dataset save FAILED: $e");
          }
        }
      } catch (e) {
        _addLog("Image save FAILED: $e");
        savedImagePath = null;
      }

      setState(() {
        if (filtered.isNotEmpty) {
          filtered.sort((a, b) => b.confidence.compareTo(a.confidence));
          _bestResult = filtered.first;
          final pass = _isPass(_bestResult!.className, targetClasses);
          _addLog("WINNER: ${_bestResult!.className} | pass=$pass");

          _results[_currentIndex] = {
            'className': _bestResult!.className,
            'success': pass,
            'imagePath': savedImagePath,
            'backupImagePath': savedBackupPath,
            'negativeImagePath': savedNegativePath,
            'detectionsJson': jsonEncode([_bestResult!.toJson()]),
          };
        } else {
          final nonTarget = List<DetectionResult>.from(allDetections)
            ..sort((a, b) => b.confidence.compareTo(a.confidence));
          _detectedNonTargetClasses = nonTarget.take(1).toList();
          final bestDetected = _detectedNonTargetClasses.isNotEmpty ? _detectedNonTargetClasses.first : null;
          _addLog("NON-TARGET: ${bestDetected?.className ?? 'nothing'}");

          _results[_currentIndex] = {
            'className': bestDetected?.className ?? 'None',
            'success': false,
            'imagePath': savedImagePath,
            'backupImagePath': savedBackupPath,
            'negativeImagePath': savedNegativePath,
            'detectionsJson': bestDetected != null ? jsonEncode([bestDetected.toJson()]) : jsonEncode([]),
          };
        }
        _isAnalyzing = false;
      });
    } catch (e, st) {
      _addLog("ERROR: $e");
      _addLog("  at: ${st.toString().split('\n').take(3).join(' | ')}");
      setState(() => _isAnalyzing = false);
      _startWatching();
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Capture failed: $e')));
      }
    }
  }

  Future<void> _toggleFlash() async {
    if (_cameraController == null || !_isCameraInitialized) return;
    final newOn = !_isFlashOn;
    try {
      await _cameraController!.setFlashMode(newOn ? FlashMode.torch : FlashMode.off);
      setState(() => _isFlashOn = newOn);
      _addLog(newOn ? 'Flash ON' : 'Flash OFF');
    } catch (e) {
      _addLog("Flash error: $e");
    }
  }

  void _retake() {
    _addLog('Retake');
    setState(() {
      _capturedImageBytes = null;
      _capturedImageSize = null;
      _bestResult = null;
      _isAnalyzing = false;
      _allDetections = [];
      _detectedNonTargetClasses = [];
      _liveTickDetections = [];
    });
    _startWatching();
  }

  void _onSaveAndContinue() {
    _results[_currentIndex] ??= {
      'className': 'None',
      'success': false,
      'imagePath': null,
      'detectionsJson': jsonEncode([]),
    };

    if (_results.length == widget.tasks.length) {
      _addLog('All tasks done');
      Navigator.pop(context, _results);
      return;
    }

    final nextIdx = (_currentIndex + 1) % widget.tasks.length;
    _addLog("Moving to Task ${nextIdx + 1}");
    setState(() {
      _currentIndex = nextIdx;
      _capturedImageBytes = null;
      _bestResult = null;
      _detectedNonTargetClasses = [];
    });
    _loadCurrentModel();
  }

