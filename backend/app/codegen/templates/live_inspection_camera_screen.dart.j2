/// Live Scan (Beta) for multiclass/mandatory-class tasks -- mirrors the
/// single-class branch of this file (continuous watch loop, hold counter,
/// 45s not-found timeout) but drives it off the same mandatory/fail/ignored
/// class matching and pass/fail evaluation the normal capture flow uses in
/// inspection_camera_screen.dart.j2. What differs from that file's
/// _handleCapture is only cosmetic (no OCR checklist -- this build's live
/// branch, like its single-class sibling above, doesn't wire up OCR at all);
/// the mandatory/fail/ignored matching and _allMandatoryPassed logic is
/// copied as-is so "pass" means exactly the same thing in both flows.
class _BlurCheckResult {
  final double? variance;
  final Uint8List? orientedPngBytes;
  const _BlurCheckResult({this.variance, this.orientedPngBytes});
}

_BlurCheckResult _decodeAndCheckBlur(Uint8List bytes) {
  try {
    final decoded = img.decodeImage(bytes);
    if (decoded == null) return const _BlurCheckResult();
    final oriented = img.bakeOrientation(decoded);

    final small = img.copyResize(oriented, width: 150, height: 150);
    final gray = img.grayscale(small);
    double sumLap = 0, sumLapSq = 0;
    int count = 0;
    for (int y = 1; y < gray.height - 1; y++) {
      for (int x = 1; x < gray.width - 1; x++) {
        final c = gray.getPixel(x, y).r.toDouble();
        final t = gray.getPixel(x, y - 1).r.toDouble();
        final b = gray.getPixel(x, y + 1).r.toDouble();
        final l = gray.getPixel(x - 1, y).r.toDouble();
        final rv = gray.getPixel(x + 1, y).r.toDouble();
        final lap = t + b + l + rv - 4 * c;
        sumLap += lap;
        sumLapSq += lap * lap;
        count++;
      }
    }
    double? variance;
    if (count > 0) {
      final mean = sumLap / count;
      variance = (sumLapSq / count) - (mean * mean);
    }
    return _BlurCheckResult(
      orientedPngBytes: Uint8List.fromList(img.encodeJpg(oriented, quality: 92)),
    );
  } catch (_) {
    return const _BlurCheckResult();
  }
}

class LiveInspectionCameraScreen extends StatefulWidget {
  final String vin;
  final String modelCode;
  final List<dynamic> tasks;
  final int initialIndex;

  const LiveInspectionCameraScreen({
    super.key,
    required this.vin,
    required this.modelCode,
    required this.tasks,
    required this.initialIndex,
  });

  @override
  State<LiveInspectionCameraScreen> createState() => _LiveInspectionCameraScreenState();
}

class _LiveInspectionCameraScreenState extends State<LiveInspectionCameraScreen>
    with WidgetsBindingObserver {
  CameraController? _cameraController;
  bool _isCameraInitialized = false;
  Uint8List? _capturedImageBytes;
  Size? _capturedImageSize;
  DetectionResult? _bestResult;
  bool _isAnalyzing = false;
  bool _isModelLoaded = false;
  bool _isLoadingModel = true;
  String? _error;

  List<String> _debugLogs = [];
  bool _showDebugConsole = false;
  bool _isFlashOn = false;

  CameraDescription? _backCamera;
  List<DetectionResult> _allDetections = [];
  List<DetectionResult> _detectedNonTargetClasses = [];
  // Maps mandatory class name -> best DetectionResult found (null = not detected)
  Map<String, DetectionResult?> _mandatoryClassResults = {};
  // Unchecked classes for current task — detecting any of these = fail
  List<String> _failClasses = [];
  // Maps fail class name -> best DetectionResult found (null = not detected)
  Map<String, DetectionResult?> _failClassResults = {};
  int _currentIndex = 0;
  final Map<int, dynamic> _results = {};

  // Live-watch state. _holdCount fills toward _holdTarget every consecutive
  // watch tick that sees all mandatory classes confidently (and no
  // fail/not-ok class); any tick that doesn't resets it to 0. Hitting the
  // target auto-fires the full capture+analyze pipeline exactly once
  // (_watchActive guards against a second auto-fire while that capture is
  // still in flight). If the target is never held for long enough, the
  // 45s deadline below fires the same pipeline anyway on whatever the
  // camera currently sees, landing on the normal not-found/fail result.
  bool _watchActive = false;
  bool _watching = false;
  int _holdCount = 0;
  static const int _holdTarget = 3;
  static const double _watchConfidenceThreshold = 0.55;
  static const Duration _watchInterval = Duration(milliseconds: 700);
  static const Duration _watchTimeout = Duration(seconds: 45);
  DateTime? _watchDeadline;

  @override
  void initState() {
    super.initState();
    _currentIndex = widget.initialIndex;
    WidgetsBinding.instance.addObserver(this);
    _initializeCamera();
    _loadCurrentModel();
    _addLog("Live Scan screen initialized for {% if scan_type == "engine" %}Engine No{% else %}VIN{% endif %}: ${widget.vin}");
  }

  void _addLog(String msg) {
    if (!mounted) return;
    setState(() {
      _debugLogs.insert(
          0, "${DateTime.now().toString().split('.').first.split(' ').last} | $msg");
      if (_debugLogs.length > 50) _debugLogs.removeLast();
    });
    debugPrint(msg);
  }

  bool _isNotOkClass(String? className) {
    if (className == null) return false;
    final cn = className.toLowerCase().replaceAll('_', ' ').replaceAll('-', ' ');
    return cn.contains('not') && cn.contains('ok');
  }

  // A class the user explicitly marked "Ignore" has no effect on the result
  // at all -- see inspection_camera_screen.dart.j2's identical helper for
  // why this must win over the "not ok" name-substring heuristic.
  bool _isIgnored(String? className, List<String> ignoredClasses) {
    if (className == null) return false;
    final cn = className.toLowerCase().trim();
    return ignoredClasses.any((ig) => ig.toLowerCase().trim() == cn);
  }

  // Returns true only if:
  //  1. ALL pass (checked) classes are detected
  //  2. NO "not ok" class detected (hard block — always fails), unless ignored
  //  3. NO fail (unchecked) class detected — unchecked classes are fail conditions
  bool _allMandatoryPassed(
    Map<String, DetectionResult?> mandatory,
    List<DetectionResult> allDetections,
    List<String> failClasses,
    List<String> ignoredClasses,
  ) {
    if (mandatory.isEmpty) return false;
    if (allDetections.any((d) => _isNotOkClass(d.className) && !_isIgnored(d.className, ignoredClasses))) return false;
    final failNamesLower = failClasses.map((c) => c.toLowerCase().trim()).toSet();
    if (allDetections.any((d) => failNamesLower.contains(d.className.toLowerCase().trim()))) return false;
    if (!mandatory.values.every((r) => r != null)) return false;
    return true;
  }

  /// True only when a genuine defect/wrong part was actually detected (an
  /// explicit "not ok" class, or a fail/unchecked class). False when the
  /// failure is just an absence of detections -- that case is "not found",
  /// not "not ok".
  bool _hasDefectDetected(
    List<DetectionResult> allDetections,
    List<String> failClasses,
    List<String> ignoredClasses,
  ) {
    if (allDetections.any((d) => _isNotOkClass(d.className) && !_isIgnored(d.className, ignoredClasses))) return true;
    final failNamesLower = failClasses.map((c) => c.toLowerCase().trim()).toSet();
    return allDetections.any((d) => failNamesLower.contains(d.className.toLowerCase().trim()));
  }

  Future<void> _loadCurrentModel() async {
    setState(() {
      _isLoadingModel = true;
      _isModelLoaded = false;
    });
    try {
      final task = widget.tasks[_currentIndex];
      _addLog("Loading Task: ${task['name']}");
      await ModelManager().loadModel(task['tflite_path'], task['labels_path']);
      if (mounted) {
        setState(() {
          _isLoadingModel = false;
          _isModelLoaded = true;
        });
        _addLog("Model loaded. Target: ${task['classes']}");
        _startWatching();
      }
    } catch (e) {
      _addLog("AI Init error: $e");
      if (mounted) setState(() => _error = "AI Init error: $e");
    }
  }

  @override
  void dispose() {
    _watchActive = false;
    WidgetsBinding.instance.removeObserver(this);
    if (_isFlashOn) {
      _cameraController?.setFlashMode(FlashMode.off).catchError((_) {});
    }
    _cameraController?.dispose();
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    final ctrl = _cameraController;
    if (ctrl == null || !ctrl.value.isInitialized) return;
    if (state == AppLifecycleState.inactive) {
      _watchActive = false;
      if (_isFlashOn) {
        ctrl.setFlashMode(FlashMode.off).catchError((_) {});
        setState(() => _isFlashOn = false);
      }
      ctrl.dispose();
    } else if (state == AppLifecycleState.resumed) {
      _initializeCamera().then((_) => _startWatching());
    }
  }

  // ResolutionPreset.low, not medium -- see _takeFullQualityPicture below.
  // This controller is what CameraPreview shows and what every watch tick
  // calls takePicture() on, so it being fast matters far more here than for
  // a one-shot manual capture: at ~700ms between ticks, shaving the
  // per-tick JPEG encode/shutter round trip down is the only lever
  // available short of a full CameraController.startImageStream rewrite
  // (out of scope for this pass -- see _watchLoop's comment on that).
  Future<void> _initializeCamera() async {
    try {
      final cameras = await availableCameras();
      if (cameras.isEmpty) {
        _addLog('No cameras found');
        if (mounted) setState(() => _error = 'No cameras found');
        return;
      }
      final back = cameras.firstWhere(
          (c) => c.lensDirection == CameraLensDirection.back,
          orElse: () => cameras.first);
      _backCamera = back;
      final controller = CameraController(back, ResolutionPreset.low, enableAudio: false);
      _cameraController = controller;
      await controller.initialize();
      if (mounted) setState(() => _isCameraInitialized = true);
      _addLog('Camera initialized');
    } catch (e) {
      _addLog("Camera error: $e");
      if (mounted) setState(() => _error = "Camera error: $e");
    }
  }

  /// Takes the one photo that actually gets analyzed, saved and shown on
  /// the review screen -- at full quality, regardless of the low-res
  /// controller the live preview and watch ticks use. Only one
  /// CameraController can hold the camera open at a time, so this briefly
  /// disposes the low-res controller, opens a medium-res one for a single
  /// takePicture(), then hands back to _initializeCamera() to restore the
  /// low-res preview/watch controller. That swap is not its own visible
  /// glitch: _handleCapture already shows a spinner overlay for the
  /// duration, and the preview is about to be replaced by the frozen
  /// result frame anyway.
  Future<XFile> _takeFullQualityPicture() async {
    final camera = _backCamera;
    if (camera == null) {
      // Shouldn't happen once the camera has initialized once, but fail
      // toward "still take the photo" rather than a hard crash.
      return await _cameraController!.takePicture();
    }
    final wasFlashOn = _isFlashOn;
    CameraController? hiResController;
    try {
      await _cameraController?.dispose();
      hiResController = CameraController(camera, ResolutionPreset.medium, enableAudio: false);
      await hiResController.initialize();
      if (wasFlashOn) {
        await hiResController.setFlashMode(FlashMode.torch).catchError((_) {});
      }
      return await hiResController.takePicture();
    } finally {
      await hiResController?.dispose();
      if (mounted) await _initializeCamera();
      if (wasFlashOn && mounted) {
        await _cameraController?.setFlashMode(FlashMode.torch).catchError((_) {});
      }
    }
  }

  /// Starts the live-watch loop: every [_watchInterval], while nothing else
  /// is going on, take a quick picture and run it through the same
  /// detector already loaded for this task, checking it against the same
  /// mandatory/fail/ignored matching the manual capture flow uses. The
  /// [_watchDeadline] resets here every time watching (re)starts -- new
  /// task, retake, or resume from backgrounding -- so a task that never
  /// finds its target still auto-captures within 45s instead of watching
  /// forever.
  void _startWatching() {
    if (_watchActive) return;
    _watchActive = true;
    _holdCount = 0;
    _watchDeadline = DateTime.now().add(_watchTimeout);
    _watchLoop();
  }

  void _stopWatching() {
    _watchActive = false;
    if (mounted) setState(() => _holdCount = 0);
  }

  int _watchSecondsLeft() {
    final deadline = _watchDeadline;
    if (deadline == null) return 0;
    final left = deadline.difference(DateTime.now()).inSeconds;
    return left < 0 ? 0 : left;
  }

  Future<void> _watchLoop() async {
    while (_watchActive && mounted) {
      await Future.delayed(_watchInterval);
      if (!_watchActive || !mounted) return;
      if (_isAnalyzing || _watching || _capturedImageBytes != null ||
          !_isModelLoaded || _cameraController == null || !_isCameraInitialized) {
        continue;
      }
      if (_watchDeadline != null && DateTime.now().isAfter(_watchDeadline!)) {
        _watchActive = false;
        setState(() => _holdCount = 0);
        _addLog('Live watch: 45s elapsed with no confident match -- auto-capturing anyway');
        await _handleCapture();
        return;
      }
      _watching = true;
      // takePicture() -- even against the low-res controller above -- is a
      // full hardware shutter + JPEG encode round trip, not a cheap frame
      // grab, so it (not _watchInterval) is the real floor on how fast
      // ticks can go; only CameraController.startImageStream analyzing raw
      // preview frames would meaningfully beat it, and that's the larger,
      // riskier rewrite this file's doc comment already rules out for now.
      final tickStopwatch = Stopwatch()..start();
      try {
        final XFile image = await _cameraController!.takePicture();
        final bytes = await image.readAsBytes();
        final detections = await ModelManager().predictBytes(bytes);
        tickStopwatch.stop();
        _addLog("Watch tick: ${tickStopwatch.elapsedMilliseconds}ms");

        final currentTask = widget.tasks[_currentIndex];
        final List<String> allModelClasses = List<String>.from(currentTask['classes'] ?? []);
        final List<String> mandatoryClasses = List<String>.from(currentTask['mandatoryClasses'] ?? []);
        final List<String> ignoredClasses = List<String>.from(currentTask['ignoredClasses'] ?? []);
        final List<String> targetClasses = mandatoryClasses.isNotEmpty ? mandatoryClasses : allModelClasses;
        final List<String> failClasses = mandatoryClasses.isNotEmpty
            ? allModelClasses.where((c) =>
                !mandatoryClasses.any((m) => m.toLowerCase().trim() == c.toLowerCase().trim()) &&
                !ignoredClasses.any((ig) => ig.toLowerCase().trim() == c.toLowerCase().trim())).toList()
            : [];

        final confidentDetections = detections.where((d) => d.confidence >= _watchConfidenceThreshold).toList();
        final Map<String, DetectionResult?> tickMandatory = {
          for (final tc in targetClasses)
            tc: confidentDetections.where((d) => d.className.toLowerCase().trim() == tc.toLowerCase().trim()).isNotEmpty
                ? confidentDetections.firstWhere((d) => d.className.toLowerCase().trim() == tc.toLowerCase().trim())
                : null,
        };
        final bool tickPass = _allMandatoryPassed(tickMandatory, confidentDetections, failClasses, ignoredClasses);

        if (!mounted || !_watchActive) return;
        if (tickPass) {
          setState(() => _holdCount++);
          _addLog("Live watch: all mandatory classes seen (${_holdCount}/${_holdTarget})");
          if (_holdCount >= _holdTarget) {
            _watchActive = false;
            setState(() => _holdCount = 0);
            _addLog('Live watch: steady -- auto-capturing');
            await _handleCapture();
            return;
          }
        } else if (_holdCount != 0) {
          setState(() => _holdCount = 0);
        } else {
          // Force a rebuild even with nothing else changing, so the
          // on-screen countdown keeps ticking down.
          setState(() {});
        }
      } catch (e) {
        _addLog("Live watch tick failed: $e");
      } finally {
        _watching = false;
      }
    }
  }

  Future<void> _handleCapture() async {
    if (_isAnalyzing || !_isModelLoaded || _cameraController == null) {
      _addLog("Capture blocked: analyzing=$_isAnalyzing modelReady=$_isModelLoaded");
      return;
    }
    _watchActive = false;
    setState(() => _isAnalyzing = true);
    try {
      _addLog('--- Start Inference ---');
      final XFile image = await _takeFullQualityPicture();
      final bytes = await image.readAsBytes();

      Size? imageSize;
      img.Image? orientedImage;
      final blurCheck = await compute(_decodeAndCheckBlur, bytes);
      if (blurCheck.orientedPngBytes != null) {
        try {
          final oriented = img.decodeImage(blurCheck.orientedPngBytes!);
          if (oriented != null) {
            orientedImage = oriented;
            imageSize = Size(oriented.width.toDouble(), oriented.height.toDouble());
          }
        } catch (_) {}
      }
      if (blurCheck.variance != null) {
        final blurVariance = blurCheck.variance!;
        _addLog("Blur variance: ${blurVariance.toStringAsFixed(1)}");
        if (blurVariance < 150.0 && mounted) {
          await showDialog(
            context: context,
            barrierDismissible: false,
            builder: (_) => AlertDialog(
              backgroundColor: const Color(0xFF1A1A24),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
              title: const Row(children: [
                Icon(Icons.blur_on, color: Color(0xFFDC143C)),
                SizedBox(width: 8),
                Text('Image Not Clear', style: TextStyle(color: Colors.white, fontSize: 18)),
              ]),
              content: const Text(
                'The photo appears blurry or out of focus.\nHold steady -- resuming live scan.',
                style: TextStyle(color: Colors.white70, height: 1.5),
              ),
              actions: [
                ElevatedButton.icon(
                  onPressed: () => Navigator.pop(context),
                  icon: const Icon(Icons.camera_alt, color: Colors.white, size: 18),
                  label: const Text('OK', style: TextStyle(color: Colors.white)),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFFDC143C),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                  ),
                ),
              ],
            ),
          );
          if (mounted) setState(() => _isAnalyzing = false);
          _startWatching();
          return;
        }
      }

      setState(() {
        _bestResult = null;
        _mandatoryClassResults = {};
        _failClassResults = {};
        _capturedImageBytes = bytes;
        _capturedImageSize = imageSize;
      });

      final currentTask = widget.tasks[_currentIndex];
      final List<String> allModelClasses = List<String>.from(currentTask['classes'] ?? []);
      final List<String> mandatoryClasses = List<String>.from(currentTask['mandatoryClasses'] ?? []);
      final List<String> ignoredClasses = List<String>.from(currentTask['ignoredClasses'] ?? []);
      final List<String> targetClasses = mandatoryClasses.isNotEmpty ? mandatoryClasses : allModelClasses;
      final List<String> failClasses = mandatoryClasses.isNotEmpty
          ? allModelClasses.where((c) =>
              !mandatoryClasses.any((m) => m.toLowerCase().trim() == c.toLowerCase().trim()) &&
              !ignoredClasses.any((ig) => ig.toLowerCase().trim() == c.toLowerCase().trim())).toList()
          : [];
      if (mandatoryClasses.isEmpty) _addLog("WARNING: no mandatoryClasses configured — treating all as mandatory");
      _addLog("Pass: ${targetClasses.join(', ')}  Fail: ${failClasses.join(', ')}");

      final allDetections = orientedImage != null
          ? await ModelManager().predictImage(orientedImage, orientedPngBytes: blurCheck.orientedPngBytes)
          : await ModelManager().predictBytes(bytes);
      setState(() => _allDetections = [
            ...allDetections,
            for (final d in allDetections) ...?d.ocrCharBoxes,
          ]);

      _addLog("Detections: ${allDetections.length}");
      for (final d in allDetections) {
        _addLog("  ${d.className} ${(d.confidence * 100).toStringAsFixed(1)}%");
      }

      final Map<String, DetectionResult?> mandatoryResults = {};
      for (final mc in targetClasses) {
        final matches = allDetections.where((d) =>
            d.className.toLowerCase().trim() == mc.toLowerCase().trim());
        mandatoryResults[mc] = matches.isNotEmpty
            ? (matches.toList()..sort((a, b) => b.confidence.compareTo(a.confidence))).first
            : null;
        _addLog("  [$mc] → ${mandatoryResults[mc]?.className ?? 'NOT FOUND'}");
      }

      final Map<String, DetectionResult?> failResults = {};
      for (final fc in failClasses) {
        final matches = allDetections.where((d) =>
            d.className.toLowerCase().trim() == fc.toLowerCase().trim());
        failResults[fc] = matches.isNotEmpty
            ? (matches.toList()..sort((a, b) => b.confidence.compareTo(a.confidence))).first
            : null;
      }

      final bool overallPass = _allMandatoryPassed(mandatoryResults, allDetections, failClasses, ignoredClasses);

      String? savedImagePath;
      String? savedBackupPath;
      try {
        PermissionStatus status = await Permission.photos.request();
        if (!status.isGranted) {
          status = await Permission.storage.request();
        }

        final baseDir = Directory('/storage/emulated/0/Pictures');
        if (!await baseDir.exists()) await baseDir.create(recursive: true);

        final safeVin = widget.vin.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final safeTask = (currentTask['name'] as String? ?? 'task')
            .replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final appName = '{{ app_name }}'.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final imgDir = Directory('${baseDir.path}/MAI/$appName/Inspections/$safeVin/$safeTask');
        await imgDir.create(recursive: true);

        final now = DateTime.now();
        final dateStr =
            '${now.year}-${now.month.toString().padLeft(2, '0')}-${now.day.toString().padLeft(2, '0')}';
        final timeStr =
            '${now.hour.toString().padLeft(2, '0')}-${now.minute.toString().padLeft(2, '0')}-${now.second.toString().padLeft(2, '0')}';
        final resultBadge = overallPass ? 'OK' : 'NOT_OK';
        savedImagePath = '${imgDir.path}/${safeTask}_${resultBadge}_${dateStr}_$timeStr.jpg';

        final decoded = img.decodeImage(bytes);
        List<int> compressed;
        if (decoded != null) {
          final iw = decoded.width.toDouble();
          final ih = decoded.height.toDouble();

          for (final det in allDetections) {
            final isMandatory = targetClasses.any(
              (tc) => det.className.toLowerCase().trim() == tc.toLowerCase().trim(),
            );
            final boxColor = isMandatory ? img.ColorRgb8(0, 200, 0) : img.ColorRgb8(220, 0, 0);

            final x1 = (det.bbox.left * iw).toInt().clamp(0, decoded.width - 1);
            final y1 = (det.bbox.top * ih).toInt().clamp(0, decoded.height - 1);
            final x2 = (det.bbox.right * iw).toInt().clamp(0, decoded.width - 1);
            final y2 = (det.bbox.bottom * ih).toInt().clamp(0, decoded.height - 1);

            for (int t = 0; t < 3; t++) {
              img.drawRect(decoded, x1: x1 + t, y1: y1 + t, x2: x2 - t, y2: y2 - t, color: boxColor);
            }

            final label = '${det.className} ${(det.confidence * 100).toStringAsFixed(0)}%';
            final labelY = (y1 - 20).clamp(0, decoded.height - 20);
            img.fillRect(decoded, x1: x1, y1: labelY, x2: x1 + label.length * 8 + 6, y2: labelY + 18, color: boxColor);
            img.drawString(decoded, label, font: img.arial14, x: x1 + 3, y: labelY + 2, color: img.ColorRgb8(255, 255, 255));
          }

          compressed = img.encodeJpg(decoded, quality: 40);
        } else {
          compressed = bytes;
        }
        await File(savedImagePath).writeAsBytes(compressed, flush: true);
        _addLog("Image saved: $savedImagePath");

        try {
          final appDir = await getApplicationSupportDirectory();
          final backupDir = Directory('${appDir.path}/inspection_backups/$safeVin/$safeTask');
          await backupDir.create(recursive: true);
          final backupFile = File('${backupDir.path}/${safeTask}_${resultBadge}_${dateStr}_$timeStr.jpg');
          if (decoded != null) {
            final thumb = img.copyResize(decoded, width: 480);
            await backupFile.writeAsBytes(img.encodeJpg(thumb, quality: 15), flush: true);
          } else {
            await backupFile.writeAsBytes(compressed, flush: true);
          }
          savedBackupPath = backupFile.path;
        } catch (e) {
          _addLog("Backup save FAILED: $e");
        }
      } catch (e) {
        _addLog("Image save FAILED: $e");
        savedImagePath = null;
      }

      setState(() {
        _mandatoryClassResults = mandatoryResults;
        _failClasses = failClasses;
        _failClassResults = failResults;
        final found = mandatoryResults.values.whereType<DetectionResult>().toList()
          ..sort((a, b) => b.confidence.compareTo(a.confidence));
        _bestResult = found.isNotEmpty ? found.first : null;
        _addLog("Overall: ${overallPass ? 'PASS' : 'FAIL'}");

        _results[_currentIndex] = {
          'className': overallPass
              ? 'OK'
              : (_hasDefectDetected(allDetections, failClasses, ignoredClasses) ? 'NOT OK' : 'None'),
          'success': overallPass,
          'imagePath': savedImagePath,
          'backupImagePath': savedBackupPath,
          'mandatoryResults': mandatoryResults.map((k, v) => MapEntry(k, v != null ? v.toJson() : null)),
          'detectionsJson': jsonEncode(allDetections.map((d) => d.toJson()).toList()),
        };
        _isAnalyzing = false;
      });
    } catch (e, st) {
      _addLog("ERROR: $e");
      _addLog("  at: ${st.toString().split('\n').take(3).join(' | ')}");
      setState(() => _isAnalyzing = false);
      _startWatching();
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Capture failed: $e')));
