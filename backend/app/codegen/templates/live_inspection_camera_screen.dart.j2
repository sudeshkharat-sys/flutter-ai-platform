        ),
        child: SafeArea(
          child: Column(
            children: [
              Container(
                width: double.infinity,
                padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 16),
                decoration: const BoxDecoration(color: Color(0xFFDC143C)),
                child: Row(
                  children: [
                    IconButton(
                      icon: const Icon(Icons.arrow_back, color: Colors.white),
                      onPressed: () => Navigator.pop(context, _results),
                    ),
                    Expanded(
                      child: Center(
                        child: Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Text(
                              'LIVE SCAN -- TASK ${_currentIndex + 1} OF ${widget.tasks.length}',
                              style: const TextStyle(color: Colors.white, fontSize: 13, fontWeight: FontWeight.bold),
                            ),
                            Text(
                              '{% if scan_type == "engine" %}Engine No{% else %}VIN{% endif %}: ${widget.vin}',
                              style: const TextStyle(color: Colors.white70, fontSize: 10),
                            ),
                          ],
                        ),
                      ),
                    ),
                    IconButton(
                      icon: Icon(
                        _showDebugConsole ? Icons.bug_report : Icons.bug_report_outlined,
                        color: Colors.white70,
                      ),
                      onPressed: () => setState(() => _showDebugConsole = !_showDebugConsole),
                    ),
                  ],
                ),
              ),
              Container(
                width: double.infinity,
                padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 16),
                color: Colors.white.withOpacity(0.9),
                child: Column(
                  children: [
                    Text(
                      currentTask['name'] as String,
                      style: const TextStyle(color: Color(0xFFDC143C), fontWeight: FontWeight.w900, fontSize: 18),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      _capturedImageBytes == null
                          ? 'Point the camera at the part -- it captures automatically'
                          : 'Review and confirm',
                      style: const TextStyle(color: Colors.grey, fontSize: 12),
                    ),
                    if (_capturedImageBytes == null && _watchActive)
                      Text(
                        'Auto-capturing in ${_watchSecondsLeft()}s if not found sooner',
                        style: const TextStyle(color: Colors.grey, fontSize: 11),
                      ),
                  ],
                ),
              ),
              Expanded(
                child: Stack(
                  children: [
                    if (_capturedImageBytes == null)
                      Positioned.fill(
                        child: _isCameraInitialized && _cameraController != null
                            // CameraPreview alone stretches to fill whatever
                            // box it's given, ignoring the sensor's actual
                            // aspect ratio -- on some devices/aspect ratios
                            // that reads as "barely any visible feed" above
                            // the capture button rather than a live feed.
                            // previewSize's width/height come back swapped
                            // from the sensor's portrait orientation, hence
                            // the flip here -- the standard fix for this.
                            ? FittedBox(
                                fit: BoxFit.cover,
                                child: SizedBox(
                                  width: _cameraController!.value.previewSize?.height ??
                                      _cameraController!.value.aspectRatio,
                                  height: _cameraController!.value.previewSize?.width ?? 1,
                                  child: CameraPreview(_cameraController!),
                                ),
                              )
                            : const Center(child: CircularProgressIndicator(color: Color(0xFFDC143C))),
                      ),
