                            // box it's given, ignoring the sensor's actual
                            // aspect ratio -- on some devices/aspect ratios
                            // that reads as "barely any visible feed" above
                            // the capture button rather than a live feed.
                            // previewSize's width/height come back swapped
                            // from the sensor's portrait orientation, hence
                            // the flip here -- the standard fix for this.
                            ? FittedBox(
                                fit: BoxFit.cover,
                                child: SizedBox(
                                  width: _cameraController!.value.previewSize?.height ??
                                      _cameraController!.value.aspectRatio,
                                  height: _cameraController!.value.previewSize?.width ?? 1,
                                  child: CameraPreview(_cameraController!),
                                ),
                              )
                            : const Center(child: CircularProgressIndicator(color: Color(0xFFDC143C))),
                      ),
                    // Live detection-box overlay while watching (mirrors the
                    // simultaneous-mode screen) -- without this the feed
                    // just looks like a static preview with nothing
                    // happening for the several seconds a tick's
                    // stream-frame conversion+predict round trip actually takes, even
                    // though it's finding and holding on the target the
                    // whole time.
                    if (_capturedImageBytes == null &&
                        _liveTickDetections.isNotEmpty &&
                        _cameraController != null &&
                        _cameraController!.value.previewSize != null)
                      Positioned.fill(
                        child: DetectionOverlay(
                          results: _liveTickDetections,
                          previewSize: Size(
                            _cameraController!.value.previewSize!.height,
                            _cameraController!.value.previewSize!.width,
                          ),
                          // Already filtered to only still-pending tasks'
                          // own target classes above, so a visible box
                          // always means real progress -- force it green
                          // rather than the arbitrary per-class palette.
                          overrideColor: Colors.greenAccent,
                        ),
                      ),
                    if (_capturedImageBytes != null)
                      Positioned.fill(
                        child: _capturedImageSize != null
                            ? FittedBox(
                                fit: BoxFit.contain,
                                child: SizedBox(
                                  width: _capturedImageSize!.width,
                                  height: _capturedImageSize!.height,
                                  child: Stack(
                                    fit: StackFit.expand,
                                    children: [
                                      Image.memory(
                                        _capturedImageBytes!,
                                        fit: BoxFit.fill,
                                        width: _capturedImageSize!.width,
                                        height: _capturedImageSize!.height,
                                      ),
                                      if (overlayResult != null)
                                        DetectionOverlay(
                                          results: [overlayResult],
                                          previewSize: _capturedImageSize!,
                                          overrideColor: badgeGreen ? Colors.green : Colors.red,
                                        ),
                                    ],
                                  ),
                                ),
                              )
                            : Image.memory(_capturedImageBytes!, fit: BoxFit.contain),
                      ),
                    if (_capturedImageBytes == null)
                      Center(
                        child: Container(
                          width: 280,
                          height: 280,
                          decoration: BoxDecoration(
                            border: Border.all(
                              // Border brightens amber -> green as the hold
                              // counter fills, so the frame itself is the
                              // "getting close" cue -- not just the pill below.
                              color: _holdCount == 0
                                  ? const Color(0xFFDC143C)
                                  : Color.lerp(const Color(0xFFFFC107), const Color(0xFF22C55E),
                                      _holdCount / _holdTarget)!,
                              width: _holdCount == 0 ? 2 : 3,
                            ),
                          ),
                        ),
                      ),
                    if (_capturedImageBytes == null && _holdCount > 0)
                      Positioned(
                        top: 16,
                        left: 0,
                        right: 0,
                        child: Center(
                          child: Container(
                            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                            decoration: BoxDecoration(
                              color: Colors.black.withOpacity(0.7),
                              borderRadius: BorderRadius.circular(20),
                            ),
                            child: Row(
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                const Text('Hold steady…',
                                    style: TextStyle(color: Colors.white, fontSize: 13, fontWeight: FontWeight.w600)),
                                const SizedBox(width: 10),
                                SizedBox(
                                  width: 70,
                                  height: 6,
                                  child: ClipRRect(
                                    borderRadius: BorderRadius.circular(3),
                                    child: LinearProgressIndicator(
                                      value: _holdCount / _holdTarget,
                                      backgroundColor: Colors.white24,
                                      valueColor: const AlwaysStoppedAnimation(Color(0xFF22C55E)),
                                    ),
                                  ),
                                ),
                              ],
                            ),
                          ),
                        ),
                      ),
                    if (_isLoadingModel && _capturedImageBytes == null)
                      Container(
                        color: Colors.black45,
                        child: const Center(child: CircularProgressIndicator(color: Colors.white)),
                      ),
                    if (_isAnalyzing)
                      Container(
                        color: Colors.black54,
                        child: const Center(child: CircularProgressIndicator(color: Color(0xFFDC143C))),
                      ),
                    if (_capturedImageBytes == null && _isCameraInitialized)
                      Positioned(
                        top: 16,
                        left: 16,
                        child: GestureDetector(
                          onTap: _toggleFlash,
                          child: Container(
                            width: 48,
                            height: 48,
                            decoration: BoxDecoration(
                              color: _isFlashOn ? const Color(0xFFFFD700) : Colors.black54,
                              shape: BoxShape.circle,
                              border: Border.all(
                                color: _isFlashOn ? const Color(0xFFFFD700) : Colors.white30,
                                width: 1.5,
                              ),
                            ),
                            child: Icon(
                              _isFlashOn ? Icons.flashlight_on : Icons.flashlight_off,
                              color: _isFlashOn ? Colors.black : Colors.white,
                              size: 24,
                            ),
                          ),
                        ),
                      ),
                    // Persistent "LIVE" pill, shown whenever the watch loop
                    // is actively auto-scanning and no frame is frozen yet --
                    // otherwise the preview + capture button combo below it
                    // can read as a static screen rather than a continuous
                    // auto-detecting feed.
                    if (_capturedImageBytes == null && _watchActive)
                      Positioned(
                        top: 16,
                        right: 16,
                        child: Container(
                          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                          decoration: BoxDecoration(
                            color: Colors.black.withOpacity(0.7),
                            borderRadius: BorderRadius.circular(20),
                          ),
                          child: Row(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              Container(
                                width: 8,
                                height: 8,
                                decoration: const BoxDecoration(color: Color(0xFFDC143C), shape: BoxShape.circle),
                              ),
                              const SizedBox(width: 6),
                              const Text('LIVE',
                                  style: TextStyle(
                                      color: Colors.white, fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 0.5)),
                            ],
                          ),
                        ),
                      ),
                    if (!_isAnalyzing && _capturedImageBytes != null)
                      Positioned(
                        top: 16,
                        right: 16,
                        child: Container(
                          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                          decoration: BoxDecoration(
                            color: badgeGreen ? Colors.green : Colors.red,
                            borderRadius: BorderRadius.circular(20),
                          ),
                          child: Text(
                            badgeGreen
                                ? '✓ ${_bestResult!.className}'
                                : overlayResult != null
                                    ? '✗ ${overlayResult.className}'
                                    : 'NOT FOUND',
                            style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 13),
                          ),
                        ),
                      ),
                    if (_showDebugConsole)
                      Positioned(
                        bottom: 0,
                        left: 0,
                        right: 0,
                        height: MediaQuery.of(context).size.height * 0.8,
                        child: Container(
                          color: Colors.black.withOpacity(0.92),
                          padding: const EdgeInsets.all(10),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Row(
                                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                                children: [
                                  const Text('DEBUG CONSOLE',
                                      style: TextStyle(color: Colors.yellow, fontWeight: FontWeight.bold, fontSize: 14)),
                                  IconButton(
                                    icon: const Icon(Icons.delete_sweep, color: Colors.white, size: 22),
                                    tooltip: 'Clear log',
                                    onPressed: () => setState(() => _debugLogs = []),
                                    padding: EdgeInsets.zero,
                                    constraints: const BoxConstraints(),
                                  ),
                                ],
                              ),
                              const Divider(color: Colors.white24),
                              Expanded(
                                child: ListView.builder(
                                  reverse: true,
                                  itemCount: _debugLogs.length,
                                  itemBuilder: (_, idx) => Padding(
                                    padding: const EdgeInsets.only(bottom: 8),
                                    child: SelectableText(
                                      _debugLogs[_debugLogs.length - 1 - idx],
                                      style: const TextStyle(
                                          color: Colors.white, fontFamily: 'monospace', fontSize: 14, height: 1.3),
                                    ),
                                  ),
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                  ],
                ),
              ),
              Padding(
                padding: const EdgeInsets.all(24),
                child: _capturedImageBytes == null
                    ? GestureDetector(
                        onTap: (_isLoadingModel || _isAnalyzing || !_isCameraInitialized) ? null : _handleCapture,
                        child: Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Container(
                              width: 80,
                              height: 80,
                              decoration: BoxDecoration(
                                color: _isLoadingModel
                                    ? const Color(0xFFDC143C).withOpacity(0.35)
                                    : const Color(0xFFDC143C),
                                shape: BoxShape.circle,
                                boxShadow: const [
                                  BoxShadow(color: Colors.black26, blurRadius: 10, offset: Offset(0, 4))
                                ],
                              ),
                              child: const Icon(Icons.camera_alt, color: Colors.white, size: 40),
                            ),
                            Padding(
                              padding: const EdgeInsets.only(top: 8),
                              child: Text(
                                _isLoadingModel ? 'Loading model…' : 'Manual capture (or wait for auto)',
                                style: const TextStyle(color: Colors.white70, fontSize: 12),
                              ),
                            ),
                          ],
                        ),
                      )
                    : Row(
                        children: [
                          Expanded(
                            child: OutlinedButton(
                              onPressed: _retake,
                              style: OutlinedButton.styleFrom(
                                padding: const EdgeInsets.symmetric(vertical: 16),
                                side: const BorderSide(color: Color(0xFFDC143C)),
                              ),
                              child: const Text('RETAKE',
                                  style: TextStyle(color: Color(0xFFDC143C), fontWeight: FontWeight.bold)),
                            ),
                          ),
                          const SizedBox(width: 16),
                          Expanded(
                            child: ElevatedButton(
                              onPressed: _onSaveAndContinue,
                              style: ElevatedButton.styleFrom(
                                backgroundColor: Colors.green,
                                padding: const EdgeInsets.symmetric(vertical: 16),
                              ),
                              child: Text(
                                _results.length + 1 == widget.tasks.length ? 'FINISH' : 'NEXT TASK',
                                style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold),
                              ),
                            ),
                          ),
                        ],
                      ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
