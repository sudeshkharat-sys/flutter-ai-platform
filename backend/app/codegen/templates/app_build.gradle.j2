plugins {
    id "com.android.application"
    id "dev.flutter.flutter-gradle-plugin"
    id "org.jetbrains.kotlin.android"
}

def localProperties = new Properties()
def localPropertiesFile = rootProject.file('local.properties')
if (localPropertiesFile.exists()) {
    localPropertiesFile.withReader('UTF-8') { reader ->
        localProperties.load(reader)
    }
}

android {
    namespace "{{ package_name }}"
    compileSdk rootProject.ext.flutterCompileSdkVersion
    ndkVersion "27.0.12077973"

    defaultConfig {
        applicationId "{{ package_name }}"
        minSdk rootProject.ext.flutterMinSdkVersion
        targetSdk rootProject.ext.flutterTargetSdkVersion
        versionCode 1
        versionName "1.0"
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

    kotlinOptions {
        jvmTarget = '17'
    }

    sourceSets {
        main.java.srcDirs += 'src/main/kotlin'
    }

    // Every generated app is signed with the same fixed keystore (checked
    // into the codegen templates, not the ad-hoc per-machine debug key) so
    // its certificate never changes between builds -- otherwise installing
    // a freshly-built APK over an older install looks like a different app
    // to Android, forcing an uninstall (which wipes paired-PC/device data)
    // before the "update" can go through.
    signingConfigs {
        release {
            storeFile file("keystore/release.keystore")
            storePassword "flutterAiStudioRelease2026"
            keyAlias "flutteraistudio"
            keyPassword "flutterAiStudioRelease2026"
        }
    }

    buildTypes {
        release {
            // Build 2 of the staged rollout: every phone's pending
            // backlog was drained on the debug-signed Build 1, so it's
            // now safe to switch to the fixed release keystore. From
            // this build onward every generated app is signed with the
            // same committed keystore, so its certificate never
            // changes between builds/machines -- installing a new APK
            // over an old one is a normal in-place update, and paired
            // devices / local data survive.
            signingConfig signingConfigs.release
        }
    }
}

flutter {
    source '../..'
}

dependencies {
    implementation "org.jetbrains.kotlin:kotlin-stdlib:{{ kotlin_version }}"

    // Only add plugin project dependencies that were actually included via
    // .flutter-plugins in settings.gradle. findProject returns null for any
    // plugin whose directory was not found, so those are silently skipped.
    def pluginNames = [
        'camera_android', 'camera_android_camerax', 'permission_handler_android',
        'flutter_plugin_android_lifecycle', 'tflite_flutter', 'path_provider_android',
        'shared_preferences_android', 'mobile_scanner', 'sqlite3_flutter_libs',
        'zsdk', 'jni', 'jni_flutter'
    ]
    pluginNames.each { pluginName ->
        if (rootProject.findProject(":${pluginName}") != null) {
            implementation project(":${pluginName}")
        }
    }
}
