package {{ package_name }}

import android.content.Context
import android.content.Intent
import android.media.AudioAttributes
import android.media.MediaPlayer
import android.net.Uri
import android.provider.OpenableColumns
import java.io.File
import android.media.AudioManager
import android.media.ToneGenerator
import android.os.Build
import android.os.VibrationEffect
import android.os.Vibrator
import android.os.VibratorManager
import android.net.wifi.WifiManager
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

class MainActivity: FlutterActivity() {
    private var multicastLock: WifiManager.MulticastLock? = null
    private var pendingPick: MethodChannel.Result? = null
    private var pendingSlot: String = "ok"
    private var tonePlayer: MediaPlayer? = null
    private val PICK_TONE = 4711

    /// Copies the picked sound into the app's own storage (a content:// uri may stop
    /// working later) and returns "path|display name", or null if it could not be read.
    private fun importTone(uri: Uri, slot: String): String? {
        val name = contentResolver.query(uri, null, null, null, null)?.use { c ->
            val i = c.getColumnIndex(OpenableColumns.DISPLAY_NAME)
            if (i >= 0 && c.moveToFirst()) c.getString(i) else null
        } ?: "tone"
        val dir = File(filesDir, "tones"); dir.mkdirs()
        val dest = File(dir, "$slot-" + System.currentTimeMillis())
        contentResolver.openInputStream(uri)?.use { input -> dest.outputStream().use { input.copyTo(it) } } ?: return null
        dir.listFiles()?.filter { it.name.startsWith("$slot-") && it != dest }?.forEach { it.delete() }
        return dest.absolutePath + "|" + name
    }

    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        if (requestCode == PICK_TONE) {
            val res = pendingPick; pendingPick = null
            val uri = data?.data
            if (resultCode == RESULT_OK && uri != null) {
                try { res?.success(importTone(uri, pendingSlot)) } catch (e: Exception) { res?.error("pick", e.message, null) }
            } else res?.success(null)
            return
        }
        super.onActivityResult(requestCode, resultCode, data)
    }

    private fun vibrator(): Vibrator? =
        if (Build.VERSION.SDK_INT >= 31)
            (getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as? VibratorManager)?.defaultVibrator
        else @Suppress("DEPRECATION") (getSystemService(Context.VIBRATOR_SERVICE) as? Vibrator)

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        // Result feedback for the live inspection: full-amplitude vibration and a loud tone
        // (alarm stream, so it does not depend on the media volume). Flutter's HapticFeedback is
        // a light tick on many phones (e.g. vivo X200) -- far too weak to feel in a bonnet.
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "{{ package_name }}/feedback")
            .setMethodCallHandler { call, result ->
                try {
                    when (call.method) {
                        "deviceStats" -> {
                            // Battery temperature (deg C), battery %, charging, and the OS thermal
                            // status (0 none .. 6 shutdown; -1 = not available below Android 10).
                            val b = registerReceiver(null, android.content.IntentFilter(Intent.ACTION_BATTERY_CHANGED))
                            val temp = (b?.getIntExtra(android.os.BatteryManager.EXTRA_TEMPERATURE, 0) ?: 0) / 10.0
                            val lvl = b?.getIntExtra(android.os.BatteryManager.EXTRA_LEVEL, -1) ?: -1
                            val scale = b?.getIntExtra(android.os.BatteryManager.EXTRA_SCALE, 100) ?: 100
                            val st = b?.getIntExtra(android.os.BatteryManager.EXTRA_STATUS, -1) ?: -1
                            val charging = st == android.os.BatteryManager.BATTERY_STATUS_CHARGING || st == android.os.BatteryManager.BATTERY_STATUS_FULL
                            val thermal = if (Build.VERSION.SDK_INT >= 29)
                                (getSystemService(Context.POWER_SERVICE) as android.os.PowerManager).currentThermalStatus else -1
                            result.success(mapOf("tempC" to temp, "level" to (if (lvl >= 0) lvl * 100 / scale else -1),
                                "charging" to charging, "thermal" to thermal))
                        }
                        "vibrate" -> {
                            // [wait, on, off, on, ...] in ms, full amplitude.
                            val pattern = (call.argument<List<Int>>("pattern") ?: listOf(0, 400)).map { it.toLong() }.toLongArray()
                            val v = vibrator()
                            if (Build.VERSION.SDK_INT >= 26) {
                                val amps = IntArray(pattern.size) { if (it % 2 == 1) 255 else 0 }
                                v?.vibrate(VibrationEffect.createWaveform(pattern, amps, -1))
                            } else {
                                @Suppress("DEPRECATION") v?.vibrate(pattern, -1)
                            }
                            result.success(null)
                        }
                        "tone" -> {
                            val tone = when (call.argument<String>("tone")) {
                                "ack" -> ToneGenerator.TONE_PROP_ACK
                                "nack" -> ToneGenerator.TONE_PROP_NACK
                                "alert" -> ToneGenerator.TONE_CDMA_ALERT_CALL_GUARD
                                else -> ToneGenerator.TONE_PROP_BEEP
                            }
                            val ms = call.argument<Int>("ms") ?: 300
                            val tg = ToneGenerator(AudioManager.STREAM_ALARM, 100)
                            tg.startTone(tone, ms)
                            android.os.Handler(mainLooper).postDelayed({ tg.release() }, (ms + 200).toLong())
                            result.success(null)
                        }
                        "pickTone" -> {
                            pendingSlot = call.argument<String>("slot") ?: "ok"
                            pendingPick = result
                            val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
                                addCategory(Intent.CATEGORY_OPENABLE)
                                type = "audio/*"
                            }
                            startActivityForResult(intent, PICK_TONE)
                        }
                        "playFile" -> {
                            val path = call.argument<String>("path")
                            tonePlayer?.release()
                            tonePlayer = MediaPlayer().apply {
                                setAudioAttributes(AudioAttributes.Builder()
                                    .setUsage(AudioAttributes.USAGE_ALARM)
                                    .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION).build())
                                setDataSource(path)
                                setVolume(1f, 1f)
                                setOnCompletionListener { it.release(); if (tonePlayer === it) tonePlayer = null }
                                prepare()
                                start()
                            }
                            result.success(null)
                        }
                        else -> result.notImplemented()
                    }
                } catch (e: Exception) {
                    result.error("feedback", e.message, null)
                }
            }
        // The multicast_dns package's PC-discovery lookups get their incoming
        // responses silently dropped by many OEMs' WiFi power-saving (screen
        // off / radio idle) unless a multicast lock is held -- discovery then
        // returns empty with no error, and the caller falls back to whatever
        // IP it last knew for the PC, which may no longer be valid. Holding
        // this lock only while a lookup is in flight keeps those responses
        // flowing without leaving multicast reception on all the time.
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "{{ package_name }}/multicast_lock")
            .setMethodCallHandler { call, result ->
                when (call.method) {
                    "acquire" -> {
                        if (multicastLock == null) {
                            val wifiManager =
                                applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager
                            multicastLock = wifiManager.createMulticastLock("{{ package_name }}_mdns")
                            multicastLock?.setReferenceCounted(true)
                        }
                        multicastLock?.acquire()
                        result.success(null)
                    }
                    "release" -> {
                        if (multicastLock?.isHeld == true) multicastLock?.release()
                        result.success(null)
                    }
                    else -> result.notImplemented()
                }
            }
    }
}
