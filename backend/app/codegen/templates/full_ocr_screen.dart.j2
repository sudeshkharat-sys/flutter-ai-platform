import 'dart:io';
import 'dart:typed_data';
import 'package:camera/camera.dart';
import 'package:flutter/material.dart';
import 'package:flutter/foundation.dart' show compute;
import 'package:image/image.dart' as img;
import 'package:google_mlkit_text_recognition/google_mlkit_text_recognition.dart';

// ── Background-isolate preprocessing ──────────────────────────────────────
// The adaptive threshold / emboss passes below do per-pixel work on a 3x
// upscaled crop, which is heavy enough (especially run up to 6 times per
// burst scan) to freeze the UI thread and trigger an Android ANR if run
// inline. compute() runs each one on a background isolate instead, so the
// screen stays responsive no matter how long processing takes. Top-level
// functions (not methods) are required for compute().

Uint8List _computeCropForOcr(Uint8List jpgBytes) {
  final src = img.decodeJpg(jpgBytes);
  if (src == null) return jpgBytes;
  return Uint8List.fromList(img.encodeJpg(_FullOcrScreenState._preprocessCropForOcr(src)));
}

Uint8List _computeCropRelief(Uint8List jpgBytes) {
  final src = img.decodeJpg(jpgBytes);
  if (src == null) return jpgBytes;
  return Uint8List.fromList(img.encodeJpg(_FullOcrScreenState._preprocessCropRelief(src)));
}

Uint8List _computeFullFrame(Uint8List jpgBytes) {
  final src = img.decodeJpg(jpgBytes);
  if (src == null) return jpgBytes;
  return Uint8List.fromList(img.encodeJpg(_FullOcrScreenState._preprocessFullFrame(src)));
}

/// Full-page text scan: reads every character on screen, top-to-bottom and
/// left-to-right, and highlights low-confidence words in red so an inspector
/// can spot unreliable reads at a glance.
class FullOcrScreen extends StatefulWidget {
  /// When set (e.g. from a QR code scanned beforehand), the OCR reading is
  /// compared against this value and the result screen shows a MATCH/NO
  /// MATCH verdict instead of just a free-form reading.
  final String? expectedText;
  const FullOcrScreen({super.key, this.expectedText});

  @override
  State<FullOcrScreen> createState() => _FullOcrScreenState();
}

/// A single recognized word placed in reading order, with its own confidence.
class _OcrWord {
  final String text;
  final double? confidence;
  _OcrWord(this.text, this.confidence);
}

class _FullOcrScreenState extends State<FullOcrScreen> with WidgetsBindingObserver {
  static const double _lowConfidenceThreshold = {{ full_ocr_threshold | default(0.5) }};

  CameraController? _cameraController;
  bool _isCameraInitialized = false;
  bool _isProcessing = false;
  String? _processingStatus;
  String? _error;

  Uint8List? _capturedImageBytes;
  List<List<_OcrWord>> _rows = [];
  double? _overallAccuracy;

  // Debug aid: shows each word's raw confidence % next to it, so you can
  // see exactly what the recognizer scored per word/character instead of
  // just the red/black pass-fail color — useful for tuning the threshold.
  bool _showConfidenceDetails = true;

  // Match-against-expected-text (set when widget.expectedText is provided).
  bool? _isMatch;
  double? _matchScore;
  String _matchExtractedText = '';

  // Box OCR: when enabled, only the area inside this fractional rectangle
  // (0..1 relative to the camera preview) is cropped out and OCR'd, instead
  // of the whole frame. User can drag to move and drag the handle to resize.
  bool _boxOcrMode = false;
  Rect? _boxRect;
  Size _previewAreaSize = Size.zero;

  /// Centered square box, sized relative to whichever screen it's shown on
  /// (fractional width/height differ so the box renders as an actual square,
  /// not just an equal fraction of each axis).
  Rect _squareBoxFor(Size areaSize) {
    if (areaSize.width <= 0 || areaSize.height <= 0) {
      return const Rect.fromLTWH(0.25, 0.4, 0.5, 0.25);
    }
    final double side = areaSize.shortestSide * 0.55;
    final double left = (areaSize.width - side) / 2;
    final double top = (areaSize.height - side) / 2;
    return Rect.fromLTWH(
      left / areaSize.width,
      top / areaSize.height,
      side / areaSize.width,
      side / areaSize.height,
    );
  }

  final TextRecognizer _recognizer = TextRecognizer(script: TextRecognitionScript.latin);

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _initializeCamera();
    _warmUpRecognizer();
  }

  /// ML Kit's text recognizer has a one-time model-load delay on first use,
  /// which otherwise lands right on the user's first real scan and makes it
  /// feel much slower than every scan after. Firing a throwaway recognition
  /// call as soon as the screen opens moves that wait here instead, while
  /// the user is still lining up the shot.
  Future<void> _warmUpRecognizer() async {
    File? warmupFile;
    try {
      final blank = img.Image(width: 16, height: 16);
      warmupFile = File('${Directory.systemTemp.path}/digiocr_warmup.jpg');
      await warmupFile.writeAsBytes(img.encodeJpg(blank));
      await _recognizer.processImage(InputImage.fromFilePath(warmupFile.path));
    } catch (_) {
      // Best-effort only — a failed warm-up just means the first real scan
      // pays the model-load cost instead, same as before this existed.
    } finally {
      if (warmupFile != null) {
        try {
          await warmupFile.delete();
        } catch (_) {}
      }
    }
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _cameraController?.dispose();
    _recognizer.close();
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    final ctrl = _cameraController;
    if (ctrl == null || !ctrl.value.isInitialized) return;
    if (state == AppLifecycleState.inactive) {
      ctrl.dispose();
    } else if (state == AppLifecycleState.resumed) {
      _initializeCamera();
    }
  }

  Future<void> _initializeCamera() async {
    try {
      final cameras = await availableCameras();
      if (cameras.isEmpty) {
        setState(() => _error = 'No cameras found');
        return;
      }
      final back = cameras.firstWhere(
        (c) => c.lensDirection == CameraLensDirection.back,
        orElse: () => cameras.first,
      );
      final controller = CameraController(back, ResolutionPreset.high, enableAudio: false);
      _cameraController = controller;
      await controller.initialize();
      if (mounted) setState(() => _isCameraInitialized = true);
    } catch (e) {
      if (mounted) setState(() => _error = 'Camera error: $e');
    }
  }

  // ── OCR image preprocessing ────────────────────────────────────────────

  /// Small blur to suppress fine background texture noise (e.g. a brushed
  /// metal finish) before binarizing/embossing, without softening the much
  /// bolder engraved or stamped character strokes.
  static img.Image _denoise(img.Image src) => img.gaussianBlur(src, radius: 1);

  /// Whole-frame preprocessing for Full Scan mode: a global auto
  /// brightness/contrast stretch plus a light sharpen. Runs on a background
  /// isolate already, but a full camera-resolution photo (10+ megapixels)
  /// still takes several seconds of real CPU time to filter pixel-by-pixel —
  /// downsizing first keeps that reasonable, since whole-frame text reading
  /// doesn't need full sensor resolution.
  static img.Image _preprocessFullFrame(img.Image src) {
    img.Image working = src;
    const int maxDimension = 1600;
    if (src.width > maxDimension || src.height > maxDimension) {
      working = src.width >= src.height
          ? img.copyResize(src, width: maxDimension)
          : img.copyResize(src, height: maxDimension);
    }
    img.Image out = img.normalize(working, min: 0, max: 255);
    out = _denoise(out);
    out = img.convolution(out, filter: [0, -1, 0, -1, 5, -1, 0, -1, 0], div: 1);
    return out;
  }

  /// Region preprocessing for Box Scan mode: upscale 3x, grayscale, denoise,
  /// adaptive per-tile threshold, then sharpen. Same technique already
  /// proven for per-class OCR crops — safe to upscale here since the crop is
  /// small.
  static img.Image _preprocessCropForOcr(img.Image src) {
    img.Image out = img.copyResize(
      src,
      width: src.width * 3,
      height: src.height * 3,
      interpolation: img.Interpolation.cubic,
    );
    out = img.grayscale(out);
    out = _denoise(out);

    final int w = out.width;
    final int h = out.height;
    final int tileSize = (w * 0.15).round().clamp(16, 64);
    final img.Image thresholded = img.Image(width: w, height: h);

    for (int ty = 0; ty < h; ty += tileSize) {
      for (int tx = 0; tx < w; tx += tileSize) {
        final int x2 = (tx + tileSize).clamp(0, w);
        final int y2 = (ty + tileSize).clamp(0, h);

        int sum = 0, count = 0;
        for (int y = ty; y < y2; y++) {
          for (int x = tx; x < x2; x++) {
            sum += out.getPixel(x, y).r.toInt();
            count++;
          }
        }
        final int mean = count > 0 ? (sum ~/ count) : 128;
        final int tileThreshold = (mean * 0.85).round().clamp(0, 255);

        for (int y = ty; y < y2; y++) {
          for (int x = tx; x < x2; x++) {
            final int lum = out.getPixel(x, y).r.toInt();
            final int val = lum < tileThreshold ? 0 : 255;
            thresholded.setPixelRgb(x, y, val, val, val);
          }
        }
      }
    }

    return img.convolution(thresholded, filter: [0, -1, 0, -1, 5, -1, 0, -1, 0], div: 1);
  }

  /// Alternate region variant for engraved/stamped text: a directional
  /// (emboss-style) filter that emphasizes the groove edges of low-relief
  /// strokes, instead of a flat threshold. Run alongside
  /// [_preprocessCropForOcr] each burst shot — whichever reads with higher
  /// confidence wins, since which one works best depends on the light angle
  /// at capture time.
  static img.Image _preprocessCropRelief(img.Image src) {
    img.Image out = img.copyResize(
      src,
      width: src.width * 3,
      height: src.height * 3,
      interpolation: img.Interpolation.cubic,
    );
    out = img.grayscale(out);
    out = _denoise(out);
    return img.convolution(out, filter: [-1, -1, 0, -1, 1, 1, 0, 1, 1], div: 1);
  }

  /// Higher is better: mean confidence across recognized words. Candidates
  /// with no words at all score lowest so a real (if low-confidence) read
  /// always beats an empty one.
  static double _scoreRows(List<List<_OcrWord>> rows) {
    final confidences = rows.expand((row) => row).map((w) => w.confidence).whereType<double>().toList();
    if (confidences.isEmpty) return rows.isEmpty ? -1.0 : 0.0;
    return confidences.reduce((a, b) => a + b) / confidences.length;
  }

  /// Crops [full] to the fractional [box] (0..1 coordinates).
  static img.Image _cropToBox(img.Image full, Rect box) {
    final int x = (box.left * full.width).round().clamp(0, full.width - 1);
    final int y = (box.top * full.height).round().clamp(0, full.height - 1);
    final int w = (box.width * full.width).round().clamp(1, full.width - x);
    final int h = (box.height * full.height).round().clamp(1, full.height - y);
    return img.copyCrop(full, x: x, y: y, width: w, height: h);
  }

  // ── Expected-text matching (same approach as the per-class OCR matching) ──

  static const double _matchThreshold = 0.85;

  static String _normalizeForMatch(String s) =>
      s.toUpperCase().replaceAll(RegExp(r'[^A-Z0-9]'), '');

  static int _levenshtein(String a, String b) {
    if (a.isEmpty) return b.length;
    if (b.isEmpty) return a.length;
    final List<List<int>> dp = List.generate(
      a.length + 1,
      (i) => List.generate(b.length + 1, (j) => i == 0 ? j : (j == 0 ? i : 0)),
    );
    for (int i = 1; i <= a.length; i++) {
      for (int j = 1; j <= b.length; j++) {
        dp[i][j] = a[i - 1] == b[j - 1]
            ? dp[i - 1][j - 1]
            : 1 + [dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]].reduce((x, y) => x < y ? x : y);
      }
    }
    return dp[a.length][b.length];
  }

  /// Best similarity of [target] against a sliding window across
  /// [extracted] — tolerates extra surrounding text/noise around the real
  /// code, same as the per-class OCR matching already does.
  static double _matchSimilarity(String extracted, String target) {
    if (target.isEmpty || extracted.isEmpty) return 0.0;
    if (extracted == target) return 1.0;
    final int len = target.length;
    if (extracted.length < len) {
      return (1.0 - _levenshtein(extracted, target) / len).clamp(0.0, 1.0);
    }
    double best = 0;
    for (int start = 0; start <= extracted.length - len; start++) {
      final String window = extracted.substring(start, start + len);
      final double score = 1.0 - _levenshtein(window, target) / len;
      if (score > best) best = score;
    }
    return best.clamp(0.0, 1.0);
  }

  // ── Reading order ───────────────────────────────────────────────────────

  /// Groups recognized text elements into reading order: rows ordered
  /// top-to-bottom (clustered by vertical overlap so wrapped/adjacent lines
  /// land in the same row), and words ordered left-to-right within each row.
  List<List<_OcrWord>> _toReadingOrder(RecognizedText recognizedText) {
    final elements = <TextElement>[];
    for (final block in recognizedText.blocks) {
      for (final line in block.lines) {
        elements.addAll(line.elements);
      }
    }
    if (elements.isEmpty) return [];

    elements.sort((a, b) => a.boundingBox.top.compareTo(b.boundingBox.top));

    final List<List<TextElement>> rows = [];
    for (final el in elements) {
      final elCenter = el.boundingBox.top + el.boundingBox.height / 2;
      List<TextElement>? targetRow;
      for (final row in rows) {
        final refTop = row.first.boundingBox.top;
        final refHeight = row.first.boundingBox.height;
        final rowCenter = refTop + refHeight / 2;
        if ((elCenter - rowCenter).abs() < refHeight * 0.6) {
          targetRow = row;
          break;
        }
      }
      if (targetRow != null) {
        targetRow.add(el);
      } else {
        rows.add([el]);
      }
    }

    rows.sort((a, b) => a.first.boundingBox.top.compareTo(b.first.boundingBox.top));
    for (final row in rows) {
      row.sort((a, b) => a.boundingBox.left.compareTo(b.boundingBox.left));
    }

    return rows
        .map((row) => row.map((el) => _OcrWord(el.text, el.confidence)).toList())
        .toList();
  }

  /// Number of quick shots taken per scan. Engraved/stamped text often has a
  /// specular highlight from the light source that lands in a different spot
  /// on each shot (due to natural hand shake between frames) — taking a few
  /// shots and keeping whichever reads with the highest confidence beats
  /// relying on a single frame that might have the highlight sitting right
  /// across a critical stroke.
  static const int _burstShotCount = 2;

  /// Once a shot's mean word confidence reaches this, stop taking more shots
  /// / trying more variants — most scans nail it on the first try, and
  /// running the full burst every single time was making every scan take as
  /// long as the hardest case. Kept modest on purpose (not "near perfect")
  /// so an already-decent read doesn't keep grinding for marginal gains.
  static const double _earlyExitScore = 0.75;

  /// The Box Scan relief variant only gets tried if the plain threshold
  /// pass scored below this — most plates read fine with just the first
  /// pass, so this avoids doubling the work on every single scan.
  static const double _tryReliefBelowScore = 0.5;

  Future<void> _captureAndScan() async {
    if (_isProcessing || _cameraController == null || !_isCameraInitialized) return;
    setState(() {
      _isProcessing = true;
      _processingStatus = 'Capturing...';
      _error = null;
    });

    Uint8List? bestDisplayBytes;
    List<List<_OcrWord>> bestRows = [];
    double bestScore = double.negativeInfinity;
    bool matchFoundEarly = false;
    final List<File> tempFiles = [];
    final String? expected = widget.expectedText;

    Future<void> tryVariant(
      Uint8List Function(Uint8List) preprocess,
      Uint8List inputJpg,
      Uint8List displayBytes,
    ) async {
      final processed = await compute(preprocess, inputJpg);
      final tempFile = File(
        '${Directory.systemTemp.path}/digiocr_${DateTime.now().microsecondsSinceEpoch}.jpg',
      );
      tempFiles.add(tempFile);
      await tempFile.writeAsBytes(processed);

      final inputImage = InputImage.fromFilePath(tempFile.path);
      final recognizedText = await _recognizer.processImage(inputImage);
      final rows = _toReadingOrder(recognizedText);
      final score = _scoreRows(rows);

      if (score > bestScore) {
        bestScore = score;
        bestRows = rows;
        bestDisplayBytes = displayBytes;
      }

      // Already know what we're looking for (from the QR scan) — if this
      // shot's reading actually matches it, that's a stronger stop signal
      // than raw confidence, so take it immediately instead of grinding
      // through more shots/variants.
      if (expected != null && expected.isNotEmpty && !matchFoundEarly) {
        final extracted = rows.expand((row) => row).map((w) => w.text).join();
        final similarity = _matchSimilarity(_normalizeForMatch(extracted), _normalizeForMatch(expected));
        if (similarity >= _matchThreshold) {
          matchFoundEarly = true;
          bestScore = score;
          bestRows = rows;
          bestDisplayBytes = displayBytes;
        }
      }
    }

    try {
      shotLoop:
      for (int shot = 0; shot < _burstShotCount; shot++) {
        if (shot > 0) {
          await Future.delayed(const Duration(milliseconds: 200));
        }

        final XFile image = await _cameraController!.takePicture();
        final bytes = await image.readAsBytes();

        final decoded = img.decodeImage(bytes);
        final oriented = decoded != null ? img.bakeOrientation(decoded) : null;
        if (oriented == null) continue;

        final displayBytes = Uint8List.fromList(img.encodeJpg(oriented));

        // The actual per-pixel processing runs on a background isolate via
        // compute() (see top-level _computeCropForOcr etc. above) — doing
        // this inline on the UI isolate is what was freezing the app.
        if (_boxOcrMode) {
          final box = _boxRect ?? _squareBoxFor(_previewAreaSize);
          final cropped = _cropToBox(oriented, box);
          final croppedJpg = Uint8List.fromList(img.encodeJpg(cropped));

          if (mounted) setState(() => _processingStatus = 'Reading (shot ${shot + 1}/$_burstShotCount)...');
          await tryVariant(_computeCropForOcr, croppedJpg, displayBytes);
          if (matchFoundEarly || bestScore >= _earlyExitScore) break shotLoop;

          // Only try the second (relief) variant if the first one read
          // poorly — most plates don't need both passes.
          if (bestScore < _tryReliefBelowScore) {
            if (mounted) setState(() => _processingStatus = 'Trying alternate reading...');
            await tryVariant(_computeCropRelief, croppedJpg, displayBytes);
          }
        } else {
          final fullJpg = Uint8List.fromList(img.encodeJpg(oriented));
          if (mounted) setState(() => _processingStatus = 'Reading (shot ${shot + 1}/$_burstShotCount)...');
          await tryVariant(_computeFullFrame, fullJpg, displayBytes);
        }

        if (matchFoundEarly || bestScore >= _earlyExitScore) break shotLoop;
      }

      if (bestDisplayBytes == null) {
        throw Exception('Could not capture a usable photo.');
      }

      final confidences = bestRows
          .expand((row) => row)
          .map((w) => w.confidence)
          .whereType<double>()
          .toList();
      final overall = confidences.isEmpty
          ? null
          : confidences.reduce((a, b) => a + b) / confidences.length;

      String extractedText = '';
      bool? isMatch;
      double? matchScore;
      if (expected != null && expected.isNotEmpty) {
        extractedText = bestRows.expand((row) => row).map((w) => w.text).join();
        matchScore = _matchSimilarity(_normalizeForMatch(extractedText), _normalizeForMatch(expected));
        isMatch = matchScore >= _matchThreshold;
      }

      if (!mounted) return;
      setState(() {
        _capturedImageBytes = bestDisplayBytes;
        _rows = bestRows;
        _overallAccuracy = overall;
        _isMatch = isMatch;
        _matchScore = matchScore;
        _matchExtractedText = extractedText;
        _isProcessing = false;
        _processingStatus = null;
      });
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _error = 'Scan failed: $e';
        _isProcessing = false;
        _processingStatus = null;
      });
    } finally {
      for (final f in tempFiles) {
        try {
          await f.delete();
        } catch (_) {}
      }
    }
  }

  void _retake() {
    setState(() {
      _capturedImageBytes = null;
      _rows = [];
      _overallAccuracy = null;
      _error = null;
      _isMatch = null;
      _matchScore = null;
      _matchExtractedText = '';
    });
  }

  Color _colorFor(double? confidence) {
    if (confidence == null) return Colors.black87;
    return confidence < _lowConfidenceThreshold ? const Color(0xFFD32F2F) : Colors.black87;
  }

  Widget _buildResultView() {
    final hasText = _rows.isNotEmpty;
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          if (_capturedImageBytes != null)
            ClipRRect(
              borderRadius: BorderRadius.circular(12),
              child: Image.memory(_capturedImageBytes!, fit: BoxFit.contain),
            ),
          const SizedBox(height: 16),
          if (widget.expectedText != null && widget.expectedText!.isNotEmpty)
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(16),
              margin: const EdgeInsets.only(bottom: 16),
              decoration: BoxDecoration(
                color: _isMatch == true ? const Color(0xFFE8F5E9) : const Color(0xFFFFEBEE),
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: _isMatch == true ? Colors.green : Colors.red,
                  width: 2,
                ),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      Icon(
                        _isMatch == true ? Icons.check_circle : Icons.cancel,
                        color: _isMatch == true ? Colors.green : Colors.red,
                        size: 28,
                      ),
                      const SizedBox(width: 10),
                      Text(
                        _isMatch == true ? 'MATCH' : 'NO MATCH',
                        style: TextStyle(
                          fontSize: 20,
                          fontWeight: FontWeight.bold,
                          color: _isMatch == true ? Colors.green.shade800 : Colors.red.shade800,
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 8),
                  Text('Expected: ${widget.expectedText}', style: const TextStyle(fontSize: 13)),
                  Text('Read: ${_matchExtractedText.isEmpty ? "(nothing read)" : _matchExtractedText}',
                      style: const TextStyle(fontSize: 13)),
                  if (_matchScore != null)
                    Text(
                      'Similarity: ${(_matchScore! * 100).toStringAsFixed(0)}%',
                      style: const TextStyle(fontSize: 12, color: Colors.black54),
                    ),
                ],
              ),
            ),
          Container(
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(
              color: const Color(0xFFFFF5F5),
              borderRadius: BorderRadius.circular(12),
              border: Border.all(color: const Color(0xFFD4AF37)),
            ),
            child: Row(
              children: [
                const Icon(Icons.verified, color: Color(0xFFDC143C)),
                const SizedBox(width: 10),
                Expanded(
                  child: Text(
                    _overallAccuracy != null
                        ? 'Overall Accuracy: ${(_overallAccuracy! * 100).toStringAsFixed(1)}%'
                        : 'Overall Accuracy: N/A',
                    style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 15),
                  ),
                ),
                GestureDetector(
                  onTap: () => setState(() => _showConfidenceDetails = !_showConfidenceDetails),
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                    decoration: BoxDecoration(
                      color: _showConfidenceDetails ? const Color(0xFFDC143C) : Colors.black12,
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: Text(
                      '%',
                      style: TextStyle(
                        color: _showConfidenceDetails ? Colors.white : Colors.black54,
                        fontWeight: FontWeight.bold,
                        fontSize: 13,
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 16),
          if (!hasText)
            const Padding(
              padding: EdgeInsets.symmetric(vertical: 24),
              child: Text('No text detected. Try retaking the photo closer to the label.'),
            )
          else
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: Colors.black12),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: _rows.map((row) {
                  return Padding(
                    padding: const EdgeInsets.symmetric(vertical: 3),
                    child: Text.rich(
                      TextSpan(
                        children: [
                          for (int i = 0; i < row.length; i++) ...[
                            TextSpan(
                              text: row[i].text,
                              style: TextStyle(
                                fontSize: 16,
                                color: _colorFor(row[i].confidence),
                                fontWeight: FontWeight.w500,
                              ),
                            ),
                            if (_showConfidenceDetails)
                              TextSpan(
                                text: row[i].confidence != null
                                    ? ' (${(row[i].confidence! * 100).toStringAsFixed(0)}%)'
                                    : ' (?)',
                                style: const TextStyle(
                                  fontSize: 11,
                                  color: Colors.black45,
                                  fontWeight: FontWeight.normal,
                                ),
                              ),
                            if (i != row.length - 1) const TextSpan(text: '  '),
                          ],
                        ],
                      ),
                    ),
                  );
                }).toList(),
              ),
            ),
          const SizedBox(height: 8),
          Row(
            children: [
              Container(width: 12, height: 12, color: const Color(0xFFD32F2F)),
              const SizedBox(width: 6),
              const Text('Low confidence', style: TextStyle(fontSize: 12, color: Colors.black54)),
              const SizedBox(width: 16),
              Container(width: 12, height: 12, color: Colors.black87),
              const SizedBox(width: 6),
              const Text('Confident', style: TextStyle(fontSize: 12, color: Colors.black54)),
            ],
          ),
          const SizedBox(height: 24),
          SizedBox(
            width: double.infinity,
            child: ElevatedButton.icon(
              onPressed: _retake,
              icon: const Icon(Icons.camera_alt),
              label: const Text('Scan Again'),
              style: ElevatedButton.styleFrom(
                backgroundColor: const Color(0xFFDC143C),
                foregroundColor: Colors.white,
                padding: const EdgeInsets.symmetric(vertical: 16),
                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
              ),
            ),
          ),
          if (widget.expectedText != null && widget.expectedText!.isNotEmpty) ...[
            const SizedBox(height: 10),
            SizedBox(
              width: double.infinity,
              child: OutlinedButton.icon(
                onPressed: () => Navigator.pop(context),
                icon: const Icon(Icons.qr_code_scanner),
                label: const Text('Scan New Part (QR)'),
                style: OutlinedButton.styleFrom(
                  foregroundColor: const Color(0xFFDC143C),
                  side: const BorderSide(color: Color(0xFFDC143C)),
                  padding: const EdgeInsets.symmetric(vertical: 16),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                ),
              ),
            ),
          ],
        ],
      ),
    );
  }

  Widget _modeButton(String label, bool active, VoidCallback onTap) {
    return Expanded(
      child: GestureDetector(
        onTap: onTap,
        child: Container(
          padding: const EdgeInsets.symmetric(vertical: 10),
          decoration: BoxDecoration(
            color: active ? const Color(0xFFDC143C) : Colors.white24,
            borderRadius: BorderRadius.circular(8),
          ),
          alignment: Alignment.center,
          child: Text(
            label,
            style: TextStyle(
              color: Colors.white,
              fontWeight: active ? FontWeight.bold : FontWeight.normal,
              fontSize: 13,
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildModeToggle() {
    return Container(
      color: Colors.black,
      padding: const EdgeInsets.fromLTRB(16, 10, 16, 10),
      child: Row(
        children: [
          _modeButton('Full Scan', !_boxOcrMode, () => setState(() => _boxOcrMode = false)),
          const SizedBox(width: 8),
          _modeButton('Box Scan', _boxOcrMode, () => setState(() => _boxOcrMode = true)),
          if (_boxOcrMode) ...[
            const SizedBox(width: 8),
            GestureDetector(
              onTap: () => setState(() => _boxRect = _squareBoxFor(_previewAreaSize)),
              child: Container(
                padding: const EdgeInsets.all(10),
                decoration: BoxDecoration(
                  color: Colors.white24,
                  borderRadius: BorderRadius.circular(8),
                ),
                child: const Icon(Icons.center_focus_strong, color: Colors.white, size: 18),
              ),
            ),
          ],
        ],
      ),
    );
  }

  /// Draggable (move) + resizable (bottom-right handle) crop box, drawn over
  /// the camera preview. Coordinates are fractional (0..1) relative to the
  /// preview area, so they map directly onto the same fraction of the
  /// captured photo regardless of screen size.
  Widget _buildBoxOverlay(Size areaSize) {
    final Rect box = _boxRect ?? _squareBoxFor(areaSize);
    final Rect pixelRect = Rect.fromLTWH(
      box.left * areaSize.width,
      box.top * areaSize.height,
      box.width * areaSize.width,
      box.height * areaSize.height,
    );

    void updateBox(Rect newPixelRect) {
      const double minSize = 40.0;
      final double left = newPixelRect.left.clamp(0.0, areaSize.width - minSize);
      final double top = newPixelRect.top.clamp(0.0, areaSize.height - minSize);
      final double width = newPixelRect.width.clamp(minSize, areaSize.width - left);
      final double height = newPixelRect.height.clamp(minSize, areaSize.height - top);
      setState(() {
        _boxRect = Rect.fromLTWH(
          left / areaSize.width,
          top / areaSize.height,
          width / areaSize.width,
          height / areaSize.height,
        );
      });
    }

    return Stack(
      children: [
        Positioned(
          left: pixelRect.left,
          top: pixelRect.top,
          width: pixelRect.width,
          height: pixelRect.height,
          child: GestureDetector(
            onPanUpdate: (details) => updateBox(pixelRect.shift(details.delta)),
            child: Container(
              decoration: BoxDecoration(
                border: Border.all(color: const Color(0xFFDC143C), width: 2),
                color: const Color(0x1ADC143C),
              ),
            ),
          ),
        ),
        Positioned(
          left: pixelRect.right - 14,
          top: pixelRect.bottom - 14,
          child: GestureDetector(
            onPanUpdate: (details) => updateBox(Rect.fromLTRB(
              pixelRect.left,
              pixelRect.top,
              pixelRect.right + details.delta.dx,
              pixelRect.bottom + details.delta.dy,
            )),
            child: Container(
              width: 28,
              height: 28,
              decoration: BoxDecoration(
                color: const Color(0xFFDC143C),
                shape: BoxShape.circle,
                border: Border.all(color: Colors.white, width: 2),
              ),
              child: const Icon(Icons.open_in_full, color: Colors.white, size: 14),
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildCameraView() {
    if (_error != null) {
      return Center(child: Padding(padding: const EdgeInsets.all(24), child: Text(_error!, textAlign: TextAlign.center)));
    }
    if (!_isCameraInitialized || _cameraController == null) {
      return const Center(child: CircularProgressIndicator(color: Color(0xFFDC143C)));
    }
    return Column(
      children: [
        if (widget.expectedText != null && widget.expectedText!.isNotEmpty)
          Container(
            width: double.infinity,
            color: const Color(0xFF1B5E20),
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
            child: Text(
              'Matching against: ${widget.expectedText}',
              style: const TextStyle(color: Colors.white, fontSize: 13, fontWeight: FontWeight.w600),
              textAlign: TextAlign.center,
            ),
          ),
        _buildModeToggle(),
        Expanded(
          child: LayoutBuilder(
            builder: (context, constraints) {
              final areaSize = constraints.biggest;
              _previewAreaSize = areaSize;
              _boxRect ??= _squareBoxFor(areaSize);
              return Stack(
                alignment: Alignment.bottomCenter,
                children: [
                  Positioned.fill(child: CameraPreview(_cameraController!)),
                  if (_boxOcrMode) _buildBoxOverlay(areaSize),
                  if (_isProcessing && _processingStatus != null)
                    Positioned(
                      bottom: 132,
                      child: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
                        decoration: BoxDecoration(
                          color: Colors.black54,
                          borderRadius: BorderRadius.circular(10),
                        ),
                        child: Text(
                          _processingStatus!,
                          style: const TextStyle(color: Colors.white, fontSize: 13),
                        ),
                      ),
                    ),
                  Positioned(
                    bottom: 48,
                    child: GestureDetector(
                      onTap: _captureAndScan,
                      child: Container(
                        width: 72,
                        height: 72,
                        decoration: BoxDecoration(
                          shape: BoxShape.circle,
                          color: Colors.white,
                          border: Border.all(color: const Color(0xFFDC143C), width: 4),
                        ),
                        child: _isProcessing
                            ? const Padding(
                                padding: EdgeInsets.all(18),
                                child: CircularProgressIndicator(color: Color(0xFFDC143C)),
                              )
                            : const Icon(Icons.document_scanner, color: Color(0xFFDC143C), size: 32),
                      ),
                    ),
                  ),
                ],
              );
            },
          ),
        ),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    final showResult = _capturedImageBytes != null || _rows.isNotEmpty;
    return PopScope(
      // While a result is shown, the back button/gesture should return to the
      // camera for another scan instead of leaving the app (this screen has
      // no route below it when it's the app's home screen).
      canPop: !showResult,
      onPopInvoked: (didPop) {
        if (didPop) return;
        if (showResult) _retake();
      },
      child: Scaffold(
      backgroundColor: Colors.black,
      appBar: AppBar(
        backgroundColor: const Color(0xFFDC143C),
        title: const Text('Text Scan'),
        automaticallyImplyLeading: false,
      ),
      body: SafeArea(
        child: Container(
          color: showResult ? const Color(0xFFFFF5F5) : Colors.black,
          child: showResult ? _buildResultView() : _buildCameraView(),
        ),
      ),
      ),
    );
  }
}
